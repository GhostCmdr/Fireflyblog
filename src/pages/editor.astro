---
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 云端草稿文案：服务端按当前语言预渲染，注入全局供 inline 脚本使用（编辑器脚本为 is:inline，无法 import）
const editorCloudI18n = {
	cloudDrafts: i18n(I18nKey.cloudDrafts),
	cloudDraftOpen: i18n(I18nKey.cloudDraftOpen),
	cloudDraftDelete: i18n(I18nKey.cloudDraftDelete),
	cloudDraftNeedToken: i18n(I18nKey.cloudDraftNeedToken),
	cloudDraftEmpty: i18n(I18nKey.cloudDraftEmpty),
	cloudDraftRefresh: i18n(I18nKey.cloudDraftRefresh),
	cloudDraftLoading: i18n(I18nKey.cloudDraftLoading),
	cloudDraftDeleteConfirm: i18n(I18nKey.cloudDraftDeleteConfirm),
};
const editorCloudI18nJson = JSON.stringify(editorCloudI18n);
---

<MainGridLayout title="写文章" description="在线 Markdown 编辑器">

<!-- 编辑器页面管理：class、CSS注入、Swup hooks -->
<script is:inline define:vars={{ editorCloudI18nJson }}>
(function() {
  window.__editorImageMap = {};
  // 云端草稿多语言文案（服务端预渲染注入，define:vars 传入 JSON 字符串）
  window.editorCloudI18n = JSON.parse(editorCloudI18nJson);

  // ─── IndexedDB 工具（替代 localStorage 存储草稿图片，容量无上限） ───
  var _idb = null;
  window.idbOpen = function idbOpen() {
    if (_idb) return Promise.resolve(_idb);
    return new Promise(function(resolve, reject) {
      var req = indexedDB.open('editor-drafts', 1);
      req.onupgradeneeded = function(e) {
        var db = e.target.result;
        if (!db.objectStoreNames.contains('kv')) db.createObjectStore('kv');
      };
      req.onsuccess = function(e) { _idb = e.target.result; resolve(_idb); };
      req.onerror = function(e) { reject(e.target.error); };
    });
  }
  window.idbGet = function idbGet(key) {
    return idbOpen().then(function(db) {
      return new Promise(function(resolve, reject) {
        var tx = db.transaction('kv', 'readonly');
        var req = tx.objectStore('kv').get(key);
        req.onsuccess = function() { resolve(req.result); };
        req.onerror = function() { reject(req.error); };
      });
    });
  }
  window.idbSet = function idbSet(key, value) {
    return idbOpen().then(function(db) {
      return new Promise(function(resolve, reject) {
        var tx = db.transaction('kv', 'readwrite');
        var req = tx.objectStore('kv').put(value, key);
        req.onsuccess = function() { resolve(); };
        req.onerror = function() { reject(req.error); };
      });
    });
  }
  window.idbDel = function idbDel(key) {
    return idbOpen().then(function(db) {
      return new Promise(function(resolve, reject) {
        var tx = db.transaction('kv', 'readwrite');
        var req = tx.objectStore('kv').delete(key);
        req.onsuccess = function() { resolve(); };
        req.onerror = function() { reject(req.error); };
      });
    });
  }
  // 批量删除（前缀匹配）
  window.idbDelPrefix = function idbDelPrefix(prefix) {
    return idbOpen().then(function(db) {
      return new Promise(function(resolve, reject) {
        var tx = db.transaction('kv', 'readwrite');
        var store = tx.objectStore('kv');
        var req = store.openCursor();
        var keys = [];
        req.onsuccess = function(e) {
          var cursor = e.target.result;
          if (cursor) {
            if (typeof cursor.key === 'string' && cursor.key.indexOf(prefix) === 0) keys.push(cursor.key);
            cursor.continue();
          } else {
            keys.forEach(function(k) { store.delete(k); });
            resolve();
          }
        };
        req.onerror = function() { reject(req.error); };
      });
    });
  }

  // ─── 图片压缩工具 ───
  var MAX_IMAGE_SIZE = 2 * 1024 * 1024; // 2MB 压缩阈值
  var MAX_IMAGE_DIMENSION = 2048; // 最大边长
  window.compressImage = function compressImage(file) {
    return new Promise(function(resolve) {
      if (file.size <= MAX_IMAGE_SIZE) {
        // 小文件直接读取，不压缩
        var reader = new FileReader();
        reader.onload = function(ev) { resolve(ev.target.result); };
        reader.readAsDataURL(file);
        return;
      }
      var img = new Image();
      img.onload = function() {
        URL.revokeObjectURL(img.src);
        var w = img.width, h = img.height;
        // 按最大边长等比缩放
        if (w > MAX_IMAGE_DIMENSION || h > MAX_IMAGE_DIMENSION) {
          if (w > h) { h = Math.round(h * MAX_IMAGE_DIMENSION / w); w = MAX_IMAGE_DIMENSION; }
          else { w = Math.round(w * MAX_IMAGE_DIMENSION / h); h = MAX_IMAGE_DIMENSION; }
        }
        var canvas = document.createElement('canvas');
        canvas.width = w;
        canvas.height = h;
        var ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, w, h);
        // 转 JPEG，质量 0.85
        var compressed = canvas.toDataURL('image/jpeg', 0.85);
        var originalSize = file.size;
        var compressedSize = Math.round(compressed.length * 3 / 4);
        console.log('图片压缩: ' + (originalSize / 1024).toFixed(0) + 'KB → ' + (compressedSize / 1024).toFixed(0) + 'KB');
        resolve(compressed);
      };
      img.src = URL.createObjectURL(file);
    });
  }

  // [Editor] 编辑器模式 CSS 注入/移除已移至 Layout.astro（<script is:inline> 在 swup 容器内不会被 SPA 导航重新执行）
})();
</script>

<style>
/* [Editor] 焦点黑边统一方案：鼠标/程序化聚焦不显示 outline，仅键盘 Tab 导航(:focus-visible)显示。
   实测确认：点击按钮、ESC 关弹窗后焦点回归均命中 :focus-visible 且 is focus:true，
   故用全局 focus-visible:none 可根治黑边，同时保留键盘可达性。替代原先分散的 JS blur。 */
button:focus { outline: none; }
button:focus-visible { outline: none; }
select:focus { outline: none; }
/* [Editor] 发布弹窗「设为草稿」滑块 Switch：轨道开(草稿)=琥珀、关(公开)=中性灰，滑块左右滑动过渡 */
.gh-switch-input {
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
  pointer-events: none;
}
.gh-switch-track {
  position: relative;
  display: inline-flex;
  align-items: center;
  width: 2.25rem;   /* 36px @14.4 */
  height: 1.25rem;  /* 20px @14.4 */
  border-radius: 9999px;
  background: #e5e7eb;                /* 亮色：灰轨道(off) */
  transition: background-color 0.2s ease;
  cursor: pointer;
  flex-shrink: 0;
}
.gh-switch-thumb {
  position: absolute;
  top: 2px;
  left: 2px;
  width: 1rem;   /* 16px */
  height: 1rem;
  border-radius: 9999px;
  background: #fff;
  box-shadow: 0 1px 2px rgba(0,0,0,0.2);
  transition: transform 0.2s ease;
}
/* hover 用轨道自身(0,2,0)，低于琥珀开启规则(0,3,0)：开态 hover 琥珀不被覆盖，关态 hover 提亮。
   不要用 #lbl-gh-draft:hover（含 id 特异性高于琥珀，会把开态覆盖成灰）。 */
.gh-switch-track:hover { background: #d1d5db; }
/* 关态暗色：半透明白灰轨道（放琥珀开启规则前，避免同特异性后者覆盖） */
:root.dark .gh-switch-track { background: rgba(255,255,255,0.18); }
:root.dark .gh-switch-track:hover { background: rgba(255,255,255,0.28); }
/* 开启(草稿)：琥珀轨道 + 滑块右滑（放暗色灰轨道后，后声明优先保证开态恒琥珀）。
   位移 = 36-16(滑块)-4(左右边距) = 16px = 1rem */
.gh-switch-input:checked + .gh-switch-track { background: #f59e0b; } /* amber-500 草稿语义色 */
.gh-switch-input:checked + .gh-switch-track .gh-switch-thumb { transform: translateX(1rem); }
/* 滑块 focus 可见环（可访问性，仅键盘） */
.gh-switch-input:focus-visible + .gh-switch-track { box-shadow: 0 0 0 2px var(--primary); }
.toolbar-btn { padding: 5px 7px; border-radius: 6px; color: color-mix(in srgb, currentColor 55%, transparent); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease; position: relative; }
.toolbar-btn svg { width: 18px; height: 18px; flex-shrink: 0; }
.toolbar-btn:hover { background: color-mix(in srgb, currentColor 8%, transparent); color: color-mix(in srgb, currentColor 100%, transparent); }
.toolbar-btn:active { transform: scale(0.92); }
.toolbar-btn.active { background: color-mix(in srgb, var(--primary) 12%, transparent); color: var(--primary); }
.toolbar-btn.active:hover { background: color-mix(in srgb, var(--primary) 18%, transparent); }
.toggle-btn { display: flex; align-items: center; gap: 6px; padding: 8px 12px; border-radius: 0.5rem; border: 1px solid var(--line-divider); font-size: 0.8rem; color: color-mix(in srgb, currentColor 50%, transparent); cursor: pointer; transition: background-color 0.15s, border-color 0.15s, color 0.15s; white-space: nowrap; user-select: none; background: transparent; }
.toggle-btn:hover { border-color: color-mix(in srgb, var(--primary) 40%, transparent); color: color-mix(in srgb, var(--primary) 70%, transparent); }
.toggle-btn.active { border-color: var(--primary); background: color-mix(in srgb, var(--primary) 10%, transparent); color: var(--primary); }
#markdown-input:focus { box-shadow: inset 0 0 0 2px var(--primary); }
#markdown-input.drag-over { box-shadow: inset 0 0 0 3px var(--primary), inset 0 0 30px color-mix(in srgb, var(--primary) 10%, transparent); background: color-mix(in srgb, var(--primary) 3%, transparent); }
.icon-bar-btn { width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; display: flex; align-items: center; justify-content: center; color: color-mix(in srgb, currentColor 50%, transparent); cursor: pointer; transition: background-color 0.15s, color 0.15s; pointer-events: auto; }
.icon-bar-btn svg { width: 1.25rem; height: 1.25rem; flex-shrink: 0; }
.icon-bar-btn:hover { background: color-mix(in srgb, currentColor 5%, transparent); color: color-mix(in srgb, currentColor 80%, transparent); }
.icon-bar-btn.active { background: color-mix(in srgb, var(--primary) 12%, transparent); color: var(--primary); }
.icon-bar-btn:focus { outline: none; }
.icon-bar-btn:focus-visible { outline: none; box-shadow: none; }
/* 移动端：图标栏不隐藏，保持侧边但缩小（w-10 + 更小按钮/图标），保证 5 面板入口可用 */
@media (max-width: 768px) {
  #right-icon-bar { width: 2.5rem; }
  #right-icon-bar .icon-bar-btn { width: 2rem; height: 2rem; }
  #right-icon-bar .icon-bar-btn svg { width: 1rem; height: 1rem; }
}
/* 壁纸模式下图标栏和滑出面板跟随主题（半透明，无 blur） */
body.wallpaper-transparent #slide-panel,
body.wallpaper-transparent #right-icon-bar {
    background-color: var(--card-bg-transparent) !important;
}
/* 单栏模式（仅编辑/仅预览）左右留白 */
#editor-body.single-view { padding: 0 210px; }

/* 自定义滚动条 */
.custom-scrollbar { position: absolute; right: 2px; top: 0; bottom: 0; width: 6px; z-index: 10; opacity: 1; pointer-events: auto; }
.custom-scrollbar-thumb { width: 100%; border-radius: 3px; background: rgba(128, 128, 128, 0.35); cursor: pointer; position: absolute; top: 0; min-height: 20px; transition: background 0.15s; }
.custom-scrollbar-thumb:hover { background: rgba(128, 128, 128, 0.55); }

/* slide-panel 滚动条：默认隐藏，hover 时显示 */
#panel-content { scrollbar-width: thin; scrollbar-color: transparent transparent; }
#panel-content:hover { scrollbar-color: rgba(128, 128, 128, 0.35) transparent; }
#panel-content::-webkit-scrollbar { width: 4px; }
#panel-content::-webkit-scrollbar-thumb { background: transparent; border-radius: 2px; transition: background 0.2s; }
#panel-content:hover::-webkit-scrollbar-thumb { background: rgba(128, 128, 128, 0.35); }
#panel-content:hover::-webkit-scrollbar-thumb:hover { background: rgba(128, 128, 128, 0.55); }

/* 任务列表：隐藏圆点 */
#preview-content ul:has(li > input[type="checkbox"]),
#preview-content ul:has(li > p > input[type="checkbox"]),
#fullscreen-content ul:has(li > input[type="checkbox"]),
#fullscreen-content ul:has(li > p > input[type="checkbox"]) {
  list-style: none !important;
}
#preview-content ul:has(li > input[type="checkbox"]) li::marker,
#preview-content ul:has(li > p > input[type="checkbox"]) li::marker,
#fullscreen-content ul:has(li > input[type="checkbox"]) li::marker,
#fullscreen-content ul:has(li > p > input[type="checkbox"]) li::marker {
  content: "" !important;
  width: 0 !important;
  display: none !important;
}
</style>

<!-- 草稿箱/语法内层滚动条：与单层面板 gutter 逻辑统一收归本文件。
     这些元素由 JS innerHTML 动态生成，必须 is:global，否则 Astro 构建期摇树整段删除。 -->
<style is:global>
  body.editor-page #draft-list::-webkit-scrollbar,
  body.editor-page #draft-cloud-list::-webkit-scrollbar,
  body.editor-page .draft-ctrl-row::-webkit-scrollbar,
  body.editor-page .syntax-tag-row::-webkit-scrollbar { width: 4px !important; }
  body.editor-page #draft-list::-webkit-scrollbar-button,
  body.editor-page #draft-cloud-list::-webkit-scrollbar-button { display: none !important; width: 0 !important; height: 0 !important; }
  body.editor-page #draft-list::-webkit-scrollbar-thumb,
  body.editor-page #draft-cloud-list::-webkit-scrollbar-thumb { background: transparent; border-radius: 2px; }
  body.editor-page #draft-list:hover::-webkit-scrollbar-thumb,
  body.editor-page #draft-cloud-list:hover::-webkit-scrollbar-thumb { background: rgba(128, 128, 128, 0.35); }
  body.editor-page #draft-list,
  body.editor-page #draft-cloud-list,
  body.editor-page .draft-ctrl-row,
  body.editor-page .syntax-tag-row { scrollbar-width: thin !important; }
  body.editor-page #draft-list,
  body.editor-page #draft-cloud-list,
  body.editor-page .draft-ctrl-row,
  body.editor-page .syntax-tag-row { scrollbar-gutter: stable !important; }
  body.editor-page .draft-ctrl-row,
  body.editor-page .syntax-tag-row { overflow-y: auto !important; }
  body.editor-page .syntax-scroll { scrollbar-gutter: stable !important; }
  body.editor-page .syntax-scroll { scrollbar-width: thin !important; }
  body.editor-page .syntax-scroll::-webkit-scrollbar { width: 4px !important; }
  body.editor-page .syntax-scroll::-webkit-scrollbar-thumb { background: transparent; border-radius: 2px; }
  body.editor-page .syntax-scroll:hover::-webkit-scrollbar-thumb { background: rgba(128, 128, 128, 0.35); }
  /* TOC/语法项 hover：纯 CSS（原 JS 事件委托注入改为静态，消除运行时事件开销与闪烁）。
     动态元素由 JS 生成，必须 is:global，否则 Astro 摇树整段删除。效果与原 JS 注入一致。 */
  body.editor-page .toc-item:hover { background: color-mix(in srgb, var(--primary) 15%, transparent) !important; }
  body.editor-page .syntax-item:hover { border-color: var(--primary) !important; background: color-mix(in srgb, var(--primary) 5%, transparent) !important; }
</style>

<!-- 高度 = 100vh - 父级 Main content 的 top:5.5rem（= 79.2px @14.4），使容器底部恰好贴视口底。
     原用 calc(100vh - 72px) 与父级 5.5rem 不一致，导致底部被挤出视口 ~7px（底部栏贴底/被切）。 -->
<div class="flex flex-col w-full overflow-hidden" style="height: calc(100vh - 5.5rem); box-sizing: border-box;">


<!-- 编辑器主体（导航栏下方） -->
<div class="flex flex-1 overflow-hidden">
  <!-- 中间编辑区 -->
  <div class="flex-1 flex flex-col overflow-hidden">
    <!-- 标题输入 -->
    <div class="px-6 py-2 border-b border-[var(--line-divider)]">
      <input id="post-title" type="text" placeholder="输入文章标题..."
        class="w-full text-2xl font-bold bg-transparent text-black/90 dark:text-white/90 focus:outline-none placeholder:text-black/20 dark:placeholder:text-white/20" />
    </div>

    <!-- 工具栏 -->
    <div id="toolbar" class="flex flex-nowrap items-center gap-0.5 px-3 py-1.5 border-b border-[var(--line-divider)] bg-transparent overflow-x-auto">
      <button data-action="bold" title="加粗 (Ctrl+B)" class="toolbar-btn">
        <svg width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M13.5 4H7v16h7.5c2.5 0 4.5-2 4.5-4.5c0-1.57-.8-2.96-2.01-3.77C18.16 10.77 19 9.38 19 7.5C19 5.57 17.43 4 15.5 4zm0 2c.83 0 1.5.67 1.5 1.5S14.33 9 13.5 9H9V6h4.5zm0 6c.83 0 1.5.67 1.5 1.5s-.67 1.5-1.5 1.5H9v-3h4.5z"/></svg>
      </button>
      <button data-action="italic" title="斜体 (Ctrl+I)" class="toolbar-btn">
        <svg width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M10 5v3h2.21l-3.42 8H6v3h8v-3h-2.21l3.42-8H18V5z"/></svg>
      </button>
      <button data-action="strikethrough" title="删除线" class="toolbar-btn">
        <svg width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M10 19h4v-3h-4v3zM5 4v3h5v3h4V7h5V4H5zM3 14h18v-2H3v2z"/></svg>
      </button>
      <div class="w-px h-4 bg-[var(--line-divider)] mx-0.5"></div>
      <button data-action="h1" title="一级标题" class="toolbar-btn text-xs font-bold">H1</button>
      <button data-action="h2" title="二级标题" class="toolbar-btn text-xs font-bold">H2</button>
      <button data-action="h3" title="三级标题" class="toolbar-btn text-xs font-bold">H3</button>
      <button data-action="h4" title="四级标题" class="toolbar-btn text-xs font-bold">H4</button>
      <div class="w-px h-4 bg-[var(--line-divider)] mx-0.5"></div>
      <button data-action="ul" title="无序列表" class="toolbar-btn">
        <svg width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M4 10.5c-.83 0-1.5.67-1.5 1.5s.67 1.5 1.5 1.5s1.5-.67 1.5-1.5s-.67-1.5-1.5-1.5zm0-6c-.83 0-1.5.67-1.5 1.5S3.17 7.5 4 7.5S5.5 6.83 5.5 6S4.83 4.5 4 4.5zm0 12c-.83 0-1.5.68-1.5 1.5s.68 1.5 1.5 1.5s1.5-.68 1.5-1.5s-.67-1.5-1.5-1.5zM7 19h14v-2H7v2zm0-6h14v-2H7v2zm0-8v2h14V5H7z"/></svg>
      </button>
      <button data-action="ol" title="有序列表" class="toolbar-btn">
        <svg width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M2 17h2v.5H3v1h1v.5H2v1h3v-4H2v1zm1-9h1V4H2v1h1v3zm-1 3h1.8L2 13.1v.9h3v-1H3.2L5 10.9V10H2v1zm5-6v2h14V5H7zm0 14h14v-2H7v2zm0-6h14v-2H7v2z"/></svg>
      </button>
      <button data-action="checklist" title="任务列表" class="toolbar-btn">
        <svg width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M3 5h2v14H3V5zm4 0v2h12V7H7zm0 4v2h12v-2H7zm0 4v2h12v-2H7zm-4 3l3-3l1.5 1.5L5 18.5L2.5 16L4 14.5z"/></svg>
      </button>
      <div class="w-px h-4 bg-[var(--line-divider)] mx-0.5"></div>
      <button data-action="quote" title="引用" class="toolbar-btn">
        <svg width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M6 17h3l2-4V7H5v6h3zm8 0h3l2-4V7h-6v6h3z"/></svg>
      </button>
      <button data-action="code" title="行内代码" class="toolbar-btn">
        <svg width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6l6 6l1.4-1.4zm5.2 0l4.6-4.6l-4.6-4.6L16 6l6 6l-6 6l-1.4-1.4z"/></svg>
      </button>
      <button data-action="codeblock" title="代码块" class="toolbar-btn">
        <svg width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V8h16v12zm-8-2h4v-2h-4v2zm-6-6h2v2H6v-2zm0 4h2v2H6v-2zm0 4h12v2H6v-2z"/></svg>
      </button>
      <div class="w-px h-4 bg-[var(--line-divider)] mx-0.5"></div>
      <button data-action="link" title="链接" class="toolbar-btn">
        <svg width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg>
      </button>
      <button data-action="image" title="图片" class="toolbar-btn">
        <svg width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>
      </button>
      <button data-action="table" title="表格" class="toolbar-btn">
        <svg width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M3 3v18h18V3H3zm8 16H5v-6h6v6zm0-8H5V5h6v6zm8 8h-6v-6h6v6zm0-8h-6V5h6v6z"/></svg>
      </button>
      <button data-action="hr" title="分割线" class="toolbar-btn">
        <svg width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M2 11h20v2H2z"/></svg>
      </button>
      <div class="w-px h-4 bg-[var(--line-divider)] mx-0.5"></div>
      <button data-action="undo" title="撤销 (Ctrl+Z)" class="toolbar-btn">
        <svg width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88c3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z"/></svg>
      </button>
      <button data-action="redo" title="重做 (Ctrl+Y)" class="toolbar-btn">
        <svg width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M18.4 10.6C16.55 8.99 14.15 8 11.5 8c-4.65 0-8.58 3.03-9.96 7.22L3.9 16c1.05-3.19 4.05-5.5 7.6-5.5c1.95 0 3.73.72 5.12 1.88L13 16h9V7l-3.6 3.6z"/></svg>
      </button>
      <div class="w-px h-4 bg-[var(--line-divider)] mx-0.5"></div>
      <!-- 功能开关 -->
      <button id="btn-typewriter" title="打字机模式" class="toolbar-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7V4h16v3"/><path d="M9 20h6"/><path d="M12 4v16"/></svg>
      </button>
      <button id="btn-sync-scroll" title="同步滚动" class="toolbar-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3l-4 4m0 0l4 4"/><path d="M4 7h12"/><path d="M16 21l4-4m0 0l-4-4"/><path d="M20 17H8"/></svg>
      </button>
      <div class="flex-1"></div>
      <!-- 视图切换 -->
      <button id="btn-view-editor" title="仅编辑" class="toolbar-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      </button>
      <button id="btn-view-split" title="分栏" class="toolbar-btn active">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="12" y1="3" x2="12" y2="21"/></svg>
      </button>
      <button id="btn-view-preview" title="仅预览" class="toolbar-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
      </button>
    </div>

    <!-- 编辑器主体 -->
    <div id="editor-body" class="flex flex-1 overflow-hidden">
      <!-- 左侧：Markdown 输入 -->
      <div id="editor-pane" class="flex-1 flex flex-col border-r border-[var(--line-divider)] relative">
        <textarea id="markdown-input" 
          class="flex-1 w-full resize-none p-5 text-base font-mono bg-transparent text-black/90 dark:text-white/90 focus:outline-none placeholder:text-black/30 dark:placeholder:text-white/30"
          style="line-height: 1.75;"
          placeholder="开始写作吧...&#10;&#10;支持完整的 Markdown 语法：&#10;- **加粗** 和 *斜体*&#10;- # 标题&#10;- ```代码块```&#10;- > 引用&#10;- [链接](url)&#10;- ![图片](url)"
          spellcheck="false"
        ></textarea>
        <div class="custom-scrollbar" data-target="markdown-input"><div class="custom-scrollbar-thumb"></div></div>
      </div>
      <!-- 右侧：预览 -->
      <div id="preview-pane" class="flex-1 flex flex-col overflow-hidden relative">
        <div id="preview-content" class="flex-1 overflow-y-auto p-5 markdown-content prose prose-base dark:prose-invert max-w-none">
          <div class="text-black/30 dark:text-white/30 text-sm italic">预览区域</div>
        </div>
        <div class="custom-scrollbar" data-target="preview-content"><div class="custom-scrollbar-thumb"></div></div>
      </div>
    </div>

    <!-- 底部状态栏：py-1(0.25rem) 上下内距与草稿项间距一致 -->
    <div class="flex items-center justify-between px-4 py-1 border-t border-[var(--line-divider)] text-xs text-black/50 dark:text-white/50">
      <div class="flex items-center gap-4">
        <span id="word-count">0 词</span>
        <span id="char-count">0 字符</span>
        <span id="line-count">0 行</span>
      </div>
      <div class="flex items-center gap-2">
        <button id="btn-quick-save" title="保存草稿" class="px-3 py-1.5 rounded-lg bg-[var(--primary)]/10 text-[var(--primary)] hover:bg-[var(--primary)]/20 transition cursor-pointer text-xs font-medium">保存草稿</button>
        <button data-panel="drafts" title="草稿箱" class="px-3 py-1.5 rounded-lg border border-[var(--line-divider)] text-black/60 dark:text-white/60 hover:bg-black/5 dark:hover:bg-white/5 transition cursor-pointer text-xs">草稿箱</button>
        <button id="btn-publish" title="发布" class="px-3 py-1.5 rounded-lg bg-[var(--primary)] text-white dark:text-black/80 hover:opacity-90 transition cursor-pointer text-xs font-medium">发布文章</button>
      </div>
    </div>
  </div>

  <!-- [Editor] 隐藏的文章信息表单 — 始终存在于 DOM 中，保存草稿时可读取 -->
  <div id="meta-fields" class="hidden">
    <input id="post-desc" type="text" />
    <input id="post-category" type="text" />
    <input id="post-tags" type="text" />
    <input id="post-cover" type="text" />
    <input id="post-slug" type="text" />
    <input id="post-url-slug" type="text" />
    <input id="post-published" type="text" />
    <input id="post-updated" type="text" />
    <input id="post-draft" type="text" />
    <input id="post-password" type="text" />
    <input id="post-password-hint" type="text" />
    <input id="chk-pinned" type="checkbox" />
    <input id="chk-comment" type="checkbox" checked />
    <input id="chk-draft" type="checkbox" />
  </div>

  <!-- 右侧面板区（图标栏 + 滑出面板） -->
  <div class="flex shrink-0">
    <!-- 滑出面板（内联，不覆盖编辑区） -->
    <div id="slide-panel" class="w-0 overflow-hidden bg-[var(--card-bg)] border-l border-[var(--line-divider)] flex flex-col">
      <div id="panel-inner" style="width: 288px; transform: translateX(-100%);">
        <div class="flex items-center justify-between px-4 py-3 border-b border-[var(--line-divider)]">
          <h3 id="panel-title" class="text-sm font-bold text-black/90 dark:text-white/90">设置</h3>
          <button id="panel-close" class="text-black/50 dark:text-white/50 hover:text-black/90 dark:hover:text-white/90 cursor-pointer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
        <div id="panel-content" class="flex-1 overflow-hidden"></div>
      </div>
    </div>

    <!-- 图标栏 -->
    <aside id="right-icon-bar" class="w-12 bg-[var(--card-bg)] border-l border-[var(--line-divider)] flex flex-col items-center py-3 gap-1 shrink-0">
      <!-- 图标尺寸由 CSS .icon-bar-btn svg 统一控制（桌面 1.25rem / 移动端 1rem），SVG 不写死 width/height px -->
      <button data-panel="meta" class="icon-bar-btn" title="文章信息">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
      </button>
      <button data-panel="drafts" class="icon-bar-btn" title="草稿箱">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 5.5A2.5 2.5 0 017.5 3H18a2 2 0 012 2v14a2 2 0 01-2 2H7.5A2.5 2.5 0 015 18.5v-13z"/><path d="M9 3v2h6V3"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/></svg>
      </button>
      <button id="btn-toc" data-panel="toc" class="icon-bar-btn" title="目录">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="12" y2="17"/></svg>
      </button>
      <button id="btn-syntax" data-panel="syntax" class="icon-bar-btn" title="语法参考">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><polyline points="10 12 8 14 10 16"/><polyline points="14 12 16 14 14 16"/></svg>
      </button>
      <button data-panel="github" class="icon-bar-btn" title="GitHub 设置">
        <!-- 线条版钥匙（Lucide「key-round」，ISC 许可）：形状取自 GitHub 钥匙的轮廓（圆环头 + 台阶杆），
             但本身是【线条设计】绘制，故与其余图标同为细线、不会出现实心糊条；坐标已水平镜像。
             钥匙孔用【45° 斜线】表示（原版是 r=0.5 的实心小点，会引入 fill）——
             整枚图标纯描边、无任何填充元素，且【无任何元素级样式覆盖】（粗细/颜色/填充全部继承父级）。
             斜线：长 3 单位、宽继承 2 单位，中心 = (8, 8)；
             仅改端点坐标，不引入任何样式覆盖。
             父级属性与其余图标一致：viewBox 24 / fill:none / stroke:currentColor / stroke-width:2，尺寸由 CSS 统一控制 -->
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.414 17.414A2 2 0 0 1 22 18.828V21a1 1 0 0 1 -1 1h-3a1 1 0 0 1 -1 -1v-1a1 1 0 0 0 -1 -1h-1a1 1 0 0 1 -1 -1v-1a1 1 0 0 0 -1 -1h-0.172a2 2 0 0 1 -1.414 -0.586l-0.814 -0.814a6.5 6.5 0 1 1 4 -4z"/><line x1="6.9393" y1="9.0607" x2="9.0607" y2="6.9393"/></svg>
      </button>
      <div class="flex-1"></div>
      <button id="btn-export-md" class="icon-bar-btn" title="导出 MD">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      </button>
    </aside>
  </div>

</div>
</div> <!-- 关闭外层 flex-col 容器 -->

<!-- GitHub 发布弹窗 -->
<div id="github-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 hidden">
  <div class="rounded-2xl p-6 shadow-2xl bg-white dark:bg-neutral-900 border border-[var(--line-divider)]" style="width: 420px;">
    <h3 class="text-base font-bold text-black/90 dark:text-white/90 mb-4 flex items-center gap-2">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="text-black/80 dark:text-white/80"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
      发布到 GitHub
    </h3>
    <div class="space-y-3">
      <!-- [Editor] 二次草稿设置：开关置于状态背景框内部右侧（文字区 #gh-hint-text 动态重建，
           开关 #lbl-gh-draft 为静态子元素不被重建，保住 change 绑定）。与 meta 面板「设置成草稿」双向同步。 -->
      <div id="gh-publish-hint" class="hidden items-center gap-2 rounded-lg px-3 py-2.5">
        <div id="gh-hint-text" class="flex-1 flex items-start gap-2 min-w-0"></div>
        <!-- 二次草稿设置：滑块 Switch。文字「设为草稿」+ 隐藏 checkbox + 轨道滑块。
             滑块轨道色随状态框语义：开(草稿)=琥珀、关(公开)=灰。checkbox 视觉隐藏但保留状态与 change。 -->
        <label id="lbl-gh-draft" class="shrink-0 flex items-center gap-1.5 text-xs cursor-pointer select-none text-black/70 dark:text-white/70">
          <span>设为草稿</span>
          <input type="checkbox" id="gh-draft-toggle" class="gh-switch-input" />
          <span class="gh-switch-track"><span class="gh-switch-thumb"></span></span>
        </label>
      </div>
      <div id="gh-status" class="text-sm hidden"></div>
      <p class="text-[11px] leading-relaxed text-black/35 dark:text-white/35">发布前请检查是否填入正确 Token、仓库和分支</p>
    </div>
    <div class="flex justify-end gap-2.5 mt-6">
      <button id="gh-cancel" class="px-4 py-2 rounded-lg text-sm text-black/70 dark:text-white/70 hover:bg-black/5 dark:hover:bg-white/10 transition cursor-pointer">
        取消
      </button>
      <button id="gh-confirm" class="px-5 py-2 rounded-lg bg-[var(--primary)] text-white dark:text-black/80 text-sm font-medium hover:opacity-90 transition cursor-pointer shadow-sm shadow-[var(--primary)]/20">
        确认发布
      </button>
    </div>
  </div>
</div>

<!-- 通用确认弹窗（替代浏览器原生 confirm，样式与 GitHub 发布弹窗一致）
     注意：遮罩不加 backdrop-blur —— 编辑器页 fixed inset-0 遮罩加模糊会与固定导航栏
     在层叠边界产生渲染伪影（见记忆：backdrop-blur 与固定导航栏伪影） -->
<div id="confirm-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 hidden">
  <div class="rounded-2xl p-6 shadow-2xl bg-white dark:bg-neutral-900 border border-[var(--line-divider)]" style="width: 420px;">
    <h3 id="confirm-modal-title" class="text-base font-bold text-black/90 dark:text-white/90 mb-4">确认操作</h3>
    <p id="confirm-modal-message" class="text-sm text-black/70 dark:text-white/70 leading-relaxed break-words"></p>
    <div class="flex justify-end gap-2.5 mt-6">
      <button id="confirm-modal-cancel" class="px-4 py-2 rounded-lg text-sm text-black/70 dark:text-white/70 hover:bg-black/5 dark:hover:bg-white/10 transition cursor-pointer">
        取消
      </button>
      <button id="confirm-modal-ok" class="px-5 py-2 rounded-lg bg-red-500 text-white text-sm font-medium hover:opacity-90 transition cursor-pointer shadow-sm">
        确认删除
      </button>
    </div>
  </div>
</div>

<!-- 图片上传弹窗 -->
<div id="image-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 hidden">
  <div class="rounded-2xl p-6 shadow-2xl bg-white dark:bg-neutral-900 border border-[var(--line-divider)]" style="width: 520px; max-height: 80vh; display: flex; flex-direction: column;">
    <h3 class="text-base font-bold text-black/90 dark:text-white/90 mb-3">插入图片</h3>
    <!-- 标签切换 -->
    <div class="flex gap-1 mb-3 bg-black/5 dark:bg-white/5 rounded-lg p-1">
      <button id="img-tab-local" class="img-tab flex-1 px-3 py-1.5 rounded-md text-sm font-medium bg-white dark:bg-neutral-800 text-black/90 dark:text-white/90 shadow-sm transition cursor-pointer">本地</button>
      <button id="img-tab-cloud" class="img-tab flex-1 px-3 py-1.5 rounded-md text-sm font-medium text-black/50 dark:text-white/50 hover:text-black/70 dark:hover:text-white/70 transition cursor-pointer">云端图片</button>
    </div>
    <!-- 本地上传面板 -->
    <div id="img-panel-local" class="space-y-3">
      <div class="flex gap-2">
        <input id="img-url-input" type="text" placeholder="粘贴图片 URL（单张）"
          class="flex-1 px-3 py-2 rounded-lg border border-[var(--line-divider)] bg-transparent text-sm text-black/90 dark:text-white/90 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-[var(--primary)]/50" />
        <label class="px-3 py-2 rounded-lg border border-[var(--line-divider)] text-sm text-black/60 dark:text-white/60 hover:border-[var(--primary)]/40 hover:text-[var(--primary)]/70 transition cursor-pointer flex items-center gap-1 whitespace-nowrap">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          本地上传
          <input id="img-file-input" type="file" accept="image/*" multiple class="hidden" />
        </label>
      </div>
      <div id="img-preview" class="hidden">
        <div id="img-preview-grid" class="grid grid-cols-3 gap-2"></div>
        <img id="img-preview-thumb" class="max-h-32 rounded-lg mx-auto hidden" />
      </div>
      <div id="img-status" class="text-sm hidden"></div>
      <p class="text-xs text-black/40 dark:text-white/40">支持多选，多张图片自动并列显示（图片网格）</p>
    </div>
    <!-- 云端图片面板 -->
    <div id="img-panel-cloud" class="hidden flex-1" style="display: none; flex-direction: column;">
      <!-- 云端提示 -->
      <div id="cloud-no-token" class="hidden text-center py-8">
        <p class="text-sm text-black/50 dark:text-white/50 mb-2">请先在右侧 🔑 面板中设置 GitHub Token</p>
        <p class="text-xs text-black/30 dark:text-white/30">设置后即可浏览仓库中的相簿图片和文章图片</p>
      </div>
      <!-- 来源选择 -->
      <div id="cloud-source-bar" class="flex gap-2 mb-3">
        <button id="cloud-src-album" class="cloud-src-btn px-3 py-1.5 rounded-lg text-xs font-medium bg-[var(--primary)] text-white dark:text-black/80 transition cursor-pointer whitespace-nowrap">相簿图片</button>
        <button id="cloud-src-post" class="cloud-src-btn px-3 py-1.5 rounded-lg text-xs font-medium border border-[var(--line-divider)] text-black/60 dark:text-white/60 hover:border-[var(--primary)]/40 transition cursor-pointer whitespace-nowrap">文章图片</button>
      </div>
      <!-- 相簿选择下拉 -->
      <div id="cloud-album-selector" class="mb-3">
        <select id="cloud-album-select" class="w-full px-3 py-2 rounded-lg border border-[var(--line-divider)] bg-transparent text-sm text-black/90 dark:text-white/90 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-[var(--primary)]/50 cursor-pointer">
          <option value="">选择相簿...</option>
        </select>
      </div>
      <!-- 图片列表 -->
      <div id="cloud-images-container" class="flex-1 overflow-y-auto min-h-0" style="max-height: 320px;">
        <div id="cloud-images-loading" class="hidden text-center py-6">
          <span class="text-sm text-black/40 dark:text-white/40">加载中...</span>
        </div>
        <div id="cloud-images-empty" class="text-center py-6">
          <span class="text-sm text-black/40 dark:text-white/40">请选择一个相簿或切换到文章图片</span>
        </div>
        <div id="cloud-images-grid" class="grid grid-cols-4 gap-2"></div>
      </div>
