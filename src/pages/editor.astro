    }
    if (e.target.id === 'post-cover') {
      var url = e.target.value.trim();
      window.__editorCoverValue = url;
      var hiddenCover = document.getElementById('post-cover');
      if (hiddenCover && hiddenCover !== e.target) hiddenCover.value = url;
      // ⚠️ 原写法 `if (url && ...)` 在清空输入框时因 url 为空而短路，清理代码不执行，
      //    导致"输入框空了但预览图还在显示"，且与「删除」按钮行为不一致。
      //    更糟的是此时点发布会上传图片文件却不写 image 字段 → 仓库产生无引用的孤儿文件。
      //    改为：只要不是 data: 开头就清理（包含清空输入框的情况）。
      if (url.indexOf('data:') !== 0) {
        window.__editorCoverDataUrl = '';
        window.__editorCoverFilename = '';
      }
      // 统一处理（相对路径也会拼 raw 地址预览，与其它入口行为一致）
      applyCover(url, { mdDir: window.__editorCoverMdDir || 'src/content/posts' });
    }
  });

