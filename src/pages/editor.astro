  if (ghConfirm) ghConfirm.addEventListener('click', function() {
    // 从 GitHub 设置面板读取配置（优先面板，fallback localStorage）
    var tokenEl = document.getElementById('gh-token-panel');
    var repoEl = document.getElementById('gh-repo-panel');
    var branchEl = document.getElementById('gh-branch-panel');
    var token = (tokenEl ? tokenEl.value : '') || localStorage.getItem('gh-token') || '';
    var repo = (repoEl ? repoEl.value : '') || localStorage.getItem('gh-repo') || 'GhostCmdr/Fireflyblog';
