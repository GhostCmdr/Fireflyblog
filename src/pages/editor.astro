        window.__editorCoverDataUrl = dataUrl;
        var coverPath = './images/' + filename;
        window.__editorCoverValue = coverPath;
        window.__editorCoverFilename = filename;
        // 新上传的图必定传到 src/content/posts/images/，故把目录重置为默认值，
        // 避免沿用之前云端草稿/文章导入残留的 __editorCoverMdDir（刷新后 dataURL 丢失会拼错地址）
        window.__editorCoverMdDir = 'src/content/posts';
        // 统一处理：常驻框 + 面板框同时写入路径（修复"上传后面板输入框不显示路径"），
        // 预览自动优先用内存 dataURL
        applyCover(coverPath, { mdDir: 'src/content/posts' });
        window.__editorShowToast('封面图已选择，发布时将上传');
