    // [Editor] 修复：导出 MD 此前漏传 slug/draft，导致下载文件缺 slug、draft 恒 false（与发布一致需显式传）
    var slug = getVal('post-url-slug').trim().toLowerCase()
      .replace(/[^a-z0-9-]/g, '').replace(/-{2,}/g, '-').replace(/^-|-$/g, '');
    var fm = buildFrontmatter({ title: title, slug: slug, desc: desc, category: category, tags: tags, cover: cover, password: password, passwordHint: passwordHint, pinned: pinned, comment: comment, draft: draft, published: getVal('post-published') });
