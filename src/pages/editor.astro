    document.body.appendChild(toast);
    requestAnimationFrame(function() { toast.style.opacity = '1'; });
    var _dur = (duration === undefined) ? 1500 : duration;
    if (_dur > 0) setTimeout(function() { window.__editorCloseToast(toast); }, _dur);
    return toast;
