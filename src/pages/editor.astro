    textarea.focus();
  });

  // 同步滚动：编辑器 → 预览
  textarea.addEventListener('scroll', function() {
    if (!syncScrollEnabled || isSyncingScroll || !previewContent) return;
    var editorMax = textarea.scrollHeight - textarea.clientHeight;
    if (editorMax <= 0) return;
    var ratio = textarea.scrollTop / editorMax;
    isSyncingScroll = true;
    previewContent.scrollTop = ratio * (previewContent.scrollHeight - previewContent.clientHeight);
    cancelAnimationFrame(syncScrollTimer);
    syncScrollTimer = requestAnimationFrame(function() { isSyncingScroll = false; });
  });

  // 同步滚动：预览 → 编辑器
  if (previewContent) {
    previewContent.addEventListener('scroll', function() {
      if (!syncScrollEnabled || isSyncingScroll) return;
      var previewMax = previewContent.scrollHeight - previewContent.clientHeight;
      if (previewMax <= 0) return;
      var ratio = previewContent.scrollTop / previewMax;
      isSyncingScroll = true;
      textarea.scrollTop = ratio * (textarea.scrollHeight - textarea.clientHeight);
      cancelAnimationFrame(syncScrollTimer);
      syncScrollTimer = requestAnimationFrame(function() { isSyncingScroll = false; });
    });
  }

  // 打字机模式：光标所在行垂直居中
  function scrollCursorToCenter() {
    if (!typewriterEnabled) return;
    var pos = textarea.selectionStart;
    var text = textarea.value;
    if (pos === 0 && textarea.selectionEnd === text.length) return;
    var lines = text.substring(0, pos).split('\n');
    var lineNum = lines.length - 1;
    // 用 scrollHeight/clientHeight 直接计算，避免行高测量误差
    var totalLines = text.split('\n').length || 1;
    var lineHeight = textarea.scrollHeight / totalLines;
    var paddingTop = parseFloat(getComputedStyle(textarea).paddingTop) || 0;
    var cursorY = paddingTop + lineNum * lineHeight;
    var halfView = textarea.clientHeight / 2;
    textarea.scrollTop = cursorY - halfView;
  }

  textarea.addEventListener('keyup', function(e) {
    if (typewriterEnabled && /^(Arrow|Home|End|Page)/.test(e.key)) scrollCursorToCenter();
  });

  // 初始加载时如果打字机模式开启，自动居中光标
  if (typewriterEnabled) {
    requestAnimationFrame(function() { scrollCursorToCenter(); });
  }

  // [Editor] 粘贴图片：剪贴板图片 → Base64 存内存 → 插入 Markdown 图片语法（多张自动包裹 [grid]）
  textarea.addEventListener('paste', function(e) {
    var items = (e.clipboardData || window.clipboardData).items;
    if (!items) return;
    var imageFiles = [];
    for (var i = 0; i < items.length; i++) {
      if (items[i].type.indexOf('image') !== -1) {
        var file = items[i].getAsFile();
        if (file) imageFiles.push(file);
      }
    }
    if (imageFiles.length === 0) return;
    e.preventDefault();

    var imageLines = new Array(imageFiles.length);
    var loaded = 0;
    imageFiles.forEach(function(file, idx) {
      compressImage(file).then(function(dataUrl) {
        var ext = file.type.split('/')[1] || 'png';
        var filename = Date.now() + '-' + Math.random().toString(36).slice(2, 8) + '.' + ext;
        window.__editorImageMap[filename] = dataUrl;
        imageLines[idx] = '![图片](./images/' + filename + ')';
        loaded++;
        if (loaded === imageFiles.length) {
          var validLines = imageLines.filter(Boolean);
          var insertText;
          if (validLines.length > 1) {
            insertText = '[grid]\n' + validLines.join('\n') + '\n[/grid]\n';
          } else {
            insertText = validLines[0] + '\n';
          }
          textarea.focus();
          document.execCommand('insertText', false, insertText);
          window.__editorShowToast(imageFiles.length > 1 ? imageFiles.length + '张图片已粘贴' : '图片已粘贴');
        }
      });
    });
  });

  // [Editor] 拖拽图片：拖入图片文件 → Base64 存内存 → 插入 Markdown 图片语法（多张自动包裹 [grid]）
  textarea.addEventListener('dragover', function(e) {
    e.preventDefault();
    e.dataTransfer.dropEffect = 'copy';
    textarea.classList.add('drag-over');
  });
  textarea.addEventListener('dragleave', function(e) {
    textarea.classList.remove('drag-over');
  });
  textarea.addEventListener('drop', function(e) {
    e.preventDefault();
    textarea.classList.remove('drag-over');
    var files = e.dataTransfer.files;
    if (!files || files.length === 0) return;
    var imageFiles = [];
    for (var i = 0; i < files.length; i++) {
      if (files[i].type.indexOf('image') !== -1) imageFiles.push(files[i]);
    }
    if (imageFiles.length === 0) return;

    var imageLines = new Array(imageFiles.length);
    var loaded = 0;
    imageFiles.forEach(function(file, idx) {
      compressImage(file).then(function(dataUrl) {
        var ext = file.type.split('/')[1] || 'png';
        var filename = Date.now() + '-' + Math.random().toString(36).slice(2, 8) + '.' + ext;
        window.__editorImageMap[filename] = dataUrl;
        imageLines[idx] = '![图片](./images/' + filename + ')';
        loaded++;
        if (loaded === imageFiles.length) {
          var validLines = imageLines.filter(Boolean);
          var insertText;
          if (validLines.length > 1) {
            insertText = '[grid]\n' + validLines.join('\n') + '\n[/grid]\n';
          } else {
            insertText = validLines[0] + '\n';
          }
          textarea.focus();
          document.execCommand('insertText', false, insertText);
          window.__editorShowToast(imageFiles.length > 1 ? imageFiles.length + '张图片已插入' : '图片已插入');
        }
      });
    });
  });

  // [Editor] 自定义滚动条
  function initCustomScrollbars() {
    document.querySelectorAll('.custom-scrollbar').forEach(function(bar) {
      var targetId = bar.getAttribute('data-target');
      var target = document.getElementById(targetId);
      if (!target) return;
      var thumb = bar.querySelector('.custom-scrollbar-thumb');
      var isDragging = false;
      var startY = 0;
      var startScrollTop = 0;

      function updateThumb() {
        // 批量读取布局属性（一次性 reflow）
        var scrollH = target.scrollHeight;
        var clientH = target.clientHeight;
        var scrollTop = target.scrollTop;
        if (scrollH <= clientH) { bar.style.display = 'none'; return; }
        // 批量写入样式（一次性 reflow）
        var ratio = clientH / scrollH;
        var thumbH = Math.max(ratio * clientH, 20);
        var maxTop = clientH - thumbH;
        var scrollRatio = scrollTop / (scrollH - clientH);
        bar.style.display = '';
        thumb.style.height = thumbH + 'px';
        thumb.style.top = (scrollRatio * maxTop) + 'px';
      }

      // [Editor] 自定义滚动条：用双重 RAF 节流，确保在浏览器完成滚动和布局后再更新 thumb，避免 reflow 导致编辑区弹跳
      var _thumbRaf = null;
      target.addEventListener('scroll', function() {
        if (_thumbRaf) return;
        _thumbRaf = requestAnimationFrame(function() {
          requestAnimationFrame(function() {
            _thumbRaf = null;
            updateThumb();
          });
        });
      });
      updateThumb();

      // 点击轨道跳转
      bar.addEventListener('click', function(e) {
        if (e.target === thumb) return;
        var rect = bar.getBoundingClientRect();
        var clickY = e.clientY - rect.top;
        var scrollH = target.scrollHeight;
        var clientH = target.clientHeight;
        var ratio = clickY / clientH;
        target.scrollTop = ratio * (scrollH - clientH);
      });

      // 拖拽 thumb
      thumb.addEventListener('mousedown', function(e) {
        e.preventDefault();
        isDragging = true;
        startY = e.clientY;
        startScrollTop = target.scrollTop;
        bar.classList.add('active');
        document.addEventListener('mousemove', onDrag);
        document.addEventListener('mouseup', onDragEnd);
      });

      function onDrag(e) {
        if (!isDragging) return;
        var dy = e.clientY - startY;
        var scrollH = target.scrollHeight;
        var clientH = target.clientHeight;
        var thumbH = parseFloat(thumb.style.height) || 20;
        var maxTop = clientH - thumbH;
        var scrollRange = scrollH - clientH;
        var deltaScroll = (dy / maxTop) * scrollRange;
        target.scrollTop = startScrollTop + deltaScroll;
      }

      function onDragEnd() {
        isDragging = false;
        bar.classList.remove('active');
        document.removeEventListener('mousemove', onDrag);
        document.removeEventListener('mouseup', onDragEnd);
      }
    });
  }
  initCustomScrollbars();

  // 置顶/评论切换
  function setToggle(btnId, inputId, value) {
    const btn = document.getElementById(btnId);
    const input = document.getElementById(inputId);
    if (value) { btn.classList.add('active'); input.value = 'true'; }
    else { btn.classList.remove('active'); input.value = 'false'; }
  }

  // 置顶/评论由 IIFE 事件委托处理，此处不再重复绑定

  // [Editor] 封面图上传由右侧面板 IIFE 的事件委托处理（此处跳过）

  // GitHub 弹窗由 IIFE 处理，此处不再重复绑定

  // 图片/链接/草稿弹窗由 IIFE 处理，此处不再重复绑定

  // 快捷键保存（快捷键保留，按钮由 IIFE 处理）
  // 快捷键由按钮处理，不再绑定 document keydown

  // 初始化
  updatePreview();
}
</script>

<!-- 右侧面板逻辑（独立，不依赖外部脚本） -->
<script is:inline>
(function() {
  var slidePanel = document.getElementById('slide-panel');
  var panelInner = document.getElementById('panel-inner');
  var panelTitle = document.getElementById('panel-title');
  var panelContent = document.getElementById('panel-content');
  var panelClose = document.getElementById('panel-close');

  if (!slidePanel) { console.error('slide-panel not found'); return; }

  // [Editor] 草稿箱间距样式：必须运行时注入。
  // 原因：#draft-list / #draft-toolbar 的 class 是 JS 动态生成的，
  // Astro 构建时会对 <style> 做摇树优化，认为这些选择器永不匹配而整段删除。
  if (!document.getElementById('draft-spacing-style')) {
    var dsStyle = document.createElement('style');
    dsStyle.id = 'draft-spacing-style';
    dsStyle.textContent = [
      /* toolbar 显示时：输入框 → 全选行 = 0.25rem(3.6px @14.4)，本地/云端同源 */
      '#draft-toolbar, #draft-toolbar-cloud { padding: 0.25rem 0 0 0 !important; }',
      /* toolbar 隐藏时：输入框底部 → 草稿项边框 = 0.5rem(7.2px @14.4)。
         margin-top 而非 padding-top：滚动裁剪边界 = 容器 padding box 顶边；
         margin 在容器外、不参与滚动，使裁剪线 = 首项初始顶边（滚动时项在首项位置被切），
         且不留会被内容填满的隐形留白。本地/云端列表同源（云端列表也带 tb-off/tb-on 类）。 */
      '#draft-list.tb-off, #draft-cloud-list.tb-off { margin-top: 0.5rem !important; padding-top: 0 !important; }',
      /* toolbar 显示时：全选行 → 草稿项边框 = 0.25rem(3.6px @14.4)，同 margin 机制，本地/云端同源 */
      '#draft-list.tb-on, #draft-cloud-list.tb-on { margin-top: 0.25rem !important; padding-top: 0 !important; }',
      /* 云端控件高度锁定，使云端控件区 = 本地控件区（机制同源，任意缩放恒等）：
         本地：tab留白 0.5rem + 输入框(行高 1.25rem + py 1rem + 真实 border 1px×2)
         云端：tab留白 0.5rem + 状态行 1rem + 刷新按钮(行高 1.25rem + 真实 border 1px×2，同色 var(--primary) 无视觉变化)
         → 状态行(1rem) + 按钮 = 1rem + 1.25rem + border×2 = 输入框公式，等式恒成立
         → 按钮不再用 calc 凭空加 2px（那会缺 border 亚像素缩水），改用真实 border，与输入框吃同款渲染
         → 实测修复后：按钮 = 18 + 1.6 = 19.6px，云端控件区 = 14.4 + 19.6 = 34.0px = 输入框 34.0px，首项顶部对齐
         状态行空内容时也固定占 1rem，避免有无文字时控件区高度跳动。 */
      '#draft-cloud-status { padding: 0 !important; height: 1rem !important; line-height: 1rem !important; }',
      '#btn-refresh-cloud { padding: 0 !important; line-height: 1.25rem !important; border: 1px solid var(--primary) !important; }'
    ].join('\n');
    document.head.appendChild(dsStyle);
  }

  // [Editor] 追踪文章信息 checkbox 状态（面板关闭后 DOM 元素消失，用变量保存）
  // 挂到 window 上供其他 IIFE（草稿保存/发布等）访问
  if (!window.__editorMetaCheckbox) window.__editorMetaCheckbox = { pinned: false, comment: true, draft: false };
  var metaCheckboxState = window.__editorMetaCheckbox;

  // [Editor] 追踪封面图 URL（面板关闭后 DOM 元素消失，用变量保存）
  if (!window.__editorCoverValue) window.__editorCoverValue = '';
  // [Editor] 封面图 data URL（用于本地预览和发布时上传）
  if (!window.__editorCoverDataUrl) window.__editorCoverDataUrl = '';
  // [Editor] 封面图文件名（用于发布时上传到 GitHub）
  if (!window.__editorCoverFilename) window.__editorCoverFilename = '';
  // 封面图数据不持久化到 localStorage（刷新后需重新上传），草稿加载时从 editor-draft-cover-{savedAt} 恢复

  // ─── 封面图统一处理（2026-08-29 重构）───
  // 背景：原先"填输入框 + 显示预览"的逻辑重复散在 6 处（本地草稿/云端草稿/文章页导入/
  //       openPanel/手动输入/上传封面），各自判断标准不同 → 同一相对路径在不同入口表现不一致。
  // 现在收敛成以下 2 个函数，所有入口统一调用，判断规则只有一份。
  //
  // ⚠️ 铁律：本组函数只操作"显示层"（DOM），绝不写 __editorCoverValue /
  //    __editorCoverDataUrl / __editorCoverFilename —— 那三个是发布链路的数据源，
  //    一旦被预览地址污染，frontmatter 会写入完整 URL 而非 ./images/xxx.png。

  // 路径规范化：把 (基准目录 + 相对路径) 合并成干净路径，处理 ./ 与 ../
  function _normalizeCoverPath(baseDir, relPath) {
    var parts = String(baseDir || '').split('/').concat(String(relPath || '').split('/'));
    var out = [];
    parts.forEach(function(p) {
      if (!p || p === '.') return;
      if (p === '..') out.pop();
      else out.push(p);
    });
    return out.join('/');
  }

  // 把 frontmatter 里的封面值解析成"浏览器能加载的预览地址"
  function _resolveCoverPreviewUrl(coverValue, mdDir) {
    var v = String(coverValue || '').trim();
    if (!v) return '';
    // 已能直接显示的：内存图 / 远程图 / 站点根路径（public 下）
    if (v.indexOf('data:') === 0 || /^https?:\/\//i.test(v) || v.indexOf('/') === 0) return v;
    // 相对路径 → 拼 GitHub raw 地址（对应发布时上传位置 src/content/posts/images/）
    var cfg = (typeof getCloudGithubConfig === 'function') ? getCloudGithubConfig() : { repo: '', branch: '' };
    if (!cfg.repo || !cfg.branch) return '';
    var full = _normalizeCoverPath(mdDir || 'src/content/posts', v);
    return 'https://raw.githubusercontent.com/' + cfg.repo + '/' + cfg.branch + '/' + full;
  }

  // 封面预览加载状态（防抖 + 结果缓存 + 超时兜底）
  var _coverLoadTimer = null;   // 防抖定时器
  var _coverResult = {};        // 地址 → 'ok' | 'error'，记住加载结果，避免重复请求
  var _coverLoadSeq = 0;        // 递增序号：让已过期的旧请求回调失效
  var _coverLoading = false;    // 是否有请求正在飞行中（供「刷新」按钮防重复点击）

  // 取消"尚未执行的封面加载"，并让"已发出的旧请求回调"失效。
  // 供 applyCover 与「删除」按钮共用（删除按钮原先漏了这两步：
  //   输入慢速 URL 后立刻点删除 → 500ms 防抖到期仍会加载 → 预览又冒出来）。
  function cancelCoverLoad() {
    if (_coverLoadTimer) { clearTimeout(_coverLoadTimer); _coverLoadTimer = null; }
    _coverLoadSeq++;
    _coverLoading = false;
  }

  // 结果缓存读写：dataURL 是本地数据、瞬间加载，缓存它毫无意义，
  // 却会让整张图的 base64（几百 KB～几 MB）作为 key 常驻内存直到刷新，故跳过。
  function _coverCacheGet(url) {
    if (!url || url.indexOf('data:') === 0) return '';
    return _coverResult[url] || '';
  }
  function _coverCacheSet(url, result) {
    if (!url || url.indexOf('data:') === 0) return;
    _coverResult[url] = result;
  }
  // 清除某个地址的缓存结果（供「刷新」按钮强制重试）
  function _coverCacheDel(url) {
    if (!url) return;
    delete _coverResult[url];
  }

  // 统一入口：填输入框 + 解析预览地址 + 显示/隐藏预览
  // coverValue: frontmatter 里的原始值（如 ./images/1.png）
  // opts.mdDir: md 所在目录（云端草稿从 path 提取；其它默认 src/content/posts）
  // opts.force: true 时忽略结果缓存、强制重新加载（供「刷新」按钮重试用）
  function applyCover(coverValue, opts) {
    opts = opts || {};
    var val = String(coverValue || '');
    var mdDir = opts.mdDir || 'src/content/posts';
    var force = !!opts.force;

    // ① 填输入框：常驻隐藏框 + 面板框（面板未打开时后者不存在，跳过即可）
    var hiddenInput = document.getElementById('post-cover');
    if (hiddenInput) hiddenInput.value = val;
    var panelInput = panelContent ? panelContent.querySelector('#post-cover') : null;
    if (panelInput) panelInput.value = val;

    // ② 解析预览地址：刚上传的图（内存 dataURL）优先，其次按路径解析
    var previewUrl = window.__editorCoverDataUrl || _resolveCoverPreviewUrl(val, mdDir);

    // ③④ 单框显示：加载中（灰底 + 文字）→ 成功显示背景图 / 失败显示"图片不可用"
    //    设计说明：不用「<img> + 占位框」两个元素，改为单个 div 用 background-image 显示图片。
    //    只有一个元素、只切 class，从根本上杜绝"两个框同时显示"以及
    //    "内联 style 压过 hidden 类"这类问题。
    var box = document.getElementById('cover-preview') ||
              (panelContent ? panelContent.querySelector('#cover-preview') : null);
    var frame = document.getElementById('cover-preview-img') ||
                (panelContent ? panelContent.querySelector('#cover-preview-img') : null);
    if (!box || !frame) return;

    // 取消上一次尚未执行的加载（防抖），并让已发出的旧请求回调失效
    // （用户输入新地址后，旧请求的 onload/onerror 不得再改画面）
    cancelCoverLoad();

    if (!previewUrl) {
      // 无封面：清掉背景图与状态，整个预览区隐藏
      frame.style.backgroundImage = '';
      frame.classList.remove('cover-loading', 'cover-error');
      box.classList.add('hidden');
      return;
    }

    box.classList.remove('hidden');

    // 结果缓存：同一地址此前加载过（成功或失败都记），直接套用上次结果，不再发请求。
    // 这同时解决两个问题：
    //   ① 关闭面板再打开时 innerHTML 重建，frame 是新元素（背景图丢失），
    //      若重新走加载流程会先闪一下灰色"加载中"，直接套用缓存则不闪。
    //   ② 无效地址（如输入 "8"）请求长时间挂起时，重开面板不会再次卡在"加载中"。
    // opts.force 为 true 时跳过缓存并丢弃旧结果，强制重新加载（「刷新」按钮走这条）
    if (force) _coverCacheDel(previewUrl);
    var cachedResult = force ? '' : _coverCacheGet(previewUrl);
    if (cachedResult === 'ok') {
      frame.style.backgroundImage = 'url("' + String(previewUrl).replace(/"/g, '\\"') + '")';
      frame.classList.remove('cover-loading', 'cover-error');
      return;
    }
    if (cachedResult === 'error') {
      frame.style.backgroundImage = '';
      frame.classList.remove('cover-loading');
      frame.classList.add('cover-error');
      frame.setAttribute('data-ph-text', '图片不可用');
      return;
    }

    var doLoad = function() {
      var seq = ++_coverLoadSeq;
      _coverLoading = true;
      // 进入"加载中"：清掉旧背景图，灰底 + 文字（文字由 CSS ::after 读 data-ph-text 显示）
      frame.style.backgroundImage = '';
      frame.classList.remove('cover-error');
      frame.classList.add('cover-loading');
      frame.setAttribute('data-ph-text', '加载中...');

      var settled = false;   // 是否已经出结果（成功或失败）
      var timeoutTimer = null;
      var escapedUrl = String(previewUrl).replace(/"/g, '\\"');

      var finishOk = function() {
        settled = true;
        _coverLoading = false;
        if (timeoutTimer) clearTimeout(timeoutTimer);
        if (seq !== _coverLoadSeq) return;   // 已被更新的请求取代
        _coverCacheSet(previewUrl, 'ok');
        frame.style.backgroundImage = 'url("' + escapedUrl + '")';
        frame.classList.remove('cover-loading', 'cover-error');
      };
      var finishErr = function() {
        // 先清标志：早于 settled 检查，确保任何失败路径都能复位。
        // （若 finishOk 已执行过，它已置 false，这里重复赋值无害）
        _coverLoading = false;
        if (settled) return;
        settled = true;
        if (timeoutTimer) clearTimeout(timeoutTimer);
        if (seq !== _coverLoadSeq) return;
        _coverCacheSet(previewUrl, 'error');
        frame.style.backgroundImage = '';
        frame.classList.remove('cover-loading');
        frame.classList.add('cover-error');
        frame.setAttribute('data-ph-text', '图片不可用');
