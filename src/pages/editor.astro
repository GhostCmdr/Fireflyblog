        // 封面图统一处理（原逻辑：相对路径直接隐藏预览 → 与加载草稿时的设置打架）
        applyCover(window.__editorCoverValue || (document.getElementById('post-cover') || {}).value || '', {
          mdDir: window.__editorCoverMdDir || 'src/content/posts'
        });
        var hiddenTags = document.getElementById('post-tags');
        if (hiddenTags) {
          var tagArr = hiddenTags.value.split(',').map(function(t) { return t.trim(); }).filter(Boolean);
          var tag1 = panelContent.querySelector('#post-tag-1');
          var tag3 = panelContent.querySelector('#post-tag-3');
          if (tag1) tag1.value = tagArr[0] || '';
          if (tag3) tag3.value = tagArr.slice(1).join(', ');
        }
        [['chk-pinned', 'chk-pinned-panel', 'pinned'], ['chk-comment', 'chk-comment-panel', 'comment'], ['chk-draft', 'chk-draft-panel', 'draft']].forEach(function(pair) {
          var hidden = document.getElementById(pair[0]);
          var panel = panelContent.querySelector('#' + pair[1]);
          if (hidden && panel) {
            // [Editor] 以 metaCheckboxState 为唯一真相源恢复 UI（面板重建后隐藏框可能不同步）
            var st = metaCheckboxState[pair[2]] !== undefined ? metaCheckboxState[pair[2]] : hidden.checked;
            panel.checked = st;
            hidden.checked = st;
            metaCheckboxState[pair[2]] = st;
            syncCheckboxStyle(panel);
          }
        });
        // [DateFields] 日期回填 + change 写回隐藏源 + 「今天」按钮（面板每次打开重建 DOM，故在此处绑定）
        var _dateOnly = function(v) {
          var d = String(v || '').split('T')[0].split(' ')[0];
          return /^\d{4}-\d{2}-\d{2}$/.test(d) ? d : '';
        };
        // [DateFields] ① 只有"从未被用户手动改过(touched=false)"且为空才默认今天；
        // ② 手动清空/改过(touched=true) → 完全按用户留空，不再回填今天(真正清空)。
        // ③ 空态用 CSS 把原生 yyyy/mm/日 占位文字透明成视觉留白(有值正常显示)，不显示系统占位。
        if (!document.getElementById('editor-date-empty-css')) {
          var _deStyle = document.createElement('style');
          _deStyle.id = 'editor-date-empty-css';
          _deStyle.textContent = '#post-published-panel[data-empty="true"]::-webkit-datetime-edit, #post-updated-panel[data-empty="true"]::-webkit-datetime-edit { color: transparent; -webkit-text-fill-color: transparent; }';
          document.head.appendChild(_deStyle);
        }
        if (!window.__editorDateTouched) window.__editorDateTouched = { 'post-published': false, 'post-updated': false };
        [['post-published', 'post-published-panel'], ['post-updated', 'post-updated-panel']].forEach(function(tri) {
          var hiddenEl = document.getElementById(tri[0]);
          var panelEl = panelContent.querySelector('#' + tri[1]);
          if (!hiddenEl || !panelEl) return;
          var todayVal = new Date().toISOString().split('T')[0];
          var initVal = _dateOnly(hiddenEl.value);
          if (!initVal && !window.__editorDateTouched[tri[0]]) { initVal = todayVal; hiddenEl.value = todayVal; }
          panelEl.value = initVal;
          var syncEmpty = function() { panelEl.setAttribute('data-empty', panelEl.value ? 'false' : 'true'); };
          syncEmpty();
          panelEl.addEventListener('change', function() {
            window.__editorDateTouched[tri[0]] = true;
            hiddenEl.value = panelEl.value || '';
            syncEmpty();
          });
        });
      }
      if (name === 'drafts') renderDraftList();
      if (name === 'github') {
        // 从 localStorage 恢复 GitHub 设置
        var ghTokenPanel = document.getElementById('gh-token-panel');
        var ghRepoPanel = document.getElementById('gh-repo-panel');
        var ghBranchPanel = document.getElementById('gh-branch-panel');
        if (ghTokenPanel) ghTokenPanel.value = localStorage.getItem('gh-token') || '';
        if (ghRepoPanel) ghRepoPanel.value = localStorage.getItem('gh-repo') || '';
        if (ghBranchPanel) ghBranchPanel.value = localStorage.getItem('gh-branch') || '';
      }
    }
    // 面板切换时重置滚动位置：panel-content 同一元素被复用，不重置会残留上个面板的滚动位置
    panelContent.scrollTop = 0;
    slidePanel.style.width = '288px';
    panelInner.style.transform = 'translateX(0)';
    // 确保 panel-inner 是 flex 容器，让 panel-content 的 flex-1 生效
    panelInner.style.display = 'flex';
    panelInner.style.flexDirection = 'column';
    panelInner.style.height = '100%';
  }

  function closePanel() {
    slidePanel.style.width = '0px';
    panelInner.style.transform = 'translateX(-100%)';
    panelInner.style.display = '';
    panelInner.style.flexDirection = '';
    panelInner.style.height = '';
    currentPanel = '';
    _tocCache = '';
    document.querySelectorAll('[data-panel]').forEach(function(b) { b.classList.remove('active'); });
    panelContent.classList.remove('overflow-y-auto');
    panelContent.classList.add('overflow-hidden');
    // 按钮焦点环已由全局 CSS（button:focus-visible { outline:none }）统一处理，无需 JS blur
  }

  // [Editor] 草稿缓存：避免每次操作都从 localStorage 读取+解析
  var _draftsCache = null;
  function _getDrafts() {
    if (_draftsCache) return _draftsCache;
    _draftsCache = JSON.parse(localStorage.getItem('editor-drafts') || '[]');
    return _draftsCache;
  }
  function _saveDrafts(drafts) {
    _draftsCache = drafts;
    localStorage.setItem('editor-drafts', JSON.stringify(drafts));
  }
  function _invalidateDraftsCache() { _draftsCache = null; }

  // [Editor] 统一 click 事件委托（合并 GitHub 保存/清空 + 面板按钮 + 移除封面）
  panelContent.addEventListener('click', function(e) {
    var target = e.target;

    // 焦点黑边已由全局 CSS 统一处理（<style> 顶部 button:focus-visible { outline:none }），
    // 不再需要点击后 JS blur。实测确认鼠标/ESC 回归均命中 :focus-visible 且可被 CSS 压制。

    // GitHub 设置保存
    if (target.id === 'btn-save-token' || target.closest('#btn-save-token')) {
      var tokenInput = document.getElementById('gh-token-panel');
      var repoInput = document.getElementById('gh-repo-panel');
      var branchInput = document.getElementById('gh-branch-panel');
      var token = tokenInput ? tokenInput.value.trim() : '';
      var repo = repoInput ? repoInput.value.trim() : '';
      var branch = branchInput ? branchInput.value.trim() : '';
      if (token) localStorage.setItem('gh-token', token); else localStorage.removeItem('gh-token');
      if (repo) localStorage.setItem('gh-repo', repo); else localStorage.removeItem('gh-repo');
      if (branch) localStorage.setItem('gh-branch', branch); else localStorage.removeItem('gh-branch');
      window.__editorShowToast('GitHub 设置已保存');
      return;
    }
    // GitHub 设置清空
    if (target.id === 'btn-clear-gh' || target.closest('#btn-clear-gh')) {
      var tokenInput = document.getElementById('gh-token-panel');
      var repoInput = document.getElementById('gh-repo-panel');
      var branchInput = document.getElementById('gh-branch-panel');
      if (tokenInput) tokenInput.value = '';
      if (repoInput) repoInput.value = '';
      if (branchInput) branchInput.value = '';
      localStorage.removeItem('gh-token');
      localStorage.removeItem('gh-repo');
      localStorage.removeItem('gh-branch');
      window.__editorShowToast('GitHub 设置已清空');
      return;
    }
    // 保存草稿
    if (target.id === 'btn-save-draft' || target.closest('#btn-save-draft')) {
      var draftName = document.getElementById('draft-name-input').value || '未命名草稿';
      var getVal = function(id) { var el = document.getElementById(id); return el ? el.value : ''; };
      var savedAt = new Date().toISOString();
      var drafts = _getDrafts();
      drafts.push({
        name: draftName,
        title: getVal('post-title'),
        content: document.getElementById('markdown-input').value,
        desc: getVal('post-desc'),
        category: getVal('post-category'),
        tags: getVal('post-tags'),
        cover: window.__editorCoverValue || getVal('post-cover'),
        slug: getVal('post-slug'),
        urlSlug: getVal('post-url-slug'),
        password: getVal('post-password'),
        passwordHint: getVal('post-password-hint'),
        pinned: metaCheckboxState.pinned,
        comment: metaCheckboxState.comment,
        draft: metaCheckboxState.draft,
        published: getVal('post-published'),
        updated: getVal('post-updated'),
        dateTouched: window.__editorDateTouched ? { 'post-published': !!window.__editorDateTouched['post-published'], 'post-updated': !!window.__editorDateTouched['post-updated'] } : null,
        savedAt: savedAt
      });
      _saveDrafts(drafts);
      var content = document.getElementById('markdown-input').value;
      var usedFiles = {};
      var imgRegex2 = /!\[([^\]]*)\]\(\.\/images\/([^)]+)\)/g;
      var m2;
      while ((m2 = imgRegex2.exec(content)) !== null) { usedFiles[m2[2]] = true; }
      var imageMap = window.__editorImageMap || {};
      var imageKeys = Object.keys(usedFiles).filter(function(k) { return !!imageMap[k]; });
      var imgSavePromises = imageKeys.map(function(k) {
        return idbSet('img-' + savedAt + '-' + k, imageMap[k]).catch(function() {});
      });
      if (imageKeys.length > 0) {
        imgSavePromises.push(idbSet('imgkeys-' + savedAt, imageKeys).catch(function() {}));
      }
      if (window.__editorCoverDataUrl) {
        imgSavePromises.push(idbSet('cover-' + savedAt, window.__editorCoverDataUrl).catch(function() {}));
      } else {
        imgSavePromises.push(idbDel('cover-' + savedAt).catch(function() {}));
      }
      Promise.all(imgSavePromises).then(function() {
        document.getElementById('draft-name-input').value = '';
        renderDraftList();
        showToast('草稿已保存');
      });
      return;
    }
    // 删除草稿（本地 / 云端 同构项，靠 data-cloudpath 区分）
    if (target.classList.contains('draft-delete')) {
      e.stopPropagation();
      var delSid = target.dataset.savedat;
      if (target.dataset.cloudpath) {
        var delPath = target.dataset.cloudpath;
        if (delPath) {
          window.__editorConfirm({
            title: '删除云端草稿',
            message: getCloudI18n('cloudDraftDeleteConfirm', '确认删除云端草稿「' + delPath + '」？此操作不可恢复'),
            okText: '确认删除'
          }, function() { deleteCloudDraft(delPath); });
        }
        return;
      }
      // 本地草稿删除：加确认弹窗（与云端删除行为一致，防止误点直接删除且不可恢复）
      var localDrafts = _getDrafts();
      var delTarget = localDrafts.filter(function(d) { return d.savedAt === delSid; })[0];
      var delName = (delTarget && delTarget.name) || '未命名草稿';
      window.__editorConfirm({
        title: '删除本地草稿',
        message: '确认删除本地草稿「' + delName + '」？此操作不可恢复',
        okText: '确认删除'
      }, function() {
        var drafts = _getDrafts();
        idbDelPrefix('img-' + delSid + '-').catch(function() {});
        idbDel('imgkeys-' + delSid).catch(function() {});
        idbDel('cover-' + delSid).catch(function() {});
        localStorage.removeItem('editor-draft-img-' + delSid);
        localStorage.removeItem('editor-draft-imgkeys-' + delSid);
        localStorage.removeItem('editor-draft-cover-' + delSid);
        drafts = drafts.filter(function(d) { return d.savedAt !== delSid; });
        _saveDrafts(drafts);
        renderDraftList();
      });
      return;
    }
    // 全选/取消全选（本地：限定 #draft-list 作用域，避免误选云端 checkbox）
    if (target.id === 'draft-select-all') {
      var checkboxes = panelContent.querySelectorAll('#draft-list .draft-checkbox');
      checkboxes.forEach(function(cb) { cb.checked = target.checked; });
      var toolbar = document.getElementById('draft-toolbar');
      var listEl2 = document.getElementById('draft-list');
      if (toolbar) toolbar.classList.toggle('hidden', !target.checked);
      if (listEl2) {
        listEl2.classList.toggle('tb-off', !target.checked);
        listEl2.classList.toggle('tb-on', target.checked);
      }
      return;
    }
    // 全选/取消全选（云端：限定 #draft-cloud-list，列表 tb-off/tb-on 与本地同机制）
    if (target.id === 'draft-cloud-select-all') {
      var cloudCheckboxes = panelContent.querySelectorAll('#draft-cloud-list .draft-checkbox');
      cloudCheckboxes.forEach(function(cb) { cb.checked = target.checked; });
      var cloudToolbarAll = document.getElementById('draft-toolbar-cloud');
      var cloudListAll = document.getElementById('draft-cloud-list');
      if (cloudToolbarAll) cloudToolbarAll.classList.toggle('hidden', !target.checked);
      if (cloudListAll) {
        cloudListAll.classList.toggle('tb-off', !target.checked);
        cloudListAll.classList.toggle('tb-on', target.checked);
      }
      return;
    }
    // 删除选中（本地）
    if (target.id === 'btn-delete-selected' || target.closest('#btn-delete-selected')) {
      var checkedBoxes = panelContent.querySelectorAll('#draft-list .draft-checkbox:checked');
      if (checkedBoxes.length === 0) return;
      var sids = Array.from(checkedBoxes).map(function(cb) { return cb.dataset.savedat; });
      // 批量删除：加确认弹窗（与单条删除/云端删除行为一致，防止误删多条不可恢复）
      window.__editorConfirm({
        title: '删除选中的本地草稿',
        message: '确认删除选中的 ' + sids.length + ' 个本地草稿？此操作不可恢复',
        okText: '确认删除'
      }, function() {
        var drafts = _getDrafts();
        sids.forEach(function(sid) {
          idbDelPrefix('img-' + sid + '-').catch(function() {});
          idbDel('imgkeys-' + sid).catch(function() {});
          idbDel('cover-' + sid).catch(function() {});
          localStorage.removeItem('editor-draft-img-' + sid);
          localStorage.removeItem('editor-draft-imgkeys-' + sid);
          localStorage.removeItem('editor-draft-cover-' + sid);
        });
        drafts = drafts.filter(function(d) { return sids.indexOf(d.savedAt) === -1; });
        _saveDrafts(drafts);
        renderDraftList();
      });
      return;
    }
    // 删除选中（云端）：批量推送 GitHub 仓库删除（逐个串行调用 deleteCloudDraft，silent 模式最后统一提示）
    if (target.id === 'btn-delete-cloud-selected' || target.closest('#btn-delete-cloud-selected')) {
      var cloudChecked = panelContent.querySelectorAll('#draft-cloud-list .draft-checkbox:checked');
      if (cloudChecked.length === 0) return;
      var cloudPaths = Array.from(cloudChecked).map(function(cb) { return cb.dataset.cloudpath || cb.dataset.savedat; }).filter(Boolean);
      if (cloudPaths.length === 0) return;
      window.__editorConfirm({
        title: '删除选中的云端草稿',
        message: '确认删除选中的 ' + cloudPaths.length + ' 个云端草稿？此操作不可恢复',
        okText: '确认删除'
      }, function() {
        var okCount = 0;
        var chain = Promise.resolve();
        cloudPaths.forEach(function(p) {
          chain = chain.then(function() { return deleteCloudDraft(p, { silent: true }); })
            .then(function(ok) { if (ok) okCount++; });
        });
        chain.then(function() {
          window.__editorShowToast(okCount === cloudPaths.length
            ? '✅ 已删除 ' + okCount + ' 个云端草稿'
            : '⚠️ 部分删除失败（成功 ' + okCount + '/' + cloudPaths.length + '）');
          renderCloudList();
          var selectAll = document.getElementById('draft-cloud-select-all');
          if (selectAll) selectAll.checked = false;
        });
      });
      return;
    }
    // 加载草稿（本地 / 云端 同构项，靠 data-cloudpath 区分）
    if (target.classList.contains('draft-load') || target.closest('.draft-load')) {
      var item = target.classList.contains('draft-load') ? target : target.closest('.draft-load');
      var loadSid = item.dataset.savedat;
      if (item.dataset.cloudpath) {
        openCloudDraft(item.dataset.cloudpath, item.dataset.cloudsha);
        return;
      }
      var drafts = _getDrafts();
      var d = drafts.find(function(dr) { return dr.savedAt === loadSid; });
      if (d) {
        var setVal = function(id, val) { var el = document.getElementById(id); if (el) el.value = val || ''; };
        var setChecked = function(id, val) { var el = document.getElementById(id); if (el) el.checked = !!val; };
        setVal('post-title', d.title);
        setVal('post-desc', d.desc);
        setVal('post-category', d.category);
        setVal('post-tags', d.tags);
        setVal('post-cover', d.cover);
        window.__editorCoverValue = d.cover || '';
        setVal('post-slug', d.slug);
        setVal('post-url-slug', d.urlSlug || d.slug);
        setVal('post-password', d.password);
        setVal('post-password-hint', d.passwordHint);
        setVal('post-published', d.published);
        setVal('post-updated', d.updated);
        setChecked('chk-pinned', d.pinned);
        setChecked('chk-comment', d.comment);
        setChecked('chk-draft', d.draft);
        if (window.__editorMetaCheckbox) {
          // [Fix] 本地草稿载入需把 pinned/comment 一并同步进发布真源 metaCheckboxState（原只同步 draft，导致载入后置顶/评论发布不生效）
          window.__editorMetaCheckbox.pinned = !!d.pinned;
          window.__editorMetaCheckbox.comment = d.comment === false ? false : true;
          window.__editorMetaCheckbox.draft = !!d.draft;
        }
        // [DateFields] 草稿记住"日期是否被有意清空(touched)"：跨会话加载后空字段保持空白，不被"默认今天"覆盖
        if (d.dateTouched) {
          if (!window.__editorDateTouched) window.__editorDateTouched = { 'post-published': false, 'post-updated': false };
          if (d.dateTouched['post-published'] !== undefined) window.__editorDateTouched['post-published'] = !!d.dateTouched['post-published'];
          if (d.dateTouched['post-updated'] !== undefined) window.__editorDateTouched['post-updated'] = !!d.dateTouched['post-updated'];
        }
        var mdInput = document.getElementById('markdown-input');
        mdInput.value = d.content || '';
        // 立即渲染预览，不等图片加载
        window.__editorForcePreview();
        window.__editorCoverDataUrl = '';
        window.__editorCoverFilename = '';
        if (d.cover) {
          window.__editorCoverValue = d.cover;
          var extractedFilename = d.cover.split('/').pop();
          if (extractedFilename) window.__editorCoverFilename = extractedFilename;
        }
        var loadSid = d.savedAt;
        var imgPromises = [];
        imgPromises.push(
          idbGet('imgkeys-' + loadSid).then(function(keyList) {
            if (!keyList || !keyList.length) return 0;
            var subPromises = keyList.map(function(k) {
              return idbGet('img-' + loadSid + '-' + k).then(function(dataUrl) {
                if (dataUrl) window.__editorImageMap[k] = dataUrl;
              });
            });
            return Promise.all(subPromises).then(function() { return keyList.length; });
          }).catch(function() { return 0; })
        );
        imgPromises.push(
          new Promise(function(resolve) {
            var savedImages = localStorage.getItem('editor-draft-img-' + loadSid);
            if (savedImages) {
              try {
                var draftImgMap = JSON.parse(savedImages);
                Object.assign(window.__editorImageMap, draftImgMap);
                localStorage.removeItem('editor-draft-img-' + loadSid);
              } catch(e) {}
            }
            resolve();
          })
        );
        imgPromises.push(
          idbGet('cover-' + loadSid).then(function(savedCover) {
            if (savedCover) window.__editorCoverDataUrl = savedCover;
          }).catch(function() {})
        );
        imgPromises.push(
          new Promise(function(resolve) {
            var savedCover = localStorage.getItem('editor-draft-cover-' + loadSid);
            if (savedCover) {
              window.__editorCoverDataUrl = savedCover;
              localStorage.removeItem('editor-draft-cover-' + loadSid);
            }
            resolve();
          })
        );
        // 图片恢复完成后统一处理封面（dataURL 已在上方恢复，函数内会自动优先使用）
        Promise.all(imgPromises).then(function() {
          // ⚠️ 本地草稿不属于仓库任何特定目录，必须用默认目录。
          //    若沿用 window.__editorCoverMdDir，会残留上一次云端草稿/文章导入的子目录
          //    （如 src/content/posts/sub）→ 封面路径拼错 → 显示"图片不可用"。
          window.__editorCoverMdDir = 'src/content/posts';
          applyCover(d.cover || '', { mdDir: 'src/content/posts' });
        });
        var titleInput = document.getElementById('post-title-input');
        if (titleInput) titleInput.value = d.title || '';
        closePanel();
        showToast('草稿已加载');
      }
      return;
    }
    // 移除封面图
    if (target.id === 'btn-remove-cover' || target.closest('#btn-remove-cover')) {
      var hiddenCover = document.getElementById('post-cover');
      if (hiddenCover) hiddenCover.value = '';
      var panelCover = panelContent.querySelector('#post-cover');
      if (panelCover) panelCover.value = '';
      window.__editorCoverValue = '';
      window.__editorCoverDataUrl = '';
      window.__editorCoverFilename = '';
      // 关键：必须取消待执行的加载，否则刚输入的地址在 500ms 防抖到期后仍会触发加载 → 预览又冒出来；
      // 同时递增序号让已发出的旧请求回调失效，避免它回头把预览重新显示。
      cancelCoverLoad();
      var preview = document.getElementById('cover-preview');
      if (preview) preview.classList.add('hidden');
      // 同步清掉预览框上的背景图与状态类（仅隐藏外层容器不够，重开面板会残留旧图）
      var pFrame = document.getElementById('cover-preview-img');
      if (pFrame) {
        pFrame.style.backgroundImage = '';
        pFrame.classList.remove('cover-loading', 'cover-error');
      }
      var fileInput = document.getElementById('cover-upload');
      if (fileInput) fileInput.value = '';
      return;
    }
    // 刷新封面预览：网络不稳定（raw.githubusercontent.com 时好时坏）导致加载失败时，
    // 结果缓存会记住"失败"且不再重试，用户点此按钮强制重新加载一次。
    if (target.id === 'btn-refresh-cover' || target.closest('#btn-refresh-cover')) {
      var refreshVal = window.__editorCoverValue || '';
      if (!refreshVal) return;
      // 已有请求在飞行中 → 忽略本次点击，避免连点产生多个挂起请求
      // （此时画面上正显示"加载中..."，用户有反馈，不会以为没反应）
      if (_coverLoading) return;
      // force: true → 丢弃该地址的缓存结果并重新发起请求（不走防抖，立即执行）
      applyCover(refreshVal, { mdDir: window.__editorCoverMdDir || 'src/content/posts', force: true });
      return;
    }
    // 草稿箱 tab 切换（本地/云端），事件委托挂在永生父节点，面板 innerHTML 重写后仍有效
    var tabBtn = target.closest('[data-tab]');
    if (tabBtn) {
      var tabName = tabBtn.getAttribute('data-tab');
      if (tabName === 'local' || tabName === 'cloud') {
        _draftTab = tabName;
        renderDraftList();
      }
      return;
    }
    // 刷新云端草稿
    if (target.id === 'btn-refresh-cloud' || target.closest('#btn-refresh-cloud')) {
      fetchCloudDrafts(true);
      return;
    }
    // 注：云端项已与本地项同构（draft-load / draft-delete / draft-checkbox 同名类），
    // 打开/删除逻辑统一在上方 draft-load / draft-delete 分支处理（靠 data-cloudpath 区分）。
  });

  // [Editor] 格式化时间为 YYYY-MM-DD HH:mm
  function formatDraftTime(isoStr) {
    if (!isoStr) return '';
    var d = new Date(isoStr);
    var pad = function(n) { return n < 10 ? '0' + n : n; };
    return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
  }

  // [Fix #11] HTML 转义：草稿/云端列表内展示的用户可控文本(name/title/path/fileName)，防 HTML 注入
  function _escHtml(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function(c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  // 草稿箱当前激活 tab：'local' | 'cloud'
  var _draftTab = 'local';

  // 草稿列表渲染（由 _draftTab 驱动本地/云端区显隐）
  function renderDraftList() {
    var localArea = document.getElementById('draft-local-area');
    var cloudArea = document.getElementById('draft-cloud-area');
    if (!localArea || !cloudArea) return;
    if (_draftTab === 'cloud') {
      // 不用 classList.toggle('hidden')：两个区域都有内联 style.display:flex，会覆盖 tailwind hidden
      localArea.style.display = 'none';
      cloudArea.style.display = 'flex';
      renderCloudList();
    } else {
      cloudArea.style.display = 'none';
      localArea.style.display = 'flex';
      renderLocalDraftList();
    }
    // 同步 tab 按钮高亮
    var tabLocal = panelContent.querySelector('[data-tab="local"]');
    var tabCloud = panelContent.querySelector('[data-tab="cloud"]');
    function setTabStyle(btn, active) {
      if (!btn) return;
      // 选中态与其他面板按钮统一：边框 primary + 背景 primary 12% + 文字 primary（与 syncCheckboxStyle 同款）
      btn.style.color = active ? 'var(--primary)' : '';
      btn.style.borderColor = active ? 'var(--primary)' : '';
      btn.style.background = active ? 'color-mix(in srgb, var(--primary) 12%, transparent)' : '';
      btn.classList.toggle('text-black/60', !active);
      btn.classList.toggle('dark:text-white/60', !active);
    }
    setTabStyle(tabLocal, _draftTab === 'local');
    setTabStyle(tabCloud, _draftTab === 'cloud');
  }

  function renderLocalDraftList() {
    var list = document.getElementById('draft-list');
    if (!list) return;
    var drafts = _getDrafts();
    drafts.sort(function(a, b) { return (b.savedAt || '').localeCompare(a.savedAt || ''); });
    var toolbar = document.getElementById('draft-toolbar');
    // 渲染列表时 toolbar 一律隐藏，容器回到 tb-off（隐藏态留白），仅勾选项时由 change 事件展开
    if (toolbar) toolbar.classList.add('hidden');
    list.classList.add('tb-off');
    list.classList.remove('tb-on');
    if (drafts.length === 0) {
      list.innerHTML = '<div class="text-sm text-black/40 dark:text-white/40 text-center py-8">暂无草稿</div>';
      return;
    }
    list.innerHTML = drafts.map(function(d) {
      var sid = d.savedAt || '';
      return '<div class="draft-item rounded-lg border border-[var(--line-divider)] hover:border-[var(--primary)] hover:bg-[var(--primary)]/5 transition-colors" data-savedat="' + sid + '" style="padding:0.25rem 0.75rem;margin:0 0 0.25rem 0;">' +
        '<div class="flex items-center gap-2">' +
          '<input type="checkbox" class="draft-checkbox shrink-0 rounded" data-savedat="' + sid + '" />' +
          '<div class="flex-1 min-w-0 cursor-pointer draft-load" data-savedat="' + sid + '">' +
            '<div class="flex items-center justify-between">' +
              '<div class="text-xs font-bold text-black/80 dark:text-white/80 truncate min-w-0">' + _escHtml(d.name || '未命名草稿') + '</div>' +
              '<button class="text-xs text-red-400 hover:text-red-600 shrink-0 draft-delete" data-savedat="' + sid + '">删除</button>' +
            '</div>' +
            '<div class="text-xs text-black/50 dark:text-white/50 mt-1.5 min-w-0" style="background:color-mix(in srgb, currentColor 8%, transparent);padding:0.5rem 0.75rem;border-radius:0.5rem;">' +
              '<div class="truncate">' + (d.title ? '标题：' + _escHtml(d.title) : '无标题') + '</div>' +
              '<div class="mt-1 truncate">' + formatDraftTime(d.savedAt) + '</div>' +
            '</div>' +
          '</div>' +
        '</div>' +
      '</div>';
    }).join('');
  }

  // 云端草稿缓存 key
  var CLOUD_DRAFTS_CACHE_KEY = 'editor-cloud-drafts-cache';

  // 读取 GitHub 配置（复用发布逻辑：面板优先 → localStorage → 默认）
  function getCloudGithubConfig() {
    var tokenEl = document.getElementById('gh-token-panel');
    var repoEl = document.getElementById('gh-repo-panel');
    var branchEl = document.getElementById('gh-branch-panel');
    return {
      token: (tokenEl ? tokenEl.value : '') || localStorage.getItem('gh-token') || '',
      repo: (repoEl ? repoEl.value : '') || localStorage.getItem('gh-repo') || 'GhostCmdr/Fireflyblog',
      branch: (branchEl ? branchEl.value : '') || localStorage.getItem('gh-branch') || 'main'
    };
  }

  // 轻量 frontmatter 解析（title/draft/tags/category 等）
  // 支持三种 YAML 写法：
  //   1) key: value
  //   2) key: [a, b, c]          内联数组 → 归一化成 "a, b, c"
  //   3) key: 后跟多行 "- item"   块数组   → 归一化成 "a, b, c"
  // 说明：原实现只处理第 1 种，遇到 tags: [编辑 测试, 功能验证] 会把方括号一并存下，
  //       导致标签输入框显示成 "[编辑  测试, 功能验证]"（把 YAML 源码显示出来了）。
  function parseCloudFrontmatter(content) {
    var m = content.match(/^---\s*\n([\s\S]*?)\n---/);
    var meta = {};
    if (!m) return meta;
    var curKey = null;
    var arrBuf = null;
    function flushArr() {
      if (curKey && arrBuf && arrBuf.length) meta[curKey] = arrBuf.join(', ');
      arrBuf = null;
    }
    function clean(s) { return s.trim().replace(/^["']|["']$/g, ''); }
    m[1].split('\n').forEach(function(line) {
      // 块数组项："- item"
      var arr = line.match(/^\s*-\s+(.*)$/);
      if (arr && curKey) {
        if (!arrBuf) arrBuf = [];
        var v = clean(arr[1]);
        if (v) arrBuf.push(v);
        return;
      }
      var kv = line.match(/^(\w+):\s*(.*)$/);
      if (kv) {
        flushArr();
        curKey = kv[1];
        var raw = kv[2].trim();
        if (/^\[.*\]$/.test(raw)) {
          // 内联数组 [a, b, c] → "a, b, c"
          var inner = raw.slice(1, -1).trim();
          meta[curKey] = inner
            ? inner.split(',').map(clean).filter(Boolean).join(', ')
            : '';
        } else {
          meta[curKey] = clean(raw);
        }
      }
    });
    flushArr();
    return meta;
  }

  function getCloudI18n(key, fallback) {
    return (window.editorCloudI18n && window.editorCloudI18n[key]) ? window.editorCloudI18n[key] : fallback;
  }

  // ─── 通用确认弹窗（替代浏览器原生 confirm，原生样式与编辑器风格不统一）───
  // 用法：window.__editorConfirm({ title, message, okText }, function(){ /* 确认后执行 */ });
  var _confirmCallback = null;
  window.__editorConfirm = function(opts, onConfirm) {
    var modal = document.getElementById('confirm-modal');
    var titleEl = document.getElementById('confirm-modal-title');
    var msgEl = document.getElementById('confirm-modal-message');
    var okBtn = document.getElementById('confirm-modal-ok');
    if (!modal || !msgEl) {
      // 兜底：弹窗元素缺失时退回原生 confirm
      if (onConfirm && window.confirm((opts && opts.message) || '')) onConfirm();
      return;
    }
    if (titleEl) titleEl.textContent = (opts && opts.title) || '确认操作';
    msgEl.textContent = (opts && opts.message) || '';
    if (okBtn && opts && opts.okText) okBtn.textContent = opts.okText;
    _confirmCallback = onConfirm || null;
    modal.classList.remove('hidden');
  };
  window.__editorCloseConfirm = function() {
    var modal = document.getElementById('confirm-modal');
    if (modal) modal.classList.add('hidden');
    // 按钮焦点环已由全局 CSS（button:focus-visible { outline:none }）统一处理，无需 JS blur
    _confirmCallback = null;
  };
  // 按钮/遮罩事件一次性绑定（用 _confirmCallback 存回调，避免重复绑定累积）
  (function() {
    var cModal = document.getElementById('confirm-modal');
    var cOk = document.getElementById('confirm-modal-ok');
    var cCancel = document.getElementById('confirm-modal-cancel');
    if (cCancel) cCancel.addEventListener('click', function() { window.__editorCloseConfirm(); });
    if (cOk) cOk.addEventListener('click', function() {
      var cb = _confirmCallback;
      window.__editorCloseConfirm();
      if (cb) cb();
    });
    // 点击遮罩空白处关闭
    if (cModal) cModal.addEventListener('click', function(e) {
      if (e.target === cModal) window.__editorCloseConfirm();
    });
  })();

  // [Editor] 把 GitHub API 的英文错误转成友好的中文提示（图标 + 标题 + 处理建议），
  // 替代直接裸露 "Bad credentials" 这类原始报错
  // 行内小图标：直接克隆图标栏「GitHub 设置」按钮里的 svg（当前为线条版钥匙），
  // 供提示文字里指示"点这个图标"用。克隆而非复制 path → 与图标栏永远一致，无需维护第二份坐标。
  function ghKeyIconHtml() {
    var el = document.querySelector('#right-icon-bar [data-panel="github"] svg');
    if (!el) return '🔑'; // 兜底：图标栏不在 DOM 时退回 emoji
    return '<span style="display:inline-block;width:1.35em;height:1.35em;vertical-align:-0.28em;line-height:0;">' +
      el.outerHTML.replace('<svg ', '<svg style="width:100%;height:100%;display:block;" ') + '</span>';
  }

  function friendlyGhError(raw) {
    var m = String(raw || '');
    if (/bad credentials|unauthorized|401/i.test(m)) {
      return { icon: '🔑', title: 'Token 无效或已过期', hint: '请点击右侧 GitHub 设置图标 → ' + ghKeyIconHtml() + '，重新填写有效的 Personal Access Token' };
    }
    if (/not found|404/i.test(m)) {
      return { icon: '📁', title: '未找到仓库或分支', hint: '请检查 GitHub 设置中的仓库名与分支名是否正确（格式：用户名/仓库名）' };
    }
    if (/rate limit|403/i.test(m)) {
      return { icon: '⏳', title: 'GitHub 访问次数已达上限', hint: '请等待几分钟后再点击「刷新云端」重试' };
    }
    if (/failed to fetch|networkerror|load failed|network error/i.test(m)) {
      return { icon: '📡', title: '网络连接失败', hint: '请检查网络后点击「刷新云端」重试' };
    }
    return { icon: '⚠️', title: '读取失败', hint: m || '请稍后重试' };
  }

  // 渲染云端草稿列表（优先读缓存，无缓存触发拉取）
  function renderCloudList() {
    var listEl = document.getElementById('draft-cloud-list');
    var statusEl = document.getElementById('draft-cloud-status');
    if (!listEl) return;
    var cache = null;
    try { cache = JSON.parse(localStorage.getItem(CLOUD_DRAFTS_CACHE_KEY) || 'null'); } catch (e) { cache = null; }
    if (cache && cache.list) {
      if (statusEl) statusEl.textContent = getCloudI18n('cloudDraftLastFetched', '最后加载时间：') + formatDraftTime(cache.fetchedAt ? new Date(cache.fetchedAt).toISOString() : '');
      renderCloudItems(cache.list);
    } else {
      // 无缓存：首次自动拉取一次
      fetchCloudDrafts(false);
    }
  }

  function renderCloudItems(list) {
    var listEl = document.getElementById('draft-cloud-list');
    if (!listEl) return;
    if (!list || list.length === 0) {
      listEl.innerHTML = '<div class="text-sm text-black/40 dark:text-white/40 text-center py-8">' + getCloudI18n('cloudDraftEmpty', '暂无云端草稿') + '</div>';
      var cloudToolbar = document.getElementById('draft-toolbar-cloud');
      if (cloudToolbar) cloudToolbar.classList.add('hidden');
      return;
    }
    listEl.innerHTML = list.map(function(d) {
      // 与本地 renderLocalDraftList 的 draft-item 模板【逐行完全一致】，仅 data 标识与文本来源不同
      var sid = d.path || '';
      var shaShort = (d.sha || '').slice(0, 8);
      // 从 path 提取文件名（含扩展名），与下方信息框显示的路径末段保持一致
      var fileName = (d.path || '').split('/').pop() || '';
      return '<div class="draft-item rounded-lg border border-[var(--line-divider)] hover:border-[var(--primary)] hover:bg-[var(--primary)]/5 transition-colors" data-savedat="' + sid + '" data-cloudpath="' + d.path + '" data-cloudsha="' + d.sha + '" style="padding:0.25rem 0.75rem;margin:0 0 0.25rem 0;">' +
        // 与本地草稿项同构：勾选框 + 内容区（draft-load）。勾选框带 data-cloudpath 供批量删除定位
        '<div class="flex items-center gap-2">' +
          '<input type="checkbox" class="draft-checkbox shrink-0 rounded" data-savedat="' + sid + '" data-cloudpath="' + d.path + '" />' +
          '<div class="flex-1 min-w-0 cursor-pointer draft-load" data-savedat="' + sid + '" data-cloudpath="' + d.path + '" data-cloudsha="' + d.sha + '">' +
            '<div class="flex items-center justify-between">' +
              '<div class="text-xs font-bold text-black/80 dark:text-white/80 truncate min-w-0">' + (fileName ? '文件名：' + _escHtml(fileName) : _escHtml(d.path)) + '</div>' +
              '<button class="text-xs text-red-400 hover:text-red-600 shrink-0 draft-delete" data-savedat="' + sid + '" data-cloudpath="' + d.path + '">删除</button>' +
            '</div>' +
            '<div class="text-xs text-black/50 dark:text-white/50 mt-1.5 min-w-0" style="background:color-mix(in srgb, currentColor 8%, transparent);padding:0.5rem 0.75rem;border-radius:0.5rem;">' +
              '<div class="truncate">' + (d.title ? '标题：' + _escHtml(d.title) : '无标题') + '</div>' +
              '<div class="mt-1 truncate">' + _escHtml(d.path || '') + (shaShort ? ' · ' + _escHtml(shaShort) : '') + '</div>' +
            '</div>' +
          '</div>' +
        '</div>' +
      '</div>';
    }).join('');
    // 渲染后重置：toolbar 默认隐藏、列表回到 tb-off、全选勾选归位（勾选项由 change 事件控制显隐）
    var cloudToolbar = document.getElementById('draft-toolbar-cloud');
    if (cloudToolbar) cloudToolbar.classList.add('hidden');
    var cloudListRes = document.getElementById('draft-cloud-list');
    if (cloudListRes) {
      cloudListRes.classList.add('tb-off');
      cloudListRes.classList.remove('tb-on');
    }
    var cloudSelectAll = document.getElementById('draft-cloud-select-all');
    if (cloudSelectAll) cloudSelectAll.checked = false;
  }

  // 拉取云端草稿（force=true 忽略缓存）
  function fetchCloudDrafts(force) {
    var listEl = document.getElementById('draft-cloud-list');
    var statusEl = document.getElementById('draft-cloud-status');
    if (!listEl) return;
    if (!force) {
      var cache = null;
      try { cache = JSON.parse(localStorage.getItem(CLOUD_DRAFTS_CACHE_KEY) || 'null'); } catch (e) { cache = null; }
      if (cache && cache.list) { renderCloudItems(cache.list); return; }
    }
    var cfg = getCloudGithubConfig();
    if (!cfg.token) {
      if (statusEl) statusEl.textContent = '';
      listEl.innerHTML = '<div class="text-sm text-black/40 dark:text-white/40 text-center py-8">' + getCloudI18n('cloudDraftNeedToken', '请先在 GitHub 设置中填写 Token') + '</div>';
      return;
    }
    if (statusEl) statusEl.textContent = getCloudI18n('cloudDraftLoading', '正在读取云端草稿...');
    listEl.innerHTML = '<div class="text-sm text-black/40 dark:text-white/40 text-center py-8">' + getCloudI18n('cloudDraftLoading', '加载中...') + '</div>';

    var apiUrl = 'https://api.github.com/repos/' + cfg.repo + '/contents/src/content/posts?ref=' + cfg.branch;
    fetch(apiUrl, {
      headers: { 'Authorization': 'token ' + cfg.token, 'Accept': 'application/vnd.github.v3+json' }
    }).then(function(r) {
      if (!r.ok) return r.json().then(function(e) { throw new Error(e.message || ('HTTP ' + r.status)); });
      return r.json();
    }).then(function(items) {
      var mdFiles = (items || []).filter(function(it) { return it.type === 'file' && /\.(md|mdx)$/i.test(it.name); });
      if (mdFiles.length === 0) {
        if (statusEl) statusEl.textContent = '';
        listEl.innerHTML = '<div class="text-sm text-black/40 dark:text-white/40 text-center py-8">' + getCloudI18n('cloudDraftEmpty', '暂无云端草稿') + '</div>';
        return;
      }
      return Promise.all(mdFiles.map(function(it) {
        return fetch(it.url, {
          headers: { 'Authorization': 'token ' + cfg.token, 'Accept': 'application/vnd.github.v3+json' }
        }).then(function(r) { return r.ok ? r.json() : null; }).then(function(data) {
          if (!data || !data.content) return null;
          var content = decodeURIComponent(escape(atob(data.content.replace(/\s/g, ''))));
          var meta = parseCloudFrontmatter(content);
          if (meta.draft === 'true' || meta.draft === true) {
            return { path: it.path, sha: data.sha, title: meta.title || it.name.replace(/\.(md|mdx)$/i, '') };
          }
          return null;
        }).catch(function() { return null; });
      })).then(function(drafts) {
        var cloudDrafts = drafts.filter(Boolean);
        try {
          localStorage.setItem(CLOUD_DRAFTS_CACHE_KEY, JSON.stringify({ list: cloudDrafts, fetchedAt: Date.now() }));
        } catch (e) {}
        if (statusEl) statusEl.textContent = getCloudI18n('cloudDraftLastFetched', '最后加载时间：') + formatDraftTime(new Date().toISOString());
        renderCloudItems(cloudDrafts);
      });
    }).catch(function(err) {
      if (statusEl) statusEl.textContent = '';
      var fe = friendlyGhError(err && err.message);
      // 友好错误卡片：图标 + 标题 + 处理建议（替代裸露的英文原始报错）
      listEl.innerHTML =
        '<div class="text-center py-8 px-3">' +
          '<div style="font-size:1.75rem;line-height:1;margin-bottom:0.5rem;opacity:0.85;">' + fe.icon + '</div>' +
          '<div class="text-sm" style="color:var(--font-color);">' + fe.title + '</div>' +
          '<div class="text-xs mt-2" style="color:color-mix(in srgb, var(--font-color) 55%, transparent);line-height:1.6;">' + fe.hint + '</div>' +
        '</div>';
    });
  }

  // 打开云端草稿进编辑器（完整复用本地 draft-load 回填逻辑）
  function openCloudDraft(path, sha) {
    var cfg = getCloudGithubConfig();
    if (!cfg.token) { window.__editorShowToast(getCloudI18n('cloudDraftNeedToken', '请先填写 GitHub Token')); return; }
    var apiUrl = 'https://api.github.com/repos/' + cfg.repo + '/contents/' + path + '?ref=' + cfg.branch;
    fetch(apiUrl, {
      headers: { 'Authorization': 'token ' + cfg.token, 'Accept': 'application/vnd.github.v3+json' }
    }).then(function(r) {
      if (!r.ok) return r.json().then(function(e) { throw new Error(e.message || ('HTTP ' + r.status)); });
      return r.json();
    }).then(function(data) {
      var content = decodeURIComponent(escape(atob(data.content.replace(/\s/g, ''))));
      var sep = content.match(/^---\s*\n[\s\S]*?\n---\n?/);
      var body = sep ? content.slice(sep[0].length) : content;
      var meta = parseCloudFrontmatter(content);
      // —— 以下完整复制本地 draft-load 回填段（1555–1641 行逻辑），仅数据来自云端文件 ——
      var setVal = function(id, val) { var el = document.getElementById(id); if (el) el.value = val || ''; };
      var setChecked = function(id, val) { var el = document.getElementById(id); if (el) el.checked = !!val; };
      setVal('post-title', meta.title || '');
      setVal('post-desc', meta.description);
      setVal('post-category', meta.category);
      setVal('post-tags', meta.tags);
      // 封面字段名兼容：本编辑器发布时写的是 `image:`（见 1337 行 _buildFrontmatter），
      // 但用户手写/其它工具生成的 frontmatter 可能用 `cover:`。两者都认，优先 cover。
      var cloudCover = meta.cover || meta.image || '';
      setVal('post-cover', cloudCover);
      window.__editorCoverValue = cloudCover;
      setVal('post-slug', '');            // 发布走新建，不动原文件
      setVal('post-url-slug', '');
      // [DateFields] 云端文件若带 published/updated 则回填（载入已发布文章/带日期的草稿时保留原日期）
      setVal('post-published', meta.published);
      setVal('post-updated', meta.updated);
      setVal('post-password', meta.password);
      setVal('post-password-hint', meta.passwordHint);
      setChecked('chk-pinned', meta.pinned);
      setChecked('chk-comment', meta.comment !== false);
      setChecked('chk-draft', meta.draft === 'true' || meta.draft === true);
      if (window.__editorMetaCheckbox) {
        window.__editorMetaCheckbox.pinned = !!meta.pinned;
        window.__editorMetaCheckbox.comment = meta.comment !== false;
        window.__editorMetaCheckbox.draft = meta.draft === 'true' || meta.draft === true;
      }
      var mdInput = document.getElementById('markdown-input');
      if (mdInput) mdInput.value = body;
      window.__editorCoverDataUrl = '';
      window.__editorCoverFilename = '';
      if (cloudCover) {
        window.__editorCoverValue = cloudCover;
        var extractedFilename = cloudCover.split('/').pop();
        if (extractedFilename) window.__editorCoverFilename = extractedFilename;
      }
      // 封面图统一处理：mdDir 取该草稿在仓库中的目录（如 src/content/posts），
      // 相对路径会据此拼出 raw 地址用于预览；写入 frontmatter 的仍是原始相对路径
      var cloudMdDir = path.replace(/\/[^/]*$/, '') || 'src/content/posts';
      window.__editorCoverMdDir = cloudMdDir;
      applyCover(cloudCover, { mdDir: cloudMdDir });
      var titleInput = document.getElementById('post-title-input');
      if (titleInput) titleInput.value = meta.title || '';
      // 预览立即刷新（强制版，绕过防抖）
      if (typeof window.__editorForcePreview === 'function') window.__editorForcePreview();
      if (mdInput) mdInput.dispatchEvent(new Event('input'));
      closePanel();
      window.__editorShowToast('已载入云端草稿：' + (meta.title || path));
    }).catch(function(err) {
      var fe2 = friendlyGhError(err && err.message);
      window.__editorShowToast('载入云端草稿失败：' + fe2.title);
    });
  }

  // 删除云端草稿原文件
  // 返回 Promise<boolean>；opts.silent=true 时静默删除（不逐条 toast / 不逐条重渲染），
  // 供批量删除在全部完成后统一提示与刷新。单条删除调用（默认）行为不变：toast + renderCloudList。
  function deleteCloudDraft(path, opts) {
    opts = opts || {};
    // 确认已由调用方（事件委托）通过 __editorConfirm 弹窗完成，此处不再重复确认
    // （原实现在此处还有一次 confirm，导致点一次「删除」会连弹两次确认框）
    var cfg = getCloudGithubConfig();
    if (!cfg.token) {
      if (!opts.silent) window.__editorShowToast(getCloudI18n('cloudDraftNeedToken', '请先填写 GitHub Token'));
      return Promise.resolve(false);
    }
    var apiUrl = 'https://api.github.com/repos/' + cfg.repo + '/contents/' + path + '?ref=' + cfg.branch;
    return fetch(apiUrl, {
      headers: { 'Authorization': 'token ' + cfg.token, 'Accept': 'application/vnd.github.v3+json' }
    }).then(function(r) {
      if (!r.ok) return r.json().then(function(e) { throw new Error(e.message || ('HTTP ' + r.status)); });
      return r.json();
    }).then(function(data) {
      return fetch(apiUrl, {
        method: 'DELETE',
        headers: { 'Authorization': 'token ' + cfg.token, 'Accept': 'application/vnd.github.v3+json', 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: 'delete cloud draft: ' + path, branch: cfg.branch, sha: data.sha })
      }).then(function(r2) {
        if (!r2.ok) return r2.json().then(function(e2) { throw new Error(e2.message || ('HTTP ' + r2.status)); });
        return r2.json();
      });
    }).then(function() {
      // 清缓存里该项
      try {
        var cache = JSON.parse(localStorage.getItem(CLOUD_DRAFTS_CACHE_KEY) || 'null');
        if (cache && cache.list) {
          cache.list = cache.list.filter(function(d) { return d.path !== path; });
          localStorage.setItem(CLOUD_DRAFTS_CACHE_KEY, JSON.stringify(cache));
        }
      } catch (e) {}
      if (!opts.silent) {
        window.__editorShowToast('✅ 已删除云端草稿');
        renderCloudList();
      }
      return true;
    }).catch(function(err) {
      var fe3 = friendlyGhError(err && err.message);
      if (!opts.silent) window.__editorShowToast('❌ 删除失败：' + fe3.title);
      return false;
    });
  }


  // checkbox 切换样式 + 初始化
