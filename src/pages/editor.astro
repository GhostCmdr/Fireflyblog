        var cloudCheckedCount = panelContent.querySelectorAll('#draft-cloud-list .draft-checkbox:checked').length;
        var cloudToolbar = document.getElementById('draft-toolbar-cloud');
        var cloudListEl = document.getElementById('draft-cloud-list');
