---
// [OURS] 动态就地编辑器（/dynamic/ 页面）
//
// 用途：配置过 GitHub Token 的浏览器里，动态页工具行右侧会出现「管理」按钮；
//      点开弹窗即可直接新建 / 编辑 / 删除动态。每条动态 = src/content/dynamic/ 下的一个 md 文件，
//      保存时由浏览器用 GitHub Contents API 直接对该文件做 PUT / DELETE。
//
// 设计约定（与 AGENTS.md 的 Repository-Specific Conventions 一致）：
//   - 目录与文件名严格沿用上游 scripts/new-dynamic.js：src/content/dynamic/YYYY-MM-DD-HHmmss.md
//     （文件名用站点时区计算，且是 id / 锚点 / 固定链接的来源，编辑时不得改变）
//   - frontmatter 模板逐字对齐脚本：`---\npublished: YYYY-MM-DD HH:mm:ss\n---\n\n正文\n`
//     （无引号、空格分隔、无时区后缀；pinned / location 仅在非默认时追加）
//   - 图片沿用本站既有习惯：正文里贴图片外链，编辑器不介入图片文件
//   - 正文为纯 Markdown 文本框（动态通常只有一段话，不做工具栏）
//   - 结构与交互照搬 src/components/features/FriendsEditor.astro（id 前缀 fe- → de-）
//   - 无前端框架、无新依赖，缩进 tab、字符串双引号
type DynamicSeed = {
	/** 文件名（同时是 id）：YYYY-MM-DD-HHmmss.md */
	file: string;
	/** YYYY-MM-DD HH:mm:ss（站点时区） */
	published: string;
	pinned: boolean;
	location: string;
	body: string;
};

interface Props {
	/** 站点时区（IANA），用于生成文件名与 published 时间戳 */
	timezone?: string;
	/** 服务端首屏快照（由 src/pages/dynamic/index.astro 传入），让弹窗打开即为终态 */
	items?: DynamicSeed[];
}

const { timezone = "Asia/Shanghai", items = [] } = Astro.props;
const initialJson = JSON.stringify(items);
---

<div id="de-root" class="flex shrink-0 items-center" data-timezone={timezone} data-items={initialJson}>
	<!-- 管理入口：默认隐藏，脚本判定通过后才显示（无 Token 的访客完全看不到） -->
	<button
		id="de-open"
		type="button"
		class="hidden shrink-0 cursor-pointer items-center gap-1.5 rounded-lg bg-(--primary) px-3 py-1.5 text-sm font-medium text-white transition-all hover:opacity-90 active:scale-95 focus-visible:ring-2 focus-visible:ring-(--primary)/40 focus-visible:outline-none dark:text-black/80"
		aria-label="管理动态"
	>
		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 24 24"
			width="16"
			height="16"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
			><path d="M12 20h9"></path><path
				d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4 12.5-12.5z"></path></svg
		>
		<span class="hidden sm:inline">管理</span>
	</button>

	<!-- 弹窗 -->
	<div
		id="de-mask"
		class="fixed inset-0 z-[999] hidden items-center justify-center p-4 backdrop-blur-sm sm:p-6"
		style="background: rgba(0, 0, 0, 0.45); overscroll-behavior: contain;"
		role="dialog"
		aria-modal="true"
		aria-label="管理动态"
	>
		<div
			id="de-panel"
			class="card-base relative flex max-h-[92vh] w-full max-w-[720px] flex-col shadow-2xl sm:max-h-[85vh]"
		>
			<!-- 头部（固定） -->
			<div
				class="flex shrink-0 items-start justify-between gap-3 border-b border-(--line-divider) px-5 py-4"
			>
				<div class="min-w-0">
					<div class="text-lg font-bold text-neutral-900 dark:text-neutral-100">
						管理动态
					</div>
					<div id="de-subtitle" class="mt-0.5 text-xs text-neutral-500 dark:text-neutral-400">
						置顶优先、时间倒序（与页面显示顺序一致）
					</div>
				</div>
				<button
					id="de-close"
					type="button"
					class="shrink-0 rounded-lg p-1.5 text-neutral-400 transition-colors hover:bg-neutral-100 hover:text-neutral-700 dark:hover:bg-neutral-700 dark:hover:text-neutral-200"
					aria-label="关闭"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						width="20"
						height="20"
						fill="currentColor"
						aria-hidden="true"
						><path
							d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
						></path></svg
					>
				</button>
			</div>

			<!-- 状态提示条（浮层，不占文档流 ⇒ 出现/消失不会把内容推下再弹回）：
			     位置＝头部正下方（即它原本的视觉位置），会盖住内容第一行上沿，这是"不占位"的代价。
			     top 的 4.875rem 等于头部实测高度，头部改版需同步此值。 -->
			<div
				id="de-msg"
				class="absolute inset-x-0 top-[4.875rem] z-10 hidden px-5 py-2.5 pr-11 text-sm"
				role="status"
				aria-live="polite"
			>
				<span id="de-msg-text"></span>
				<button
					id="de-msg-close"
					type="button"
					class="absolute top-1/2 right-2.5 -translate-y-1/2 rounded p-1 text-lg opacity-70 transition-opacity hover:opacity-100"
					aria-label="关闭提示"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						width="1em"
						height="1em"
						fill="currentColor"
						aria-hidden="true"
						><path
							d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
						></path></svg
					>
				</button>
			</div>

			<!-- 内容（独立滚动）：列表 + 可移动的内联编辑块（#de-editor 会被搬进正在编辑的那张卡片） -->
			<div
				id="de-body"
				class="de-scroll flex h-[380px] grow flex-col overflow-y-auto px-5 py-4"
				style="overscroll-behavior: contain;"
			>
				<!-- 动态列表（每张卡片由脚本渲染，编辑控件直接渲染在各卡片内部） -->
				<div id="de-list" class="flex flex-col gap-2.5"></div>
				<div
					id="de-empty"
					class="hidden grow flex-col items-center justify-center text-center text-sm text-neutral-400 dark:text-neutral-500"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						width="36"
						height="36"
						fill="currentColor"
						aria-hidden="true"
						class="mb-2 opacity-60"
						><path
							d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
						></path></svg
					>
					还没有发布过动态，点下方「+ 添加动态」写下第一条。
				</div>
				</div>

			<!-- 底部操作条（固定）：发布新动态 / 关闭（每条动态的「提交」在卡片自身右上角） -->
			<div
				id="de-foot-list"
				class="flex shrink-0 flex-col gap-2 border-t border-(--line-divider) px-5 py-3.5 sm:flex-row sm:items-center sm:justify-between"
			>
				<button
					id="de-add"
					type="button"
					class="rounded-xl border border-dashed border-(--line-divider) px-3.5 py-2 text-sm font-medium text-neutral-600 transition-colors hover:border-(--primary)/50 hover:bg-(--primary)/5 hover:text-(--primary) dark:text-neutral-300"
				>
					+ 添加动态
				</button>
				<button
					id="de-cancel"
					type="button"
					class="rounded-xl border border-(--line-divider) px-4 py-2 text-sm font-medium text-neutral-600 transition-colors hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-700"
				>
					关闭
				</button>
			</div>
		</div>
	</div>

	<!-- [OURS] 站内风格确认框：替代原生 window.confirm（否则会弹出「localhost:4321 显示」这种浏览器弹窗） -->
	<div
		id="de-confirm"
		class="fixed inset-0 z-[1000] hidden items-center justify-center p-4"
		style="overscroll-behavior: contain;"
		role="alertdialog"
		aria-modal="true"
		aria-labelledby="de-confirm-title"
	>
		<div
			id="de-confirm-panel"
			class="card-base w-full max-w-[380px] border border-(--line-divider) shadow-2xl backdrop-blur-sm"
		>
			<div class="px-5 pt-5 pb-4">
				<div class="flex items-start gap-3">
					<span id="de-confirm-icon" class="shrink-0" style="color: #DC2626;">
						<svg
							data-kind="danger"
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							width="24"
							height="24"
							fill="currentColor"
							aria-hidden="true"
							><path
								d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
							></path></svg
						>
						<svg
							data-kind="warning"
							class="hidden"
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							width="24"
							height="24"
							fill="currentColor"
							aria-hidden="true"
							><path d="M12 2 1 21h22L12 2zm1 14h-2v2h2v-2zm0-7h-2v5h2V9z"></path></svg
						>
						<svg
							data-kind="info"
							class="hidden"
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							width="24"
							height="24"
							fill="currentColor"
							aria-hidden="true"
							><path
								d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"
							></path></svg
						>
					</span>
					<div class="min-w-0 flex-1">
						<div
							id="de-confirm-title"
							class="text-[1.0625rem] leading-6 font-bold text-neutral-900 dark:text-neutral-100"
						>
							请确认
						</div>
						<div
							id="de-confirm-text"
							class="mt-1.5 text-sm leading-6 break-words text-neutral-600 dark:text-neutral-400"
						>
						</div>
					</div>
				</div>
			</div>
			<div class="flex items-center justify-end gap-2 px-5 py-3.5">
				<button
					id="de-confirm-cancel"
					type="button"
					class="rounded-lg border border-(--line-divider) px-4 py-2 text-sm font-medium text-neutral-600 transition-colors hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-700"
				>
					取消
				</button>
				<button
					id="de-confirm-ok"
					type="button"
					class="rounded-lg px-4 py-2 text-sm font-semibold text-white shadow-sm transition-all duration-200 hover:brightness-110"
				>
					确定
				</button>
			</div>
		</div>
	</div>
</div>

<!-- ⚠️ 必须用 is:global：卡片内容是脚本用 innerHTML 动态生成的，而 Astro 的 scoped style
     会往每个选择器上附加作用域属性 —— 对 JS 生成的内容永远不命中，且不报错（静默失效）。
     项目里已踩过同一个坑（editor.astro 的预览内容样式也必须放在全局块）。 -->
<style is:global>
	/* 弹窗内滚动条：保留"细 + 圆角"的形状，颜色用接近系统默认的灰（不跟随主色）。 */
	.de-scroll {
		scrollbar-width: thin;
		scrollbar-color: rgba(0, 0, 0, 0.3) transparent;
	}
	.dark .de-scroll {
		scrollbar-color: rgba(255, 255, 255, 0.28) transparent;
	}
	.de-scroll::-webkit-scrollbar {
		width: 8px;
		height: 8px;
	}
	.de-scroll::-webkit-scrollbar-track {
		background: transparent;
	}
	.de-scroll::-webkit-scrollbar-thumb {
		background: rgba(0, 0, 0, 0.3);
		background-clip: content-box;
		border: 2px solid transparent;
		border-radius: 999px;
	}
	.de-scroll::-webkit-scrollbar-thumb:hover {
		background: rgba(0, 0, 0, 0.45);
		background-clip: content-box;
	}
	.dark .de-scroll::-webkit-scrollbar-thumb {
		background: rgba(255, 255, 255, 0.28);
		background-clip: content-box;
	}
	.dark .de-scroll::-webkit-scrollbar-thumb:hover {
		background: rgba(255, 255, 255, 0.42);
		background-clip: content-box;
	}

	/* 列表容器始终预留滚动条槽位：避免"内容没撑满 → 撑出滚动条"导致宽度瞬变
	   （只作用于本容器，不影响页面根滚动条与 vw）。 */
	#de-body {
		scrollbar-gutter: stable;
	}

	/* 弹窗内所有按钮都用手型光标（<button> 浏览器默认不给 pointer）；
	   卡片内的按钮由脚本生成 ⇒ 这条规则必须放在全局块才命中。 */
	#de-open,
	#de-root > button,
	#de-panel button,
	#de-confirm-panel button {
		cursor: pointer;
	}

	/* ── 卡片的「只读 / 可编辑」两态 ──
	   卡片结构完全一致（左右各一半），不编辑时把控件做成"纯文本样子"：
	   去掉边框与底色、禁止交互，布局与尺寸都不发生变化 ⇒ 点「编辑」只是让文字变得可改。 */
	/* 只读态：去掉边框做成"文本样子"，但仍给极淡底色 —— 避免大片空白显得"太空"；
	   不加 pointer-events:none，这样只读时也能选中/复制正文（只读由 readOnly 保证）。 */
	.de-item:not([data-editing="1"]) [data-f] {
		border-color: transparent !important;
		box-shadow: none !important;
		background: rgba(0, 0, 0, 0.03);
	}
	.dark .de-item:not([data-editing="1"]) [data-f] {
		background: rgba(255, 255, 255, 0.04);
	}
	.de-item:not([data-editing="1"]) .de-editor-only {
		display: none;
	}
	.de-item[data-editing="1"] .de-readonly-only {
		display: none;
	}
	/* 编辑中的卡片给一点视觉强调，便于一眼看出在改哪一条 */
	.de-item[data-editing="1"] {
		border-color: color-mix(in srgb, var(--primary) 45%, transparent);
	}

	/* ── 卡片内正文框的滚动行为 ──
	   ① 只读态**隐藏滚动条**：多条动态时不会每张卡片都挂着一条滚动条（视觉干净）；
	      滚动能力仍然保留（内容超出照样能滚，只是不显示条）。
	   ② 两个状态都加 overscroll-behavior: contain ⇒ 阻断"滚动链"：
	      在卡片内滚到底不会带着弹窗内容区一起滚。 */
	.de-item textarea[data-f] {
		overscroll-behavior: contain;
	}
	.de-item:not([data-editing="1"]) textarea[data-f] {
		scrollbar-width: none;
	}
	.de-item:not([data-editing="1"]) textarea[data-f]::-webkit-scrollbar {
		display: none;
	}

	/* ── 确认框内的按钮不显示键盘焦点环 ──
	   askConfirm() 打开时会把焦点程序化给「取消」按钮；若这次唤出由键盘触发（如按 Esc），
	   全站焦点基线（main.css 的 :focus-visible ⇒ outline: 2px solid var(--primary)）就会在
	   按钮外画出一圈橙框 —— 看起来像"按钮被框选"。确认框是一次性决策、按钮固定两个，这里抑制掉。
	   纯 CSS、零运行时开销；与 editor.astro 的「焦点黑边统一方案」同源同解法。 */
	#de-confirm button:focus,
	#de-confirm button:focus-visible {
		outline: none;
	}
</style>

<script is:inline>
	(function () {
		"use strict";

		// 【swup 重入】本站点 @swup/scripts-plugin 会在 content:replace 时**重新执行全文档内联脚本**，
		// 因此本组件每次切回动态页都会重放。重放前先执行上一次登记的清理 —— 移除上一轮的 keydown
		// 监听与 body 上那份旧弹窗，避免监听器与 DOM 累积（重复绑定会让「保存」被触发多次）。
		try {
			if (typeof window.__deCleanup === "function") window.__deCleanup();
		} catch (e) {
			/* 清理失败不得阻断本次初始化 */
		}

		var root = document.getElementById("de-root");
		if (!root) return;

		var btnOpen = document.getElementById("de-open");
		var mask = document.getElementById("de-mask");
		var panel = document.getElementById("de-panel");
		var listEl = document.getElementById("de-list");
		var emptyEl = document.getElementById("de-empty");
		var msgEl = document.getElementById("de-msg");
		var subtitleEl = document.getElementById("de-subtitle");
		var msgCloseBtn = document.getElementById("de-msg-close");
		var msgTextEl = document.getElementById("de-msg-text");
		var btnAdd = document.getElementById("de-add");
		var btnCancel = document.getElementById("de-cancel");
		var btnClose = document.getElementById("de-close");

		// 动态所在目录（与 scripts/new-dynamic.js 完全一致，不得改变）
		var DIR_PATH = "src/content/dynamic";
		var DEFAULT_REPO = "GhostCmdr/Fireflyblog";
		var TZ = root.getAttribute("data-timezone") || "Asia/Shanghai";

		// editing: null = 全部只读；"" = 新建；否则为被编辑条目的文件名（编辑时文件名不变）
		var state = {
			items: [],
			saved: null,
			dirty: false,
			busy: false,
			editing: null,
			loaded: false,
		};

		/* ───────────── 小工具 ───────────── */

		function cfg() {
			var ls = window.localStorage;
			return {
				token: ls.getItem("gh-token") || ls.getItem("gh-editor-token") || "",
				repo: ls.getItem("gh-repo") || ls.getItem("gh-editor-repo") || DEFAULT_REPO,
				branch: ls.getItem("gh-branch") || "main",
			};
		}

		function escHtml(s) {
			return String(s == null ? "" : s)
				.replace(/&/g, "&amp;")
				.replace(/</g, "&lt;")
				.replace(/>/g, "&gt;")
				.replace(/"/g, "&quot;")
				.replace(/'/g, "&#39;");
		}

		function pad2(n) {
			return (n < 10 ? "0" : "") + n;
		}

		// 幂等绑定：本站点 @swup/scripts-plugin 会在切页时**重新执行全文档内联脚本**，同一元素会被
		// 多个闭包反复 addEventListener。副作用：切换类操作（「编辑」展开/收起）会被"开 + 关"
		// 互相抵消（表现为点一次没反应、点两次才对）；提交 / 删除类则会被重复触发。
		// 标记写在元素上 ⇒ 跨闭包可见 ⇒ 每个「元素 + 事件」只绑一次；元素换新时会自动重新绑定。
		function bindOnce(el, type, fn) {
			if (!el || !el.addEventListener) return;
			var flag = "__deBound_" + type;
			if (el[flag]) return;
			el[flag] = true;
			el.addEventListener(type, fn);
		}

		function showMsg(text, kind) {
			// 底色沿用占位版的原始半透明语义色：靠与背后面板底色叠加呈现淡彩。
			var palette = {
				info: "background: rgba(59,130,246,0.10); color: #2563EB;",
				success: "background: rgba(22,163,74,0.12); color: #15803D;",
				warn: "background: rgba(217,119,6,0.12); color: #B45309;",
				error: "background: rgba(220,38,38,0.12); color: #B91C1C;",
			};
			msgEl.style.cssText = palette[kind] || palette.info;
			// 注意：必须写进 #de-msg-text 而不是 #de-msg —— 对父元素赋 textContent 会清空所有子节点，
			// 把里面的关闭按钮一起抹掉。
			if (msgTextEl) msgTextEl.textContent = text;
			else msgEl.textContent = text;
			msgEl.classList.remove("hidden");
		}

		function hideMsg() {
			msgEl.classList.add("hidden");
		}

		function setBusy(on, label) {
