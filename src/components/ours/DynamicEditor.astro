					'<span class="truncate text-neutral-400">提交后按发布时间生成文件名</span>';
			} else if (it.readError) {
				headLeft =
					'<span class="font-medium text-red-500">读取失败</span>' +
					'<span class="truncate text-neutral-400">' +
