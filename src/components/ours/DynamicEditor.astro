						'<span class="rounded-md bg-(--primary)/12 px-1.5 py-0.5 font-medium text-(--primary)">置顶</span>';
				if (it.location)
					flags +=
						'<span class="rounded-md bg-neutral-500/12 px-1.5 py-0.5 text-neutral-500 dark:text-neutral-400">' +
						escHtml(it.location) +
						"</span>";
