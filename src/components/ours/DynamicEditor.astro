						escape(atob(String(data.content || "").replace(/\n/g, ""))),
					);
					var parsed = parseDynamic(text);
					return normalizeItem({
						file: entry.file,
						sha: data.sha || entry.sha,
						published: parsed.published,
						pinned: parsed.pinned,
						location: parsed.location,
						body: parsed.body,
						extra: parsed.extra,
						readError: false,
					});
				})
				.catch(function () {
					return normalizeItem({
						file: entry.file,
						sha: entry.sha,
						readError: true,
					});
