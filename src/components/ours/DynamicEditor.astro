		}

		function handleWrite(res, label) {
			if (res.status === 401) throw new Error("Token 无效或已过期，请到编辑器页更新后再试。");
			if (res.status === 403)
				throw new Error("Token 权限不足（需要该仓库的 Contents 读写权限）。");
			if (res.status === 409 || res.status === 422)
				throw new Error("文件已在别处被改动，请点「重新读取」后再提交。");
			if (!res.ok) {
				return res.json().then(
					function (err) {
						throw new Error(label + "失败：" + (err.message || "HTTP " + res.status));
					},
					function () {
						throw new Error(label + "失败（HTTP " + res.status + "）");
					},
				);
			}
			return res.json();
		}

		// 列出目录下的全部 .md（含 sha）。目录不存在（Git 不跟踪空目录）返回 404 ⇒ 视为空列表。
		function listRemote() {
			var c = cfg();
			if (!c.token)
				return Promise.reject(new Error("未检测到 GitHub Token，请先在编辑器页面配置。"));
			return fetch(
				contentsUrl(c.repo, DIR_PATH) +
					"?ref=" +
					encodeURIComponent(c.branch) +
					"&t=" +
					Date.now(),
				{ headers: apiHeaders(c.token), cache: "no-store" },
			).then(function (res) {
				if (res.status === 404) return [];
				if (!res.ok) return handleWrite(res, "读取目录");
				return res.json().then(function (data) {
					return (Array.isArray(data) ? data : [])
						.filter(function (f) {
							return f && f.type === "file" && /\.md$/i.test(f.name || "");
						})
						.map(function (f) {
							return { file: f.name, sha: f.sha };
						});
				});
			});
		}

		// 读取单条：base64 → 原文 → 解析。单项失败不阻断整体（标记 readError，列表里显示为不可编辑行）。
		function readOne(entry) {
			var c = cfg();
			return fetch(
				contentsUrl(c.repo, DIR_PATH + "/" + entry.file) +
					"?ref=" +
					encodeURIComponent(c.branch) +
					"&t=" +
					Date.now(),
				{ headers: apiHeaders(c.token), cache: "no-store" },
			)
				.then(function (res) {
					if (!res.ok) throw new Error("HTTP " + res.status);
					return res.json();
				})
				.then(function (data) {
