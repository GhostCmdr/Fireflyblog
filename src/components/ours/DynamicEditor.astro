		}

		/* ───────────── 生成动态 md 文本 ─────────────
		   模板与 scripts/new-dynamic.js 逐字对齐：
		   ---\npublished: YYYY-MM-DD HH:mm:ss\n[pinned: true\n][location: 值\n]---\n\n正文\n */

		function buildDynamic(item) {
			var head = "---\n" + "published: " + item.published + "\n";
			if (item.pinned) head += "pinned: true\n";
			if (item.location) head += "location: " + yamlScalar(item.location) + "\n";
			var extra = item.extra || [];
			for (var i = 0; i < extra.length; i++) head += extra[i] + "\n";
			head += "---\n\n";
			var body = String(item.body == null ? "" : item.body).replace(/\s+$/, "");
			return head + body + "\n";
		}

		function commitMessage(kind, stamp) {
			var t = String(stamp || "").slice(0, 16);
			if (kind === "create") return "feat(dynamic): 网站端发布动态（" + t + "）";
			if (kind === "update") return "feat(dynamic): 网站端更新动态（" + t + "）";
			return "chore(dynamic): 网站端删除动态（" + t + "）";
		}

		function normalizeItem(raw) {
			return {
				file: String(raw.file == null ? "" : raw.file),
				sha: String(raw.sha == null ? "" : raw.sha),
				published: String(raw.published == null ? "" : raw.published),
				pinned: !!raw.pinned,
				location: String(raw.location == null ? "" : raw.location),
				body: String(raw.body == null ? "" : raw.body),
				extra: Array.isArray(raw.extra) ? raw.extra.slice() : [],
				readError: !!raw.readError,
			};
		}

		// 排序与 src/utils/dynamic-utils.ts 的 sortDynamics 一致：置顶优先，再按发布时间降序
		// （published 是固定宽度的 "YYYY-MM-DD HH:mm:ss"，字典序即时间序）
		function sortItems(arr) {
			return arr.slice().sort(function (a, b) {
				if (a.pinned && !b.pinned) return -1;
				if (!a.pinned && b.pinned) return 1;
				return String(b.published).localeCompare(String(a.published));
			});
		}

		// 比较文本前先做尾部空白规范化：
		// 服务端 entry.body 已去掉尾换行，而 parseDynamic 读回的是原文（一般带尾换行）；
		// published / location 也可能有引号或空白差异。不规范化会把"内容其实一样"误判成变了，
		// 于是白重绘一次 —— 正是用户看到的"打开后过一会儿内容才刷出来"。
		function sameText(a, b) {
			return (
				String(a == null ? "" : a).replace(/\s+$/, "") ===
				String(b == null ? "" : b).replace(/\s+$/, "")
			);
		}

		// 只比较"列表上会显示出来的内容"，**不比 sha**：
		// 服务端首屏快照没有 sha，而 sha 变化并不代表内容变化 ⇒ 否则必然判定为"变了"、白重绘一次。
		function sameData(a, b) {
			if (a.length !== b.length) return false;
			for (var i = 0; i < a.length; i++) {
				if (a[i].file !== b[i].file) return false;
				if (!sameText(a[i].published, b[i].published)) return false;
				if (!!a[i].pinned !== !!b[i].pinned) return false;
				if (!sameText(a[i].location, b[i].location)) return false;
				if (!sameText(a[i].body, b[i].body)) return false;
			}
			return true;
		}

		function summarize(body) {
			var s = String(body || "")
				.replace(/!\[[^\]]*\]\([^)]*\)/g, " ")
				.replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
				.replace(/[#>*_`~]/g, "")
				.replace(/\s+/g, " ")
				.trim();
