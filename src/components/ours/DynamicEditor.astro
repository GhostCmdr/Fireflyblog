				INPUT_CLS +
				" />" +
				"</label>" +
				'<label class="flex items-center gap-2">' +
				'<span class="relative inline-flex h-5 w-9 shrink-0 items-center">' +
				'<input data-f="pinned" type="checkbox" class="peer sr-only" ' +
				(it.pinned ? "checked" : "") +
				" />" +
				'<span class="absolute inset-0 rounded-full bg-neutral-300 transition-colors peer-checked:bg-(--primary) dark:bg-neutral-600"></span>' +
				'<span class="absolute left-0.5 h-4 w-4 rounded-full bg-white shadow transition-transform peer-checked:translate-x-4"></span>' +
				"</span>" +
				'<span class="text-[11px] font-medium text-neutral-500 dark:text-neutral-400">置顶</span>' +
				"</label>" +
				"</div>" +
				'<label class="flex flex-col gap-1">' +
				'<span class="text-[11px] font-medium text-neutral-500 dark:text-neutral-400">正文</span>' +
				'<textarea data-f="body" rows="4" placeholder="今天在研究什么？记一笔。" ' +
