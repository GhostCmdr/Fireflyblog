				'<div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">' +
				'<div class="flex flex-col gap-2.5">' +
				'<label class="flex flex-col gap-1">' +
				'<span class="text-[11px] font-medium text-neutral-500 dark:text-neutral-400">发布时间</span>' +
				'<input data-f="published" type="datetime-local" value="' +
				escHtml(publishedVal) +
				'" ' +
				INPUT_CLS +
				" />" +
				"</label>" +
				'<label class="flex flex-col gap-1">' +
				'<span class="text-[11px] font-medium text-neutral-500 dark:text-neutral-400">位置（可选）</span>' +
				'<input data-f="location" type="text" value="' +
				escHtml(it.location || "") +
