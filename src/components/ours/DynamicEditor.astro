		// 并发受限地读取全部条目（上限 6，避免一次打开弹窗打爆 API 配额）
		function readAll(entries) {
			var out = [];
			var idx = 0;
			var limit = 6;
			function worker() {
				if (idx >= entries.length) return Promise.resolve();
				var cur = entries[idx++];
				return readOne(cur).then(function (item) {
					out.push(item);
					return worker();
				});
			}
			var workers = [];
			for (var i = 0; i < Math.min(limit, entries.length); i++) workers.push(worker());
			return Promise.all(workers).then(function () {
				return out;
			});
		}

		function putFile(fileName, text, sha, message) {
			var c = cfg();
			var body = {
				message: message,
				content: btoa(unescape(encodeURIComponent(text))),
				branch: c.branch,
			};
			if (sha) body.sha = sha;
			return fetch(contentsUrl(c.repo, DIR_PATH + "/" + fileName), {
				method: "PUT",
				headers: Object.assign(apiHeaders(c.token), { "Content-Type": "application/json" }),
				body: JSON.stringify(body),
			}).then(function (res) {
				return handleWrite(res, "提交");
			});
		}

		function deleteFile(fileName, sha, message) {
			var c = cfg();
			return fetch(contentsUrl(c.repo, DIR_PATH + "/" + fileName), {
				method: "DELETE",
				headers: Object.assign(apiHeaders(c.token), { "Content-Type": "application/json" }),
				body: JSON.stringify({ message: message, sha: sha, branch: c.branch }),
			}).then(function (res) {
				if (res.status === 404)
					throw new Error("文件已不存在（可能已在别处被删除），请点「重新读取」。");
				if (res.status === 409 || res.status === 422)
					throw new Error("文件已在别处被改动，请点「重新读取」后再删除。");
				return handleWrite(res, "删除");
			});
		}

		/* ───────────── 渲染 ───────────── */

		var BTN_RO_EDIT =
			'<button type="button" data-act="edit" class="de-readonly-only rounded-lg border border-(--line-divider) px-2.5 py-1 text-xs font-medium text-neutral-600 transition-colors hover:border-(--primary)/50 hover:text-(--primary) dark:text-neutral-300">编辑</button>';
		var BTN_ED_CANCEL =
			'<button type="button" data-act="cancel" class="de-editor-only rounded-lg border border-(--line-divider) px-2.5 py-1 text-xs font-medium text-neutral-600 transition-colors hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-700">取消</button>';
		var BTN_ED_SAVE =
			'<button type="button" data-act="save" class="de-editor-only rounded-lg bg-(--primary) px-2.5 py-1 text-xs font-semibold text-white shadow-sm transition-all hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-60">提交</button>';
		var BTN_DEL =
			'<button type="button" data-act="del" title="删除" aria-label="删除" class="rounded-lg border border-red-500/40 px-2 py-1 text-red-500 transition-colors hover:bg-red-500/10"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M9 3v1H4v2h16V4h-5V3H9zM6 8v12a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V8H6zm3 2h2v9H9v-9zm4 0h2v9h-2v-9z"></path></svg></button>';

		var INPUT_CLS =
			'class="w-full rounded-lg border border-(--line-divider) bg-transparent px-2.5 py-1.5 text-sm text-neutral-900 outline-none transition-all focus:border-(--primary) focus:ring-1 focus:ring-(--primary)/40 dark:text-neutral-100"';
		var TEXTAREA_CLS =
			'class="de-scroll w-full resize-none rounded-lg border border-(--line-divider) bg-transparent px-3 py-2 text-sm leading-6 text-neutral-900 outline-none transition-all focus:border-(--primary) focus:ring-1 focus:ring-(--primary)/40 dark:text-neutral-100"';

		// 卡片内容：左右各一半 —— 左＝基本设置（时间 / 位置 / 置顶 / 文件名），右＝正文。
