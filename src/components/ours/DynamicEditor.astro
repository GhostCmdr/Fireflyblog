				? BTN_DEL
				: BTN_RO_EDIT + BTN_ED_CANCEL + BTN_ED_SAVE + BTN_DEL;
			// 文件名提示：只在"编辑已有条目"时出现（新建卡头部已写明"提交后生成文件名"），
			// 跟在头部标记（置顶 / 位置）之后、左对齐；灰色小字、超长省略。
			var hint =
				!isNew && !it.readError
					? '<span data-hint class="de-editor-only max-w-[13rem] truncate text-[11px] text-neutral-400">' +
						escHtml(it.file) +
						"</span>"
					: "";
			return (
				'<div class="de-item card-base rounded-xl border border-(--line-divider) p-3"' +
				(isNew ? ' data-new="1"' : ' data-file="' + escHtml(it.file) + '"') +
				">" +
				'<div class="flex items-start gap-3">' +
				'<div class="min-w-0 grow">' +
				'<div class="flex flex-wrap items-center gap-1.5 text-[11px]">' +
				headLeft +
				hint +
				"</div>" +
				"</div>" +
				'<div class="flex shrink-0 items-center gap-1.5">' +
				buttons +
				"</div>" +
				"</div>" +
				(it.readError ? "" : cardBodyHtml(it, isNew)) +
				"</div>"
			);
		}

		function render() {
			listEl.innerHTML = state.items.map(itemHtml).join("");
			// 新建态：顶部插一张草稿卡（不进 state.items，提交成功后才成为真实条目）
			if (state.editing === "") {
				listEl.insertAdjacentHTML(
					"afterbegin",
					itemHtml({
						file: "",
						published: stampOf(new Date()),
						pinned: false,
						location: "",
						body: "",
						isNew: true,
					}),
				);
			}
			applyEditable();
			setSubtitle();
		}

		// state.editing 语义：null = 没有展开编辑块；"" = 正在新建；其它 = 正在编辑该文件名
		function setSubtitle() {
			if (state.editing !== null) {
				subtitleEl.textContent = state.editing
					? "正在编辑 · " + state.editing + "（文件名不变）"
					: "新建动态 · 文件名与时间按站点时区自动生成";
			} else {
				subtitleEl.textContent =
					"共 " + state.items.length + " 条 · 置顶优先、时间倒序（与页面显示顺序一致）";
			}
			var isEmpty =
				state.editing === null && state.loaded && !state.items.length;
			emptyEl.classList.toggle("hidden", !isEmpty);
			emptyEl.classList.toggle("flex", isEmpty);
		}

		/* ───────────── 卡片数据（替代原"表单"概念） ───────────── */

		function findItem(file) {
			for (var i = 0; i < state.items.length; i++) {
				if (state.items[i].file === file) return state.items[i];
			}
			return null;
		}

		/* ───────────── 就地编辑：只切换卡片的「只读 / 可编辑」，不搬 DOM、不重绘 ───────────── */

		// 用于选择器的转义（文件名只含数字 / 字母 / - / .，这里只兜底引号与反斜杠）
		function cssEscape(s) {
			return String(s == null ? "" : s).replace(/["\\]/g, "\\$&");
		}

		function findCard(key) {
			if (key === "") return listEl.querySelector('.de-item[data-new="1"]');
			return listEl.querySelector('.de-item[data-file="' + cssEscape(key) + '"]');
		}

		// 把"哪一条可编辑"应用到 DOM：只改属性与类 ⇒ 不重排、不重建，布局和尺寸零变化
		function applyEditable() {
			var cards = listEl.querySelectorAll(".de-item");
			for (var i = 0; i < cards.length; i++) {
				var card = cards[i];
				var key =
					card.getAttribute("data-new") === "1" ? "" : card.getAttribute("data-file") || "";
				var on = state.editing !== null && key === state.editing;
				if (on) card.setAttribute("data-editing", "1");
				else card.removeAttribute("data-editing");
				var fields = card.querySelectorAll("[data-f]");
				for (var j = 0; j < fields.length; j++) {
					var el = fields[j];
					if (el.tagName === "INPUT" && el.type === "checkbox") el.disabled = !on;
					else el.readOnly = !on;
				}
			}
		}

		// key：null = 全部只读；"" = 新建；其它 = 正在编辑该文件名
		function setEditing(key) {
			state.editing = key;
			state.dirty = false;
			var it = key ? findItem(key) : null;
			state.secBase =
				key && it ? String(it.published || "").slice(17, 19) : pad2(new Date().getSeconds());
			applyEditable();
			setSubtitle();
			hideMsg();
			if (key === null) return;
			var card = findCard(key);
			var body = card ? card.querySelector('[data-f="body"]') : null;
			if (body) {
				try {
					body.focus({ preventScroll: true });
				} catch (e) {
					/* ignore */
				}
			}
		}

		// 从某张卡片读回内容（含未提交的编辑）
		function collectCard(key) {
			var card = findCard(key);
			var it = key ? findItem(key) : null;
			var val = function (f) {
				var el = card ? card.querySelector('[data-f="' + f + '"]') : null;
				if (!el) return "";
				if (el.type === "checkbox") return !!el.checked;
				return el.value;
			};
			return {
				file: key || "",
				published: inputToStamp(val("published"), state.secBase),
				pinned: !!val("pinned"),
				location: String(val("location")).trim(),
				body: val("body"),
				extra: it ? it.extra.slice() : [],
			};
		}

		// 把某张卡片恢复成内存里的值（取消编辑时用）；新建卡直接移除
		function restoreCard(key) {
			if (key === "") {
				var draft = findCard("");
				if (draft && draft.parentNode) draft.parentNode.removeChild(draft);
				return;
			}
			var it = findItem(key);
			var card = findCard(key);
			if (!it || !card) return;
			var set = function (f, v) {
				var el = card.querySelector('[data-f="' + f + '"]');
				if (el) el.value = v;
			};
			set("published", stampToInput(it.published));
			set("location", it.location);
			set("body", it.body);
			var pin = card.querySelector('[data-f="pinned"]');
			if (pin) pin.checked = !!it.pinned;
		}

		function cancelEdit() {
			var key = state.editing;
			if (key === null) return;
			if (state.dirty) {
				askConfirm("改动还没提交到 GitHub，放弃后改动会丢失。", {
					title: "放弃未提交的修改？",
					okText: "确定",
					cancelText: "取消",
					kind: "warning",
				}).then(function (ok) {
					if (ok) {
						restoreCard(key);
						setEditing(null);
						render();
					}
				});
				return;
			}
			restoreCard(key);
			setEditing(null);
			render();
		}

		function validateForm(item) {
			if (!String(item.body).trim()) return "正文不能为空。";
			if (!isValidStamp(item.published)) return "发布时间格式不正确，请重新选择。";
			if (/[\r\n]/.test(item.location)) return "位置不能包含换行。";
			return "";
		}

		// 保存前自检：把即将写入的文本解析回来，逐字段与表单值比对 ——
		// 宁可阻止保存，也不把"读回来会变形/丢字段"的内容写进仓库（与友链编辑器同款做法）。
		function selfCheck(item, text) {
			var back = parseDynamic(text);
			if (back.published !== item.published) return "published";
			if (!!back.pinned !== !!item.pinned) return "pinned";
			if (back.location !== item.location) return "location";
			if (back.body.trim() !== String(item.body).trim()) return "正文";
			return "";
		}

		/* ───────────── 主流程 ───────────── */

		// 记下"已保存"快照（读取成功 / 提交成功后）。放弃修改、重新打开弹窗都回滚到这里，
		// 否则未提交的表单内容会在内存与 DOM 里残留。
		function markSaved() {
			state.saved = state.items.map(normalizeItem);
			state.dirty = false;
		}

		function restoreSaved() {
			if (!state.saved) return;
			var restored = state.saved.map(normalizeItem);
			// 内容与当前一致时**不重绘**：整体 innerHTML 重建会产生瞬时空帧，
			// 打开弹窗时调用它（内容本来就没变）会被看成"闪一下 / 过一会儿才出来"。
			if (sameData(restored, state.items)) {
				state.dirty = false;
				return;
			}
			state.items = restored;
			state.dirty = false;
			render();
		}

		function loadFromRemote() {
			listRemote()
				.then(function (entries) {
					if (!entries.length) return [];
					return readAll(entries);
				})
				.then(function (items) {
					// 用户在等待期间已开始编辑 ⇒ 不要用远端数据覆盖，避免吞掉刚落下的改动
					if (state.dirty) return;
					var pulled = sortItems(items.map(normalizeItem));
					// 与当前列表（通常来自服务端首屏快照）内容一致时：只补 sha，**不重绘**。
					// 整体 innerHTML 重建会造成瞬时空帧，是"打开时抖一下"的加重因素。
					var same = sameData(pulled, state.items);
					if (same) {
						// sha 只有远端有，必须补上，否则随后的编辑 / 删除会因 sha 缺失被拒
						for (var i = 0; i < pulled.length; i++) {
							if (state.items[i]) state.items[i].sha = pulled[i].sha;
						}
					} else {
						state.items = pulled;
					}
					state.loaded = true;
					markSaved();
					if (same) setSubtitle();
					else render();
					hideMsg();
				})
				.catch(function (e) {
					state.loaded = true;
					setSubtitle();
					showMsg(e.message || "读取失败，请重试。", "error");
				});
		}

		function openModal() {
			hideMsg(); // 先清掉上一次残留的提示（否则旧错误消息会带进本次打开的弹窗）
			setEditing(null);
			// 只在"需要清掉残留的新建卡"时才重建列表：无条件 render 会在打开瞬间造成一次
			// innerHTML 重建（瞬时空帧），这正是"点开时闪一下"的来源之一。
			if (listEl.querySelector('[data-new="1"]')) render();
			mask.classList.remove("hidden");
			mask.classList.add("flex");
			// 焦点落到关闭按钮：键盘用户不必 Tab 穿越整份列表；preventScroll 避免顺带滚动页面
			try {
				btnClose.focus({ preventScroll: true });
			} catch (e) {
				/* ignore */
			}
			if (state.saved) restoreSaved();
			loadFromRemote();
		}

		// 直接关闭：无动画（不做位移/缩放过渡，也不延迟隐藏）
		function doClose() {
			setEditing(null);
			// 同 openModal：仅在残留新建卡时才重建（关闭时虽不可见，但没必要做无谓的重排）
			if (listEl.querySelector('[data-new="1"]')) render();
			state.dirty = false;
			mask.classList.add("hidden");
			mask.classList.remove("flex");
		}

		function closeModal(force) {
			if (state.dirty && !force) {
				askConfirm("改动还没提交到 GitHub，放弃后改动会丢失。", {
					title: "放弃未提交的修改？",
					okText: "确定",
					cancelText: "取消",
					kind: "warning",
				}).then(function (ok) {
					if (ok) {
						restoreSaved();
						doClose();
					}
				});
				return;
			}
			doClose();
		}

		function doSave() {
			if (state.busy) return;
			if (state.editing === null) return; // 没有正在编辑的卡片
			var item = collectCard(state.editing);
			var err = validateForm(item);
			if (err) {
				showMsg(err, "warn");
				return;
			}
			var isEdit = !!state.editing;
			if (!isEdit) item.file = fileNameOf(new Date());
			var text = buildDynamic(item);
			var bad = selfCheck(item, text);
			if (bad) {
				showMsg("保存前自检未通过：「" + bad + "」读回后与填写不一致，已阻止提交。", "error");
				return;
			}
			var prev = isEdit ? findItem(state.editing) : null;
			setBusy(true, isEdit ? "正在提交修改…" : "正在发布…");
			putFile(
				item.file,
				text,
				prev && prev.sha ? prev.sha : "",
				commitMessage(isEdit ? "update" : "create", item.published),
			)
				.catch(function (e) {
					// 新建时无 sha：若撞上同名文件，GitHub 会返回 409/422 ⇒ 换成更准确的提示
					if (!isEdit && /409|422|被改动/.test(String(e.message)))
						throw new Error(
							"同名文件已存在（" + item.file + "），请稍后再试或改一下发布时间。",
						);
					throw e;
				})
				.then(function () {
					var idx = -1;
					for (var i = 0; i < state.items.length; i++) {
						if (state.items[i].file === item.file) idx = i;
					}
					var next = normalizeItem({
						file: item.file,
						sha: (prev && prev.sha) || (idx >= 0 ? state.items[idx].sha : ""),
						published: item.published,
						pinned: item.pinned,
						location: item.location,
						body: item.body,
						extra: item.extra,
						readError: false,
					});
					if (idx >= 0) state.items[idx] = next;
					else state.items.push(next);
					state.items = sortItems(state.items);
					state.loaded = true;
					setEditing(null);
					markSaved();
					render();
					showMsg((isEdit ? "已提交修改" : "已提交") + " ✓", "success");
					// 提交后 sha 会变：静默重拉一次目录，保证后续「编辑 / 删除」用的是最新 sha
					listRemote()
						.then(function (entries) {
							for (var i = 0; i < entries.length; i++) {
								var local = findItem(entries[i].file);
								if (local) local.sha = entries[i].sha;
							}
							markSaved();
						})
						.catch(function () {
							/* 静默失败：下次打开弹窗会重新读取 */
						});
				})
				.catch(function (e) {
					showMsg(e.message || "提交失败，请重试。", "error");
				})
				.then(function () {
					setBusy(false);
				});
		}

		function doDelete(it) {
			if (state.busy) return; // 提交 / 删除进行中不重复触发（避免同一个 sha 被并发使用）
			var label = summarize(it.body).slice(0, 16);
			askConfirm(
				"「" + (label || it.file) + "」这条动态将被删除。",
				{ title: "删除这条动态？", okText: "确定", kind: "danger" },
			).then(function (ok) {
				if (!ok) return;
				setBusy(true, "正在删除…");
				deleteFile(it.file, it.sha, commitMessage("destroy", it.published))
					.then(function () {
						state.items = state.items.filter(function (x) {
							return x.file !== it.file;
						});
						if (state.editing === it.file) {
							setEditing(null);
							render();
						}
						markSaved();
						render();
						showMsg("已提交删除 ✓", "success");
					})
					.catch(function (e) {
						showMsg(e.message || "删除失败，请重试。", "error");
					})
					.then(function () {
						setBusy(false);
					});
			});
		}

		/* ───────────── 站内确认框（替代 window.confirm，避免浏览器原生弹窗） ─────────────
		   锁滚动：只在确认框出现期间锁（主弹窗不锁），任何关闭路径都无条件解锁（不会锁死）。 */

		var confirmEl = document.getElementById("de-confirm");
		var confirmTitleEl = document.getElementById("de-confirm-title");
		var confirmTextEl = document.getElementById("de-confirm-text");
		var confirmOkBtn = document.getElementById("de-confirm-ok");
		var confirmCancelBtn = document.getElementById("de-confirm-cancel");
		var confirmIconEl = document.getElementById("de-confirm-icon");
		var confirmIcons = confirmIconEl ? confirmIconEl.querySelectorAll("svg[data-kind]") : [];
		var confirmResolve = null;

		// 三种语义：danger=破坏性操作（红）、warning=会丢改动的操作（橙）、info=提醒类（主色）
		var CONFIRM_SKINS = {
			danger: { fg: "#DC2626", btn: "#DC2626" },
			warning: { fg: "#B45309", btn: "#DC2626" },
			info: { fg: "var(--primary)", btn: "var(--primary)" },
		};

		function askConfirm(text, opts) {
			opts = opts || {};
			var kind = opts.kind || "danger";
			var skin = CONFIRM_SKINS[kind] || CONFIRM_SKINS.danger;
			confirmTitleEl.textContent = opts.title || "请确认";
			confirmTextEl.textContent = text;
			confirmOkBtn.textContent = opts.okText || "确定";
			confirmCancelBtn.textContent = opts.cancelText || "取消";
			confirmOkBtn.style.backgroundColor = skin.btn;
			confirmIconEl.style.color = skin.fg;
			for (var i = 0; i < confirmIcons.length; i++) {
				confirmIcons[i].classList.toggle(
					"hidden",
					confirmIcons[i].getAttribute("data-kind") !== kind,
				);
			}
			confirmEl.classList.remove("hidden");
			confirmEl.classList.add("flex");
			lockPageScroll();
			// 默认焦点给「取消」：破坏性操作不该让回车直接落到确认键上
			try {
				confirmCancelBtn.focus({ preventScroll: true });
			} catch (e) {
				/* ignore */
			}
			return new Promise(function (resolve) {
				confirmResolve = resolve;
			});
		}

		function settleConfirm(result) {
			if (!confirmResolve) return;
			var resolve = confirmResolve;
			confirmResolve = null;
			confirmEl.classList.add("hidden");
			confirmEl.classList.remove("flex");
			unlockPageScroll(); // 无条件解锁
			resolve(result);
		}

		/* ───────────── 事件绑定 ───────────── */

		// 【关键】把弹窗搬到 <body> 下：
		// 组件位于动态页头部卡片内，而站点卡片/布局祖先带 transform / backdrop-filter，
		// 这会让 position:fixed 相对"该祖先"而不是视口定位（弹窗被卡在卡片里、位置错乱）。
		if (mask.parentNode !== document.body) document.body.appendChild(mask);
		if (confirmEl.parentNode !== document.body) document.body.appendChild(confirmEl);

		// 面板空白处滚动的兜底：鼠标位于面板内但不在内容滚动容器上（头部/底部/间隙）时，
		// 阻止滚动链传给网页；内容区正常滚动；遮罩空白处不拦截（放行给网页滚动）。
		// 无 DOM 操作、无布局读取，开销可忽略。
		(function initPanelWheelGuard() {
			if (panel.__deWheelBound) return; // 脚本重放时不要重复绑
			panel.__deWheelBound = true;
			panel.addEventListener(
				"wheel",
				function (e) {
					if (e.target.closest && e.target.closest("#de-body")) return;
					e.preventDefault();
				},
				{ passive: false },
			);
		})();

		// 入口按钮可见性：有 Token（或 ?manage=1 兜底）才显示。
		// 提成具名函数：swup 切页后入口按钮是新元素，需要重新判断一次可见性。
		function initVisibility() {
			if (!btnOpen) return;
			var hasToken = !!cfg().token;
			var force = /[?&]manage=1\b/.test(window.location.search);
			if (!hasToken && !force) return;
			btnOpen.classList.remove("hidden");
			btnOpen.classList.add("inline-flex");
		}
		initVisibility();

		// 入口按钮的绑定必须幂等：swup 重放的新闭包与 swup 钩子（attachEntry）都会尝试绑它，
		// 不加保护会每次切页 +1，多个 handler 会让 openModal 被重复调用。
		// 标记写在元素上 ⇒ 跨闭包可见 ⇒ 无论两者谁先执行，最终都只有一次绑定。
		function bindOpen() {
			if (!btnOpen || btnOpen.__deOpenBound) return;
			btnOpen.__deOpenBound = true;
			btnOpen.addEventListener("click", openModal);
		}
		bindOpen();

		// 提示条右侧的关闭按钮：同样用元素级标记做幂等
		function bindMsgClose() {
			if (!msgCloseBtn || msgCloseBtn.__deBound) return;
			msgCloseBtn.__deBound = true;
			msgCloseBtn.addEventListener("click", hideMsg);
		}
		bindMsgClose();

		state.secBase = pad2(new Date().getSeconds());

		// 全部"直接绑定"集中在这里：首屏调用一次；swup 切页后由 attachEntry 再调用一次。
		// bindOnce 是元素级幂等 ⇒ 只有新元素才会真正绑上，重复调用无副作用
		// （否则一旦 swup 把弹窗 DOM 换成新的，列表区与按钮就会失去监听）。
		function bindAll() {
			bindOnce(btnClose, "click", function () {
				closeModal(false);
			});
			bindOnce(btnCancel, "click", function () {
				closeModal(false);
			});
		bindOnce(btnAdd, "click", function () {
			// 已有编辑中的卡片：先让它提交或取消，避免未提交内容被静默丢弃
			if (state.editing !== null) {
				if (state.dirty) {
					showMsg("请先提交或取消当前正在编辑的那条动态。", "warn");
					return;
				}
				setEditing(null);
			}
			setEditing("");
			render();
		});
		bindOnce(mask, "click", function (e) {
			if (e.target === mask) closeModal(false);
		});
		bindOnce(confirmOkBtn, "click", function () {
			settleConfirm(true);
		});
		bindOnce(confirmCancelBtn, "click", function () {
			settleConfirm(false);
		});
		bindOnce(confirmEl, "click", function (e) {
			if (e.target === confirmEl) settleConfirm(false);
		});

			// 列表区委托：编辑 / 取消 / 提交 / 删除（列表会整体重绘，所以绑在容器上）
			bindOnce(listEl, "click", function (e) {
			var btn = e.target.closest ? e.target.closest("[data-act]") : null;
			if (!btn) return;
			var card = btn.closest(".de-item");
			if (!card) return;
			var isNew = card.getAttribute("data-new") === "1";
			var key = isNew ? "" : card.getAttribute("data-file") || "";
			var act = btn.getAttribute("data-act");
			if (act === "edit") {
				if (state.dirty && state.editing !== key) {
					showMsg("请先提交或取消当前正在编辑的那条动态。", "warn");
					return;
				}
				setEditing(key);
				return;
			}
			if (act === "cancel") {
				cancelEdit();
				return;
			}
			if (act === "save") {
				doSave();
				return;
			}
			if (act === "del") {
				var it = findItem(key);
				if (it) doDelete(it);
			}
		});

			// 卡片里的任何输入/切换都视为"有未提交改动"（供取消/关闭时的放弃保护）；
			// 用程序赋值（render / restoreCard 里的 .value = / .checked =）不会触发事件，因此不会误标脏。
			// 只有"正在编辑的那一条"能输入（其余卡片是 readOnly）。
			bindOnce(listEl, "input", function () {
				if (state.editing !== null) state.dirty = true;
			});
			bindOnce(listEl, "change", function () {
				if (state.editing !== null) state.dirty = true;
			});
		}
		bindAll();

		// 具名函数：swup 重跑时需要能从 document 上精确移除（匿名函数无法移除）
		function onKeydown(e) {
			if (e.key !== "Escape") return;
			// 确认框优先：它开着时 Esc 只关它，不要连带把编辑弹窗也关掉
			if (!confirmEl.classList.contains("hidden")) {
				settleConfirm(false);
				return;
			}
			if (mask.classList.contains("hidden")) return;
			// 有卡片在编辑：Esc 先取消编辑（脏则弹放弃确认），不直接关掉整个弹窗
			if (state.editing !== null) cancelEdit();
			else closeModal(false);
		}

		function ensureKeydown() {
			if (window.__deKeydownBound) return;
			document.addEventListener("keydown", onKeydown);
			window.__deKeydownBound = true;
		}
		ensureKeydown();

		// 首屏快照：立刻用服务端内嵌的数据渲染一次，让弹窗一打开就是终态。
		// 否则"打开那一瞬间列表是空的、等 GitHub 返回才有内容"会表现为一次高度跳动
		// （友链编辑器同日踩过同一个坑，解法同为"服务端先给一份快照"）。
		(function bootstrapFromSeed() {
			try {
				var seed = JSON.parse(root.getAttribute("data-items") || "[]").map(function (x) {
					return normalizeItem(x);
				});
				state.items = sortItems(seed);
				// 服务端已经给出权威答案（哪怕为空），因此直接进入"已加载"态，不再显示读取中占位
				state.loaded = true;
				markSaved();
				render();
			} catch (e) {
				/* 快照不可用时保留"读取中"占位，等远端数据 */
			}
		})();

		/* ───────────── swup 重入 ───────────── */

		/**
		 * 彻底收拾：解绑键盘监听、复位滚动锁、把浮层从 body 上移除。
		 * 两个调用点：
		 *  ① 本组件脚本被重放之前（见文件开头）；
		 *  ② **切到没有本组件的页面时**（见 bindSwupHooks）—— 这一点早先漏了，
		 *     导致离开动态页后浮层一直挂在 body 上（无头浏览器实测残留）。
		 */
		function teardown() {
			window.__deKeydownBound = false;
			try {
				document.removeEventListener("keydown", onKeydown);
			} catch (e) {
				/* ignore */
			}
			// 复位滚动拦截：避免上一次脚本重放把监听器留在 window 上
			while (scrollLockCount > 0) unlockPageScroll();
			["de-mask", "de-confirm"].forEach(function (id) {
				var el = document.getElementById(id);
				if (el && el.parentNode === document.body) el.parentNode.removeChild(el);
			});
		}

		// 登记清理入口（供脚本重放时兜底，见文件开头）
		window.__deCleanup = teardown;

		// 【swup 重入 · 正式处理】两步：
		//   ① adoptDialog：接管"当前文档里最新的那份弹窗"。重放会在容器里带来新的一份 DOM，而闭包
		//      里的引用可能已被移出文档（表现成"页面读到的弹窗可见、handler 里的 mask 却是 hidden"）。
		//   ② attachEntry：重新取入口按钮引用并重绑，并确认 keydown 监听存在。
		function adoptDialog() {
			var masks = document.querySelectorAll("#de-mask");
			var confs = document.querySelectorAll("#de-confirm");
			var m = masks.length ? masks[masks.length - 1] : null;
			var c = confs.length ? confs[confs.length - 1] : null;
			var i;
			for (i = 0; i < masks.length - 1; i++) {
				if (masks[i].parentNode) masks[i].parentNode.removeChild(masks[i]);
			}
			for (i = 0; i < confs.length - 1; i++) {
				if (confs[i].parentNode) confs[i].parentNode.removeChild(confs[i]);
			}
			if (m && m.parentNode !== document.body) document.body.appendChild(m);
			if (c && c.parentNode !== document.body) document.body.appendChild(c);
			if (m) mask = m;
			if (c) confirmEl = c;
			refreshRefs();
		}

		function attachEntry() {
			adoptDialog();
			root = document.getElementById("de-root") || root;
			btnOpen = document.getElementById("de-open");
			if (!root) return;
			initVisibility();
			bindOpen(); // 幂等：只有新元素才会真正绑定
			bindMsgClose();
			bindAll(); // 弹窗内部（列表委托、按钮、确认框）也按新元素重绑一次
			ensureKeydown();
		}

		// 刷新元素引用：swup 换页后入口按钮是新的；万一弹窗 DOM 也被换掉，这里把引用一并指回
		// 当前文档中的那份。取不到时保留原引用，避免把引用清成 null。
		function refreshRefs() {
			root = document.getElementById("de-root") || root;
			btnOpen = document.getElementById("de-open") || btnOpen;
			mask = document.getElementById("de-mask") || mask;
			confirmEl = document.getElementById("de-confirm") || confirmEl;
			if (mask) {
				panel = mask.querySelector("#de-panel") || panel;
				listEl = mask.querySelector("#de-list") || listEl;
				emptyEl = mask.querySelector("#de-empty") || emptyEl;
				msgEl = mask.querySelector("#de-msg") || msgEl;
				subtitleEl = mask.querySelector("#de-subtitle") || subtitleEl;
				msgCloseBtn = mask.querySelector("#de-msg-close") || msgCloseBtn;
				msgTextEl = mask.querySelector("#de-msg-text") || msgTextEl;
				btnAdd = mask.querySelector("#de-add") || btnAdd;
				btnCancel = mask.querySelector("#de-cancel") || btnCancel;
				btnClose = mask.querySelector("#de-close") || btnClose;
			}
			if (confirmEl) {
				confirmTitleEl = confirmEl.querySelector("#de-confirm-title") || confirmTitleEl;
				confirmTextEl = confirmEl.querySelector("#de-confirm-text") || confirmTextEl;
				confirmOkBtn = confirmEl.querySelector("#de-confirm-ok") || confirmOkBtn;
				confirmCancelBtn = confirmEl.querySelector("#de-confirm-cancel") || confirmCancelBtn;
				confirmIconEl = confirmEl.querySelector("#de-confirm-icon") || confirmIconEl;
				confirmIcons = confirmIconEl ? confirmIconEl.querySelectorAll("svg[data-kind]") : [];
			}
		}

		// window.swup 可能晚于本脚本就绪，用 swup:enable 兜底（与站内 Navbar、友链编辑器同款做法）
		function bindSwupHooks() {
			// 脚本若被重放会存在多个闭包；钩子只保留最早那个（它的引用由 adoptDialog 持续刷新）
			if (window.__deSwupHooked) return true;
			if (!window.swup || !window.swup.hooks) return false;
			window.swup.hooks.on("content:replace", function () {
				adoptDialog(); // 先接管文档里最新的那份弹窗（并删掉重复），保证引用一致
				// 切到没有本组件的页面时：关掉弹窗，并**把浮层/监听一并收拾掉**，
				// 不留空壳在 body 上（不必重绑入口）
				if (!document.getElementById("de-root")) {
					doClose();
					teardown();
					return;
				}
				attachEntry();
			});
			window.__deSwupHooked = true;
			return true;
		}
		if (!bindSwupHooks()) {
			document.addEventListener(
				"swup:enable",
				function () {
					bindSwupHooks();
				},
				{ once: true },
			);
		}
	})();
</script>

