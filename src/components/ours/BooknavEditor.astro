				field("图标", '<input type="text" data-f="icon" value="' + escHtml(it.icon || "") + '" placeholder="图标（留空自动抓 favicon）" />') +
				'<div class="bo-hint">图标支持：图片 URL / /public 路径 / astro-icon 名；留空则自动抓取该站点 favicon</div>' +
				field("所属组", '<select data-f="gid">' + opts + "</select>") +
				'<div class="bo-factions"><button type="button" class="bo-btn" data-act="form-cancel">取消</button><button type="button" class="bo-btn bo-btn-primary" data-act="i-save">保存本条</button></div>' +
				"</div>"
			);
		}

		/** 书签行（只读展示：图标 + 标题 + 域名 + 操作） */
		function itemRow(g, it, idx, total) {
			var src = resolveIcon(it.icon, it.url);
			var host = hostOf(it.url);
			var html = '<div class="bo-item"' + (it.enabled === false ? ' data-disabled="1"' : "") + ' data-gid="' + escHtml(g.id) + '" data-idx="' + idx + '">';
			html += iconCell(src, (it.title || "?").charAt(0), "bo-iicon");
			html += '<span class="bo-ititle">' + escHtml(it.title || "（未命名）") + "</span>";
			if (host) html += '<span class="bo-ihost hidden sm:inline">' + escHtml(host) + "</span>";
			html += '<span class="bo-iactions">';
			html += iconBtn("i-up", g.id, idx, idx === 0, "上移", '<path d="m18 15-6-6-6 6"></path>');
			html += iconBtn("i-down", g.id, idx, idx === total - 1, "下移", '<path d="m6 9 6 6 6-6"></path>');
			html += iconBtn("i-edit", g.id, idx, false, "编辑", '<path d="M12 20h9"></path><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>');
			html += iconBtn("i-toggle", g.id, idx, false, it.enabled === false ? "启用" : "停用", '<path d="M18.36 6.64A9 9 0 1 1 5.64 6.64"></path><path d="M12 2v10"></path>');
			html += iconBtn("i-del", g.id, idx, false, "删除", '<path d="M18 6 6 18M6 6l12 12"></path>', true);
			html += "</span></div>";
			return html;
		}

		function renderAll() {
			var sig =
				JSON.stringify(state.groups) +
				"|" +
				JSON.stringify(state.open) +
				"|" +
				JSON.stringify(state.editing) +
				"|" +
				(state.busy ? "1" : "0");
			if (sig === lastSig) return;
			lastSig = sig;

			if (!state.groups.length) {
				listEl.innerHTML = "";
				setSubtitle();
				return;
			}

			var html = "";
			for (var gi = 0; gi < state.groups.length; gi++) {
				var g = state.groups[gi];
				var items = g.items || [];
				var isOpen = !!state.open[g.id];
				html +=
					'<section class="bo-group card-base"' +
					(g.enabled === false ? ' data-disabled="1"' : "") +
					(isOpen ? ' data-open="1"' : "") +
					' data-gid="' +
					escHtml(g.id) +
					'">';

				// 分组头（点整行折叠/展开）
				html += '<div class="bo-ghead" data-act="g-fold" data-gid="' + escHtml(g.id) + '">';
				html +=
					'<span class="bo-chev"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></span>';
				html += iconCell(resolveIcon(g.icon, ""), (g.name || g.id || "?").charAt(0), "bo-gicon");
				html += '<span class="bo-gname">' + escHtml(g.name || g.id) + "</span>";
				html +=
					'<span class="bo-gcount">' + items.length + " 条" + (g.enabled === false ? " · 停用" : "") + "</span>";
				html += '<span class="bo-gactions">';
				html += iconBtn("g-up", g.id, -1, gi === 0, "上移分组", '<path d="m18 15-6-6-6 6"></path>');
				html += iconBtn("g-down", g.id, -1, gi === state.groups.length - 1, "下移分组", '<path d="m6 9 6 6 6-6"></path>');
				html += iconBtn("g-edit", g.id, -1, false, "编辑分组", '<path d="M12 20h9"></path><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>');
				html += iconBtn("g-toggle", g.id, -1, false, g.enabled === false ? "启用分组" : "停用分组", '<path d="M18.36 6.64A9 9 0 1 1 5.64 6.64"></path><path d="M12 2v10"></path>');
				html += iconBtn("g-del", g.id, -1, false, "删除分组", '<path d="M18 6 6 18M6 6l12 12"></path>', true);
				html += "</span></div>";

				if (isOpen) {
					if (isEditing(g.id, -1)) html += groupForm(g);
					for (var ii = 0; ii < items.length; ii++) {
						if (isEditing(g.id, ii)) html += itemForm(g, items[ii], ii);
						else html += itemRow(g, items[ii], ii, items.length);
					}
					html += '<button type="button" class="bo-additem" data-act="i-add" data-gid="' + escHtml(g.id) + '">＋ 加书签</button>';
				}

				html += "</section>";
			}
			listEl.innerHTML = html;
			setSubtitle();
		}

		/* ── 交互（单列折叠 + 行内编辑）── */
		function uniqueGroupId(base) {
			var id = base;
			var n = 2;
			while (
				state.groups.some(function (g) {
					return g.id === id;
				})
			) {
				id = base + "-" + n;
				n++;
			}
			return id;
		}

		function focusFirstInput() {
			window.setTimeout(function () {
				var el = listEl.querySelector(".bo-form input[data-f], .bo-form select[data-f]");
				if (el) {
					try {
						el.focus({ preventScroll: true });
					} catch (e) {}
				}
			}, 0);
		}

		function addGroup() {
			var g = {
				id: uniqueGroupId("group"),
				name: "新分组",
				weight: 0,
				enabled: true,
				items: [],
			};
			state.groups.push(g);
			state.open[g.id] = true;
			state.editing = { gid: g.id, idx: -1 };
			state.formGid = g.id;
			state.formId = g.id;
			markDirty();
			focusFirstInput();
		}

		function addItem(gid) {
			var g = findGroup(gid);
			if (!g) return;
			if (!g.items) g.items = [];
			g.items.push({ title: "", url: "", weight: 0, enabled: true });
			state.open[gid] = true;
			state.editing = { gid: gid, idx: g.items.length - 1 };
			state.formGid = gid;
			markDirty();
			focusFirstInput();
		}

		function moveItem(gid, idx, dir) {
			var g = findGroup(gid);
			if (!g || !g.items) return;
			var j = idx + dir;
			if (j < 0 || j >= g.items.length) return;
			var tmp = g.items[idx];
			g.items[idx] = g.items[j];
			g.items[j] = tmp;
			state.editing = null;
			markDirty();
		}

		function moveGroup(gid, dir) {
			var i = findGroupIndex(gid);
			if (i < 0) return;
			var j = i + dir;
			if (j < 0 || j >= state.groups.length) return;
			var tmp = state.groups[i];
			state.groups[i] = state.groups[j];
			state.groups[j] = tmp;
			state.editing = null;
			markDirty();
		}

		function toggleItem(gid, idx) {
			var g = findGroup(gid);
			if (!g || !g.items || !g.items[idx]) return;
			g.items[idx].enabled = g.items[idx].enabled === false;
			markDirty();
		}

		function toggleGroup(gid) {
			var g = findGroup(gid);
			if (!g) return;
			g.enabled = g.enabled === false;
			markDirty();
		}

		function delItem(gid, idx) {
			var g = findGroup(gid);
			if (!g || !g.items || !g.items[idx]) return;
			var it = g.items[idx];
			askConfirm("「" + (it.title || it.url || "这条书签") + "」这条书签将被删除。", {
				title: "删除这条书签？",
				kind: "danger",
				okText: "确定",
			}).then(function (ok) {
				if (!ok) return;
				g.items.splice(idx, 1);
				state.editing = null;
				markDirty();
			});
		}

		function delGroup(gid) {
			var g = findGroup(gid);
			if (!g) return;
			askConfirm("「" + (g.name || g.id) + "」这个分组将被删除。", {
				title: "删除这个分组？",
				kind: "danger",
				okText: "确定",
			}).then(function (ok) {
				if (!ok) return;
				state.groups = state.groups.filter(function (x) {
					return x.id !== g.id;
				});
				state.open[g.id] = false;
				state.editing = null;
				markDirty();
			});
		}

		/** 保存分组表单（名称/图标/描述已即时写回；标识在保存时统一处理，要同步各处 key） */
		function saveGroupForm(gid) {
			var g = findGroup(gid);
			if (!g) return;
			var newId = String(state.formId == null ? g.id : state.formId).trim();
			if (!newId) {
				askConfirm("分组的「标识」不能为空。", { title: "无法保存", kind: "info", okText: "确定" });
				return;
			}
			if (newId !== gid) {
				var dup = state.groups.some(function (x) {
					return x !== g && x.id === newId;
				});
				if (dup) {
					askConfirm("标识「" + newId + "」已被其它分组占用。", { title: "无法保存", kind: "info", okText: "确定" });
					return;
				}
				if (state.open[gid]) {
					state.open[newId] = true;
					state.open[gid] = false;
				}
			}
			g.id = newId;
			if (!String(g.name || "").trim()) g.name = newId;
			state.editing = null;
			state.formId = null;
			markDirty();
		}

		/** 保存书签表单（字段已即时写回；"所属组"被改 ⇒ 换组，不用拖拽） */
		function saveItemForm(gid, idx) {
			var g = findGroup(gid);
			if (!g || !g.items || !g.items[idx]) return;
			var it = g.items[idx];
			if (!String(it.title || "").trim()) {
				askConfirm("书签的「标题」不能为空。", { title: "无法保存", kind: "info", okText: "确定" });
				return;
			}
			if (!String(it.url || "").trim()) {
				askConfirm("书签的「地址」不能为空。", { title: "无法保存", kind: "info", okText: "确定" });
				return;
			}
			var target = state.formGid || gid;
			if (target !== gid) {
				var g2 = findGroup(target);
				if (g2) {
					g.items.splice(idx, 1);
					if (!g2.items) g2.items = [];
					g2.items.push(it);
					state.open[target] = true;
				}
			}
			state.editing = null;
			state.formGid = null;
			markDirty();
		}

		/** 取消表单 = 回滚到"上次已保存"的快照；若是本次**新建**的组/条目 ⇒ 直接丢弃 */
		function cancelForm() {
			var cur = state.editing;
			if (cur) {
				var g = findGroup(cur.gid);
				var s = null;
				if (state.saved) {
					for (var i = 0; i < state.saved.length; i++) {
						if (state.saved[i].id === cur.gid) s = state.saved[i];
					}
				}
				if (!s) {
					// 不在"上次保存"里 ⇒ 本次新建 ⇒ 取消 = 丢弃
					if (cur.idx === -1) {
						state.groups = state.groups.filter(function (x) {
							return x.id !== cur.gid;
						});
						state.open[cur.gid] = false;
					} else if (g && g.items) {
						g.items.splice(cur.idx, 1);
					}
				} else if (g) {
					if (cur.idx === -1) {
						g.name = s.name;
						g.icon = s.icon;
						g.desc = s.desc;
						g.id = s.id;
					} else if (s.items && s.items[cur.idx]) {
						g.items[cur.idx] = JSON.parse(JSON.stringify(s.items[cur.idx]));
					} else if (g.items) {
						g.items.splice(cur.idx, 1);
					}
				}
			}
			state.editing = null;
			state.formGid = null;
			state.formId = null;
			markDirty();
		}

		function onListClick(e) {
			var btn = e.target.closest ? e.target.closest("[data-act]") : null;
			if (!btn) return;
			var act = btn.getAttribute("data-act");
			var gid = btn.getAttribute("data-gid") || "";
			var idx = Number(btn.getAttribute("data-idx"));
			// 表单内的按钮（保存本条 / 保存分组 / 取消）不带 data-gid/data-idx ⇒ 从 .bo-form 上取
			if (act === "i-save" || act === "g-save" || act === "form-cancel") {
				var form = btn.closest ? btn.closest(".bo-form") : null;
				if (form) {
					var fgid = form.getAttribute("data-gid");
					var fidx = form.getAttribute("data-idx");
					if (fgid) gid = fgid;
					if (fidx !== null) idx = Number(fidx);
				}
			}
			if (act === "g-fold") {
				state.open[gid] = !state.open[gid];
				if (!state.open[gid] && state.editing && state.editing.gid === gid) state.editing = null;
				renderAll();
			} else if (act === "g-up") moveGroup(gid, -1);
			else if (act === "g-down") moveGroup(gid, 1);
			else if (act === "g-edit") {
				state.open[gid] = true;
				state.editing = { gid: gid, idx: -1 };
				state.formGid = gid;
				state.formId = gid;
				markDirty();
				focusFirstInput();
			} else if (act === "g-toggle") toggleGroup(gid);
			else if (act === "g-del") delGroup(gid);
			else if (act === "g-save") saveGroupForm(gid);
			else if (act === "i-add") addItem(gid);
			else if (act === "i-up") moveItem(gid, idx, -1);
			else if (act === "i-down") moveItem(gid, idx, 1);
			else if (act === "i-edit") {
				state.editing = { gid: gid, idx: idx };
				state.formGid = gid;
				markDirty();
				focusFirstInput();
			} else if (act === "i-toggle") toggleItem(gid, idx);
			else if (act === "i-del") delItem(gid, idx);
			else if (act === "i-save") saveItemForm(gid, idx);
			else if (act === "form-cancel") cancelForm();
		}

		/** 表单字段即时写回 state；**不重建列表**（否则输入框失焦） */
		function onListInput(e) {
			var t = e.target;
			if (!t || !t.getAttribute) return;
			var f = t.getAttribute("data-f");
			if (!f) return;
			var form = t.closest ? t.closest(".bo-form") : null;
			if (!form) return;
			var gid = form.getAttribute("data-gid");
			var g = findGroup(gid);
			if (!g) return;
			if (form.getAttribute("data-form") === "group") {
				if (f === "id") {
					state.formId = t.value;
					state.dirty = true;
					return;
				}
				g[f] = t.value;
			} else {
				var idx = Number(form.getAttribute("data-idx"));
				if (!g.items || !g.items[idx]) return;
				if (f === "gid") {
					state.formGid = t.value;
					state.dirty = true;
					return;
				}
				g.items[idx][f] = t.value;
			}
			state.dirty = true;
			setSubtitle();
		}

		/* ── 打开 / 关闭 ── */
		/** 默认展开第一个分组（仅当"当前没有任何分组处于展开态"时） */
		function ensureOneOpen() {
			if (!state.groups.length) return;
			var anyOpen = false;
			for (var k in state.open) {
				if (state.open[k]) {
					anyOpen = true;
					break;
				}
			}
			if (!anyOpen) state.open[state.groups[0].id] = true;
		}

		function openModal() {
			resetRenderCache();
			if (!state.groups.length && seed.length) {
				state.groups = sortGroups(seed.map(normalizeGroup));
			}
			state.editing = null;
			state.formGid = null;
			state.formId = null;
			ensureOneOpen();
			mask.classList.remove("hidden");
			mask.classList.add("flex");
			// ⚠️ 主弹窗**不锁**页面滚动（与三兄弟一致）：lockPageScroll 只给确认框用。
			//    锁了会把弹窗内的滚轮也一起拦掉（表现为"弹窗里只能用拖动滚动条滚动"）。
			//    弹窗内滚动不带动网页靠 ① overscroll-behavior: contain ② 面板 wheel 兜底。
			renderAll();
			btnClose.focus({ preventScroll: true });
		}
		function doClose() {
			mask.classList.add("hidden");
			mask.classList.remove("flex");
			// 主弹窗未锁滚动 ⇒ 这里无需 unlock（确认框的 lock/unlock 自成对）
			try {
				if (document.activeElement && document.activeElement.blur) document.activeElement.blur();
			} catch (e) {}
		}
		function requestClose(force) {
			if (!mask || mask.classList.contains("hidden")) return;
			if (state.dirty && !force) {
				askConfirm("改动还没提交到云端，放弃后改动会丢失。", {
					title: "放弃未提交的修改？",
					kind: "warning",
				}).then(function (ok) {
					if (ok) {
						restoreSaved();
						doClose();
					}
				});
				return;
			}
			doClose();
		}
		function restoreSaved() {
			if (!state.saved) return;
			state.groups = sortGroups(JSON.parse(JSON.stringify(state.saved)).map(normalizeGroup));
			state.dirty = false;
			state.editing = null;
			state.formGid = null;
			state.formId = null;
			resetRenderCache();
			renderAll();
		}
		function markSaved() {
			state.saved = JSON.parse(JSON.stringify(state.groups));
			state.dirty = false;
			state.editing = null;
			state.formGid = null;
			state.formId = null;
			ensureOneOpen();
		}

		/* ── 刷新（唯一的主动拉取入口）── */
		function loadFromRemote() {
			return readRemote().then(function (r) {
				if (state.dirty) return;
				var loc = locateDataBlock(r.text);
				if (!loc) throw new Error("未能在 " + FILE_PATH + " 中定位 _baseBooknav 数据块。");
				var body = r.text.slice(loc.open + 1, loc.close);
				var groups = parseDataBody(body).map(normalizeGroup);
				var sig = JSON.stringify(groups.map(function (g) {
					return [g.id, g.name, g.items.length];
				}));
				var cur = JSON.stringify(state.groups.map(function (g) {
					return [g.id, g.name, g.items.length];
				}));
				if (sig !== cur) {
					state.groups = sortGroups(groups);
					state.editing = null;
					state.formGid = null;
					state.formId = null;
					ensureOneOpen();
					resetRenderCache();
					renderAll();
				}
			});
		}
		function onRefreshClick() {
			if (state.busy) return;
			btnRefresh.disabled = true;
			btnRefresh.textContent = "刷新中…";
			loadFromRemote()
				.then(
					function () {},
					function () {},
				)
				.then(function () {
					btnRefresh.disabled = false;
					btnRefresh.textContent = "刷新";
				});
		}

		/* ── 校验 + 保存（标记内重写）── */
		function validate() {
			for (var i = 0; i < state.groups.length; i++) {
				var g = state.groups[i];
				if (!(g.id || "").trim()) return "第 " + (i + 1) + " 个分组的「标识」不能为空";
				if (!(g.name || "").trim()) return "分组「" + g.id + "」的名称不能为空";
				var items = g.items || [];
				for (var j = 0; j < items.length; j++) {
					if (!(items[j].title || "").trim()) return "分组「" + (g.name || g.id) + "」第 " + (j + 1) + " 条书签的「标题」不能为空";
					if (!(items[j].url || "").trim()) return "「" + items[j].title + "」的「网址」不能为空";
				}
			}
			return "";
		}
		function dupWarning() {
			var seen = {};
			var dups = [];
			for (var i = 0; i < state.groups.length; i++) {
				var items = state.groups[i].items || [];
				for (var j = 0; j < items.length; j++) {
					var u = (items[j].url || "").replace(/\/+$/, "");
					if (!u) continue;
					if (seen[u]) dups.push(items[j].url);
					seen[u] = 1;
				}
			}
			return dups.length ? "检测到 " + dups.length + " 条重复网址：" + dups.slice(0, 2).join("、") : "";
		}

		function doSave() {
			// 阶段打点：保存链路任何一步失败都会留下痕迹（浏览器控制台可查 window.__saveLog），
			// 避免"点了没反应却无从排查"（三兄弟的 catch 空块曾导致同类问题）。
			window.__saveLog = ["start"];
			var L = function (m) {
				window.__saveLog.push(m);
			};
			if (state.busy) {
				L("busy: 已在提交中");
				return;
			}
			var err = validate();
			if (err) {
				L("validate: " + err);
				throw new Error(err);
			}
			L("validate ok");
			var c = requireToken();
			if (!c) {
				L("no token");
				throw new Error("未检测到 GitHub Token，请先在编辑器页面配置。");
			}
			L("token ok");
			if (!state.groups.length) {
				L("no groups");
				throw new Error("至少保留一个分组。");
			}
			L("groups ok");
			var dup = dupWarning();
			var doCommit = function () {
				L("commit start");
				setBusy(true, "提交中…");
				// 保存前自检：序列化 → 解析 → 与内存逐字段比对（weight 不参与）
				var body = buildDataBody(state.groups);
				L("body built: " + body.length + " 字符");
				var parsed = parseDataBody(body).map(normalizeGroup);
				L("parsed: " + parsed.length + " 组");
				for (var i = 0; i < parsed.length; i++) {
					var a = state.groups[i],
						b = parsed[i];
					if (a.id !== b.id || a.name !== b.name) {
						L("selfcheck: 第 " + i + " 组不一致");
						throw new Error("内部错误：序列化不一致，请刷新后重试。");
					}
				}
				L("selfcheck ok");
				setBusy(true, "正在提交…");
				readRemote()
					.then(function (r) {
						L("remote ok (sha=" + (r.sha || "").slice(0, 8) + ")");
						var loc = locateDataBlock(r.text);
						if (!loc) {
							L("locate: 未找到数据块");
							throw new Error("未能在 " + FILE_PATH + " 中定位 _baseBooknav 数据块。");
						}
						// 只替换数组体：标记行、声明行、类型标注、文件其余部分字节级不动
						var newText = r.text.slice(0, loc.open + 1) + body + r.text.slice(loc.close);
						L("slice ok, 新文本 " + newText.length + " 字符");
						return writeRemote(newText, r.sha);
					})
					.then(function () {
						L("PUT ok");
						markSaved();
					})
					.catch(function (e) {
						L("失败: " + (e && e.message ? e.message : String(e)));
						throw e;
					})
					.then(function () {
						setBusy(false);
					});
			};
			if (dup) {
				L("dup: " + dup);
				return askConfirm(dup, { title: "检测到重复", okText: "仍要保存", kind: "warning" }).then(
					function (ok) {
						L("dup confirm: " + ok);
						if (ok) doCommit();
					},
				);
			}
			L("no dup → commit");
			doCommit();
			return Promise.resolve();
		}

		/* ── 事件绑定（幂等）── */
		function bindAll() {
			bindOnce(btnOpen, "click", openModal);
			bindOnce(btnClose, "click", function () {
				requestClose(false);
			});
			bindOnce(btnCancel, "click", function () {
				requestClose(false);
			});
			bindOnce(btnSave, "click", function () {
				try {
					doSave();
				} catch (e) {}
			});
			bindOnce(btnRefresh, "click", onRefreshClick);
			bindOnce(btnAddGroup, "click", addGroup);
			bindOnce(listEl, "click", onListClick);
			bindOnce(listEl, "input", onListInput);
			bindOnce(listEl, "change", onListInput);
			bindOnce(confirmOkBtn, "click", function () {
				settleConfirm(true);
			});
			bindOnce(confirmCancelBtn, "click", function () {
				settleConfirm(false);
			});
			bindOnce(confirmEl, "click", function (e) {
				if (e.target === confirmEl) settleConfirm(false);
			});
			// Esc：确认框 → 主弹窗
			if (!window.__boKeydownBound) {
				document.addEventListener("keydown", onKeydown);
				window.__boKeydownBound = true;
			}
		}
		function onKeydown(e) {
			if (e.key !== "Escape") return;
			if (confirmEl && !confirmEl.classList.contains("hidden")) {
				settleConfirm(false);
				return;
			}
			if (!mask || mask.classList.contains("hidden")) return;
			requestClose(false);
		}

		/* ── 可见性：配置过 Token 或 ?manage=1 才显示入口 ── */
		function initVisibility() {
			if (!btnOpen) return;
			var hasToken = !!cfg().token;
			var force = /[?&]manage=1\b/.test(window.location.search);
			if (!hasToken && !force) return;
			btnOpen.classList.remove("hidden");
			btnOpen.classList.add("inline-flex");
		}

		/**
		 * swup 重放后文档里是新的一份 DOM ⇒ 闭包里所有引用都要重新取，
		 * 否则操作的是"已被移出文档的旧节点"（表现为：代码确实跑了、页面却毫无反应）。
		 * 这一步是三兄弟既有做法的核心（FriendsEditor 的 adoptDialog → refreshRefs）。
		 */
		function refreshRefs() {
			btnOpen = document.getElementById("bo-open");
			mask = document.getElementById("bo-mask");
			panel = document.getElementById("bo-panel");
			btnClose = document.getElementById("bo-close");
			btnCancel = document.getElementById("bo-cancel");
			btnSave = document.getElementById("bo-save");
			btnRefresh = document.getElementById("bo-refresh");
			btnAddGroup = document.getElementById("bo-add-group");
			listEl = document.getElementById("bo-list");
			emptyEl = document.getElementById("bo-empty");
			subtitleEl = document.getElementById("bo-subtitle");
			confirmEl = document.getElementById("bo-confirm");
			confirmTitleEl = document.getElementById("bo-confirm-title");
			confirmTextEl = document.getElementById("bo-confirm-text");
			confirmOkBtn = document.getElementById("bo-confirm-ok");
			confirmCancelBtn = document.getElementById("bo-confirm-cancel");
			confirmIconEl = document.getElementById("bo-confirm-icon");
			confirmIcons = confirmIconEl ? confirmIconEl.querySelectorAll("svg[data-kind]") : [];
		}

		/* ── 接管浮层并挂 body（祖先带 transform/backdrop-filter 会让 fixed 失效）──
		   同时取"文档里最新的那一份"（swup 会带来新 DOM）+ 刷新闭包引用 —— 顺序与三兄弟一致。 */
		function adoptDialog() {
			var masks = document.querySelectorAll("#bo-mask");
			var confs = document.querySelectorAll("#bo-confirm");
			var m = masks.length ? masks[masks.length - 1] : null;
			var c = confs.length ? confs[confs.length - 1] : null;
			for (var i = 0; i < masks.length - 1; i++) {
				if (masks[i].parentNode) masks[i].parentNode.removeChild(masks[i]);
			}
			for (var j = 0; j < confs.length - 1; j++) {
				if (confs[j].parentNode) confs[j].parentNode.removeChild(confs[j]);
			}
			if (m && m.parentNode !== document.body) {
				document.body.appendChild(m);
				m.setAttribute("data-bo-adopted", "1");
			}
			if (c && c.parentNode !== document.body) {
				document.body.appendChild(c);
				c.setAttribute("data-bo-adopted", "1");
			}
			refreshRefs();
		}

		/* ── teardown（swup 切页清理）──
		   keepFloaters=true：只解绑监听器/解锁滚动，**保留浮层**（脚本重放时用）。 */
		function teardown(keepFloaters) {
			if (window.__boKeydownBound) {
				document.removeEventListener("keydown", onKeydown);
				window.__boKeydownBound = false;
			}
			while (scrollLockCount > 0) unlockPageScroll();
			if (keepFloaters) return;
			// 只删带标记（＝曾被我们接管到 body）的浮层，避免误删本页新生成的浮层
			var adopted = document.querySelectorAll('[data-bo-adopted="1"]');
			for (var i = adopted.length - 1; i >= 0; i--) {
				if (adopted[i].parentNode) adopted[i].parentNode.removeChild(adopted[i]);
			}
		}
		window.__boCleanup = teardown;

		/**
		 * 面板空白处滚动的兜底（与三兄弟逐字同款）：
		 *   - 鼠标在面板内、但**不在**列表滚动容器上（头部/底部/卡片间隙）⇒ 拦截，
		 *     避免滚动链传给网页（"在弹窗里滚，网页也跟着跑"）；
		 *   - 列表区（`.bo-scroll`）内 ⇒ 放行，正常滚动；
		 *   - 遮罩空白处 ⇒ 本函数不生效，放行给网页滚动（符合预期）。
		 * 无 DOM 操作、无布局读取，开销可忽略。
		 */
		function initPanelWheelGuard() {
			if (!panel || panel.__boWheelBound) return; // 同一元素不重复绑
			panel.__boWheelBound = true;
			panel.addEventListener(
				"wheel",
				function (e) {
					if (e.target.closest && e.target.closest(".bo-scroll")) return;
					e.preventDefault();
				},
				{ passive: false },
			);
		}

		/* ── 启动 ── */
		adoptDialog();
		bindAll();
		initVisibility();
		initPanelWheelGuard();

		/* ── swup 钩子 ──
		   ⚠️ 必须用 `window.swup.hooks.on("content:replace", …)`（与 FriendsEditor 同款）。
		   本站用 @swup/astro：钩子是 **swup 实例 API**，不会以裸名 `content:replace` 派发到 document
		   （document 上的 DOM 事件名带前缀，是 `swup:content:replace`）。
		   事件名写错 ⇒ 清理函数永不执行 ⇒ 切页后浮层残留在 body 上。 */
		function bindSwupHooks() {
			// 脚本重放会产生多个闭包；钩子只保留最早那个（它的引用由 adoptDialog 持续刷新）
			if (window.__boSwupHooked) return true;
			if (!window.swup || !window.swup.hooks || typeof window.swup.hooks.on !== "function") return false;
			window.swup.hooks.on("content:replace", function () {
				window.__boReplaceHits = (window.__boReplaceHits || 0) + 1;
				// ★ 第一步必须先是 adoptDialog —— 顺序反过来（先 teardown）会把刚接管的那份删掉，
				//   闭包引用随即变成"已移出文档的旧节点"。
				adoptDialog();
				if (!document.getElementById("bo-root")) {
					// 切到没有本组件的页面 ⇒ 关弹窗 + 把浮层/监听一并收拾掉
					doClose();
					teardown();
					return;
				}
				bindAll();
				initPanelWheelGuard(); // DOM 是新的一份 ⇒ 兜底监听要绑到新面板上
			});
			window.__boSwupHooked = true;
			return true;
		}
		if (!bindSwupHooks()) {
			// swup 可能晚于本脚本就绪 ⇒ 用 swup:enable 兜底（与站内 Navbar / FriendsEditor 同款做法）
			document.addEventListener(
				"swup:enable",
				function () {
					bindSwupHooks();
				},
				{ once: true },
			);
		}
	})();
</script>
