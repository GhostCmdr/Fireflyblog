---
// [OURS] 书签导航就地编辑器：数据保存在上游原位（src/config/booknavConfig.ts 的 _baseBooknav 数组）。
// 读写机制与 FriendsEditor 同构（定位数组 → 整块重写），但只重写 [OURS-DATA-BEGIN]/[OURS-DATA-END]
// 标记之间的数据块，标记外（类型/页面/工具函数）字节级不动 —— 上游更新时「格式取上游、数据保我方」。
import { booknavConfig } from "@/config";

const initialJson = JSON.stringify(booknavConfig);
---

<div id="bo-root" class="ml-auto flex shrink-0 items-center" data-items={initialJson}>
	<button
		id="bo-open"
		type="button"
		class="absolute right-9 top-6 hidden shrink-0 cursor-pointer items-center gap-1.5 rounded-lg bg-(--primary) px-3 py-1.5 text-sm font-medium text-white transition-all hover:opacity-90 active:scale-95 focus-visible:ring-2 focus-visible:ring-(--primary)/40 focus-visible:outline-none dark:text-black/80"
	>
		<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
		<span class="hidden sm:inline">管理</span>
	</button>

	<!-- 主弹窗：单列折叠（分组为可折叠卡片，展开见组内书签行；行内展开编辑） -->
	<div
		id="bo-mask"
		class="fixed inset-0 z-[999] hidden items-center justify-center p-4 backdrop-blur-sm sm:p-6"
		style="background: rgba(0, 0, 0, 0.45); overscroll-behavior: contain;"
		role="dialog"
		aria-modal="true"
		aria-labelledby="bo-title"
	>
		<div
			id="bo-panel"
			class="card-base relative flex max-h-[92vh] w-full max-w-[720px] flex-col shadow-2xl sm:max-h-[85vh]"
		>
			<!-- 头部 -->
			<div class="flex shrink-0 items-start justify-between gap-3 border-b border-(--line-divider) px-5 py-4">
				<div class="min-w-0">
					<div id="bo-title" class="text-lg font-bold text-neutral-900 dark:text-neutral-100">管理书签</div>
					<div id="bo-subtitle" class="mt-0.5 truncate text-xs text-neutral-500 dark:text-neutral-400"></div>
				</div>
				<button
					id="bo-close"
					type="button"
					class="shrink-0 cursor-pointer rounded-lg p-1.5 text-neutral-400 transition-colors hover:bg-neutral-100 hover:text-neutral-600 dark:hover:bg-neutral-700 dark:hover:text-neutral-300"
					aria-label="关闭"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>
				</button>
			</div>

			<!-- 列表区：单列折叠 —— 每个分组 = 一张可折叠卡片。
			     容器固定 h-[380px]（与友链/动态一致）⇒ 内容清空时弹窗也不会塌缩，空态在其中垂直居中 -->
			<div
				class="bo-scroll flex h-[380px] grow flex-col overflow-y-auto pl-5 pr-[8px] py-4"
				style="overscroll-behavior: contain;"
			>
				<div id="bo-list" class="flex flex-col"></div>
				<div
					id="bo-empty"
					class="hidden grow flex-col items-center justify-center text-center text-sm text-neutral-400 dark:text-neutral-500"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						width="36"
						height="36"
						fill="currentColor"
						aria-hidden="true"
						class="mb-2 opacity-60"
						><path
							d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
						></path></svg
					>
					还没有书签，点下方「＋ 添加分组」开始。
				</div>
			</div>

			<!-- 底部操作条 -->
			<div class="flex shrink-0 items-center justify-between gap-2 border-t border-(--line-divider) px-5 py-3.5">
				<button id="bo-add-group" type="button" class="cursor-pointer rounded-lg border border-(--line-divider) px-4 py-2 text-sm font-medium text-neutral-600 transition-colors hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-700">＋ 添加分组</button>
				<div class="flex items-center gap-2">
					<button id="bo-refresh" type="button" class="cursor-pointer rounded-lg border border-(--line-divider) px-4 py-2 text-sm font-medium text-neutral-600 transition-colors hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-700">刷新</button>
					<button id="bo-cancel" type="button" class="cursor-pointer rounded-xl border border-(--line-divider) px-4 py-2 text-sm font-medium text-neutral-600 transition-colors hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-700">取消</button>
					<button id="bo-save" type="button" class="cursor-pointer rounded-xl bg-(--primary) px-4 py-2 text-sm font-semibold text-white transition-all hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-60 dark:text-black/80">提交到云端</button>
				</div>
			</div>
		</div>
	</div>

	<!-- 站内确认框：与友链/相册/动态完全同款 -->
	<div
		id="bo-confirm"
		class="fixed inset-0 z-[1000] hidden items-center justify-center p-4"
		style="overscroll-behavior: contain;"
		role="alertdialog"
		aria-modal="true"
		aria-labelledby="bo-confirm-title"
	>
		<div class="card-base w-full max-w-[380px] border border-(--line-divider) shadow-2xl backdrop-blur-sm">
			<div class="px-5 pt-5 pb-4">
				<div class="flex items-start gap-3">
					<span id="bo-confirm-icon" class="shrink-0" style="color: #DC2626;" aria-hidden="true">
						<svg data-kind="danger" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
						<svg data-kind="warning" class="hidden" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><path d="M12 9v4M12 17h.01"></path></svg>
						<svg data-kind="info" class="hidden" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4M12 8h.01"></path></svg>
					</span>
					<div class="min-w-0 flex-1">
						<div id="bo-confirm-title" class="text-[1.0625rem] leading-6 font-bold text-neutral-900 dark:text-neutral-100">请确认</div>
						<div id="bo-confirm-text" class="mt-1.5 text-sm leading-6 break-words text-neutral-600 dark:text-neutral-400"></div>
					</div>
				</div>
			</div>
			<div class="flex items-center justify-end gap-2 px-5 py-3.5">
				<button id="bo-confirm-cancel" type="button" class="cursor-pointer rounded-lg border border-(--line-divider) px-4 py-2 text-sm font-medium text-neutral-600 transition-colors hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-700">取消</button>
				<button id="bo-confirm-ok" type="button" class="cursor-pointer rounded-lg px-4 py-2 text-sm font-semibold text-white shadow-sm transition-all hover:brightness-110">确定</button>
			</div>
		</div>
	</div>
</div>

<style is:global>
	/* 浮层挂到 body 后类选择器失效 ⇒ 用 id 选择器给按钮手型光标 */
	#bo-mask button,
	#bo-confirm button {
		cursor: pointer;
	}
	/* 弹窗内滚动条：细 + 圆角 + 系统灰（与三兄弟逐条同款：
	   Chrome/Edge/Safari 走 ::-webkit-scrollbar；Firefox 走 scrollbar-width/color。
	   8px 槽 + 2px 透明边 + content-box ⇒ 视觉 4px 圆角条） */
	#bo-mask .bo-scroll {
		scrollbar-width: thin;
		scrollbar-color: rgba(0, 0, 0, 0.3) transparent;
		/* 始终预留滚动条槽位，避免"无滚动条→有滚动条"时宽度瞬跳（实测 720 → 710） */
		scrollbar-gutter: stable;
	}
	:root.dark #bo-mask .bo-scroll {
		scrollbar-color: rgba(255, 255, 255, 0.28) transparent;
	}
	#bo-mask .bo-scroll::-webkit-scrollbar {
		width: 8px;
		height: 8px;
	}
	#bo-mask .bo-scroll::-webkit-scrollbar-track {
		background: transparent;
	}
	#bo-mask .bo-scroll::-webkit-scrollbar-thumb {
		background: rgba(0, 0, 0, 0.3);
		background-clip: content-box;
		border: 2px solid transparent;
		border-radius: 999px;
	}
	#bo-mask .bo-scroll::-webkit-scrollbar-thumb:hover {
		background: rgba(0, 0, 0, 0.45);
		background-clip: content-box;
	}
	:root.dark #bo-mask .bo-scroll::-webkit-scrollbar-thumb {
		background: rgba(255, 255, 255, 0.28);
		background-clip: content-box;
	}
	:root.dark #bo-mask .bo-scroll::-webkit-scrollbar-thumb:hover {
		background: rgba(255, 255, 255, 0.42);
		background-clip: content-box;
	}
	/* ── 分组卡片（单列折叠）── */
	#bo-list .bo-group {
		border: 1px solid var(--line-divider);
		border-radius: 0.75rem;
		margin-bottom: 0.75rem;
		overflow: hidden;
	}
	#bo-list .bo-group[data-disabled="1"] {
		opacity: 0.6;
	}
	/* 分组头 */
	#bo-list .bo-ghead {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.625rem 0.75rem;
		cursor: pointer;
		background: rgba(115, 115, 115, 0.05);
	}
	#bo-list .bo-ghead:hover {
		background: rgba(115, 115, 115, 0.09);
	}
	#bo-list .bo-chev {
		line-height: 0;
		color: var(--text-secondary, #737373);
		transition: transform 0.18s ease;
	}
	#bo-list .bo-group[data-open="1"] .bo-chev {
		transform: rotate(90deg);
	}
	#bo-list .bo-gicon {
		display: grid;
		height: 1.5rem;
		width: 1.5rem;
		place-items: center;
		overflow: hidden;
		border-radius: 0.375rem;
		background: rgba(115, 115, 115, 0.12);
		font-size: 0.625rem;
		color: var(--text-secondary, #737373);
		flex-shrink: 0;
	}
	#bo-list .bo-gicon img {
		height: 100%;
		width: 100%;
		object-fit: cover;
	}
	#bo-list .bo-gname {
		font-size: 0.8125rem;
		font-weight: 600;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	#bo-list .bo-gcount {
		font-size: 0.6875rem;
		color: var(--text-secondary, #737373);
		flex-shrink: 0;
	}
	#bo-list .bo-gactions {
		margin-left: auto;
		display: flex;
		align-items: center;
		gap: 0.125rem;
		flex-shrink: 0;
	}
	/* 通用图标按钮 */
	#bo-list .bo-ico {
		cursor: pointer;
		border-radius: 0.375rem;
		padding: 0.25rem;
		color: var(--text-secondary, #737373);
		line-height: 0;
		transition: background-color 0.15s ease, color 0.15s ease;
	}
	#bo-list .bo-ico:hover {
		background: rgba(115, 115, 115, 0.12);
		color: var(--primary);
	}
	#bo-list .bo-ico:disabled {
		opacity: 0.3;
		cursor: default;
	}
	#bo-list .bo-ico:disabled:hover {
		background: transparent;
		color: var(--text-secondary, #737373);
	}
	#bo-list .bo-ico.bo-danger {
		color: #dc2626;
	}
	#bo-list .bo-ico.bo-danger:hover {
		background: rgba(220, 38, 38, 0.1);
	}
	/* ── 书签行（只读展示，点 ✎ 才展开表单）── */
	#bo-list .bo-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0.75rem;
		border-top: 1px solid var(--line-divider);
	}
	#bo-list .bo-item[data-disabled="1"] {
		opacity: 0.55;
	}
	#bo-list .bo-iicon {
		display: grid;
		height: 1.5rem;
		width: 1.5rem;
		place-items: center;
		overflow: hidden;
		border-radius: 0.375rem;
		background: rgba(115, 115, 115, 0.12);
		font-size: 0.625rem;
		color: var(--text-secondary, #737373);
		flex-shrink: 0;
	}
	#bo-list .bo-iicon img {
		height: 100%;
		width: 100%;
		object-fit: cover;
	}
	#bo-list .bo-ititle {
		font-size: 0.8125rem;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	#bo-list .bo-ihost {
		font-size: 0.6875rem;
		color: var(--text-secondary, #737373);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	#bo-list .bo-iactions {
		margin-left: auto;
		display: flex;
		align-items: center;
		gap: 0.125rem;
		flex-shrink: 0;
	}
	/* ── 行内表单（编辑书签 / 编辑分组）── */
	#bo-list .bo-form {
		border-top: 1px solid var(--line-divider);
		background: rgba(115, 115, 115, 0.04);
		padding: 0.75rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	#bo-list .bo-field {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	#bo-list .bo-field > label {
		width: 3.25rem;
		flex-shrink: 0;
		font-size: 0.75rem;
		color: var(--text-secondary, #737373);
	}
	#bo-list .bo-form input[type="text"],
	#bo-list .bo-form select {
		width: 100%;
		min-width: 0;
		border: 1px solid var(--line-divider);
		border-radius: 0.5rem;
		padding: 0.375rem 0.625rem;
		font-size: 0.8125rem;
		outline: none;
		transition: border-color 0.15s ease;
		background: transparent;
		color: var(--text-main, currentColor);
	}
	#bo-list .bo-form input[type="text"]:focus,
	#bo-list .bo-form select:focus {
		border-color: var(--primary);
	}
	#bo-list .bo-hint {
		margin-left: 3.75rem;
		font-size: 0.6875rem;
		line-height: 1.4;
		color: var(--text-secondary, #737373);
	}
	#bo-list .bo-factions {
		display: flex;
		justify-content: flex-end;
		gap: 0.5rem;
		margin-top: 0.125rem;
	}
	#bo-list .bo-btn {
		cursor: pointer;
		border-radius: 0.5rem;
		border: 1px solid var(--line-divider);
		padding: 0.3125rem 0.75rem;
		font-size: 0.75rem;
		color: var(--text-secondary, #737373);
		background: transparent;
		transition: background-color 0.15s ease;
	}
	#bo-list .bo-btn:hover {
		background: rgba(115, 115, 115, 0.1);
	}
	#bo-list .bo-btn.bo-btn-primary {
		background: var(--primary);
		border-color: var(--primary);
		color: #fff;
		font-weight: 600;
	}
	#bo-list .bo-btn.bo-btn-primary:hover {
		opacity: 0.9;
	}
	/* 加书签（组内底部虚线按钮） */
	#bo-list .bo-additem {
		display: block;
		width: 100%;
		border: 0;
		border-top: 1px dashed var(--line-divider);
		background: transparent;
		padding: 0.5rem 0.75rem;
		text-align: left;
		font-size: 0.75rem;
		color: var(--text-secondary, #737373);
		cursor: pointer;
		transition: color 0.15s ease, background-color 0.15s ease;
	}
	#bo-list .bo-additem:hover {
		color: var(--primary);
		background: rgba(115, 115, 115, 0.05);
	}
</style>

<script is:inline>
	(function () {
		/* ── swup 重入：先执行上一次登记的清理，避免监听器累积 ──
		   ⚠️ 传 true ⇒ **保留浮层**：本页（切回本页 / 同页重放）马上还要用它；
		   若这里把浮层删掉，会出现"从别的页切回书签页后，弹窗打不开"。 ── */
		if (typeof window.__boCleanup === "function") {
			try {
				window.__boCleanup(true);
			} catch (e) {}
		}
		window.__boCleanup = null;

		var root = document.getElementById("bo-root");
		if (!root) return;

		var seed = [];
		try {
			seed = JSON.parse(root.getAttribute("data-items") || "[]");
		} catch (e) {
			seed = [];
		}

		/* ── 元素引用 ── */
		var btnOpen = document.getElementById("bo-open");
		var mask = document.getElementById("bo-mask");
		var panel = document.getElementById("bo-panel");
		var btnClose = document.getElementById("bo-close");
		var btnCancel = document.getElementById("bo-cancel");
		var btnSave = document.getElementById("bo-save");
		var btnRefresh = document.getElementById("bo-refresh");
		var btnAddGroup = document.getElementById("bo-add-group");
		var listEl = document.getElementById("bo-list");
		var emptyEl = document.getElementById("bo-empty");
		var subtitleEl = document.getElementById("bo-subtitle");
		var confirmEl = document.getElementById("bo-confirm");
		var confirmTitleEl = document.getElementById("bo-confirm-title");
		var confirmTextEl = document.getElementById("bo-confirm-text");
		var confirmOkBtn = document.getElementById("bo-confirm-ok");
		var confirmCancelBtn = document.getElementById("bo-confirm-cancel");
		var confirmIconEl = document.getElementById("bo-confirm-icon");
		var confirmIcons = confirmIconEl ? confirmIconEl.querySelectorAll("svg[data-kind]") : [];
		var confirmResolve = null;

		/* ── GitHub 配置（与三兄弟同一套 key）── */
		var FILE_PATH = "src/config/booknavConfig.ts";
		var DATA_BEGIN = "// [OURS-DATA-BEGIN]";
		var DATA_END = "// [OURS-DATA-END]";
		var DEFAULT_REPO = "GhostCmdr/Fireflyblog";

		function cfg() {
			var ls = window.localStorage;
			return {
				token: ls.getItem("gh-token") || ls.getItem("gh-editor-token") || "",
				repo: ls.getItem("gh-repo") || ls.getItem("gh-editor-repo") || DEFAULT_REPO,
				branch: ls.getItem("gh-branch") || "main",
			};
		}

		function escHtml(s) {
			return String(s == null ? "" : s)
				.replace(/&/g, "&amp;")
				.replace(/</g, "&lt;")
				.replace(/>/g, "&gt;")
				.replace(/"/g, "&quot;")
				.replace(/'/g, "&#39;");
		}

		function bindOnce(el, type, fn) {
			if (!el || !el.addEventListener) return;
			var flag = "__boBound_" + type;
			if (el[flag]) return;
			el[flag] = true;
			el.addEventListener(type, fn);
		}

		/* ── 状态 ── */
		var state = {
			groups: [],
			saved: null,
			dirty: false,
			busy: false,
			// 单列折叠 UI：哪些分组是展开的 { gid: true }
			open: {},
			// 行内编辑中的目标：{ gid, idx }；idx = -1 表示"在编辑这个分组本身"
			editing: null,
		};

		function findGroup(gid) {
			for (var i = 0; i < state.groups.length; i++) {
				if (state.groups[i].id === gid) return state.groups[i];
			}
			return null;
		}

		function findGroupIndex(gid) {
			for (var i = 0; i < state.groups.length; i++) {
				if (state.groups[i].id === gid) return i;
			}
			return -1;
		}

		function isEditing(gid, idx) {
			return !!state.editing && state.editing.gid === gid && state.editing.idx === idx;
		}

		function markDirty() {
			state.dirty = true;
			renderAll();
		}

		function setSubtitle() {
			var g = 0,
				n = 0;
			for (var i = 0; i < state.groups.length; i++) {
				g++;
				n += (state.groups[i].items || []).length;
			}
			subtitleEl.textContent =
				"共 " + g + " 个分组 · " + n + " 条书签 · 列表顺序 = 页面显示顺序（权重自动生成）";
			// 空态与列表同处固定高度容器内：列表空就空着，空态自己的 grow 负责垂直居中
			emptyEl.classList.toggle("hidden", state.groups.length > 0);
			emptyEl.classList.toggle("flex", state.groups.length === 0);
		}

		function setBusy(on, label) {
			state.busy = !!on;
			btnSave.disabled = !!on;
			btnRefresh.disabled = !!on;
			btnAddGroup.disabled = !!on;
			btnSave.textContent = on ? label || "提交中…" : "提交到云端";
