				if (a.description) o.description = a.description;
				if (a.location) o.location = a.location;
				if (a.date) o.date = a.date;
				if (a.tags && a.tags.length) o.tags = a.tags.slice();
				if (a.cover) o.cover = a.cover;
				if (a.password) o.password = a.password;
				if (a.passwordHint) o.passwordHint = a.passwordHint;
				return o;
			});
			return JSON.stringify(out, null, "\t") + "\n";
		}

		function navItemHtml(a) {
			// 左列导航项：白底卡片（与动态列表同款），选中态给主色描边（对齐动态"编辑中的卡片"）
			var active = state.editing !== "" && a.id === state.selected;
			var sub = a.date || a.location || "";
			// 张数显示在这里（用户要求：不再放在「图片管理」Tab 上）
			var cnt = state.photoCounts[a.id];
			if (typeof cnt === "number" && cnt >= 0) sub = sub ? sub + " · " + cnt + " 张" : cnt + " 张";
			// 选中项的缩略图也做"无 cover 时用第一张照片"的回退（其它项拿不到照片列表）
			var navCov = a.id === state.selected ? effectiveCover() : String(a.cover || "");
			var thumb = navCov
				? '<img src="' +
					escHtml(navCov) +
					'" alt="" loading="lazy" class="h-full w-full object-cover" onerror="this.style.display=\'none\'" />'
				: "图";
			return (
				'<div class="ge-nav-item card-base" data-nav="' +
				escHtml(a.id) +
				'"' +
				(active ? ' data-active="1"' : "") +
				">" +
				'<div class="grid h-11 w-11 shrink-0 place-items-center overflow-hidden rounded-md bg-gradient-to-br from-(--primary)/30 to-(--primary)/5 text-[9px] text-neutral-500 dark:text-neutral-400">' +
				thumb +
				"</div>" +
				'<div class="min-w-0">' +
				// 加密相册补一个小锁标记（密码字段非空即加密），否则它和公开相册长得一样
				'<div class="flex items-center gap-1">' +
				'<div class="ge-nav-name truncate">' +
				escHtml(a.name || a.id) +
				"</div>" +
				(a.password
					? '<svg class="shrink-0 opacity-70" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="11" height="11" fill="currentColor" role="img" aria-label="加密相册"><path d="M12 2a5 5 0 0 0-5 5v3H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2h-1V7a5 5 0 0 0-5-5zM9 10V7a3 3 0 0 1 6 0v3H9z"></path></svg>'
					: "") +
				"</div>" +
				(sub
					? '<div class="truncate text-[10px] text-neutral-400 dark:text-neutral-500">' +
						escHtml(sub) +
						"</div>"
					: "") +
				"</div></div>"
			);
		}

		/** 新建态时左列顶部出现的「新建相册」项（用户要求：点新建后左列要能看到它） */
		function navNewHtml() {
			var active = state.editing === "";
			return (
				'<div class="ge-nav-item card-base" data-nav=""' +
				(active ? ' data-active="1"' : "") +
				">" +
				'<div class="grid h-11 w-11 shrink-0 place-items-center rounded-md border-2 border-dashed border-(--line-divider) text-neutral-400">' +
				'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>' +
				"</div>" +
