		/* 三个"内容签名"：内容没变就不重建对应 DOM。
		   重建的代价不只是 CPU —— 照片网格里的 <img> 会重新解码/重新请求，
		   信息表单还会被回填从而冲掉用户正在输入、还没提交的内容。 */
		var lastInfoSig = "";
		var lastCoverSig = "";
		var lastGridSig = "";

		/** 手动清空过网格 / 换了数据源时调用：让签名失效，否则 renderPhotoPanel 会误判"内容没变"而跳过重建 */
		function resetRenderCache() {
			lastInfoSig = "";
			lastCoverSig = "";
			lastGridSig = "";
		}

		function cfg() {
			var ls = window.localStorage;
			return {
				token: ls.getItem("gh-token") || ls.getItem("gh-editor-token") || "",
				repo: ls.getItem("gh-editor-repo") || DEFAULT_REPO,
				branch: ls.getItem("gh-branch") || "main",
