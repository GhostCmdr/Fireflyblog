			var covers = state.photoFiles.filter(function (f) {
				return COVER_RE.test(f.name) && IMG_RE.test(f.name);
			});
			var locals = state.photoFiles.filter(function (f) {
				return IMG_RE.test(f.name) && !COVER_RE.test(f.name);
			});
			var pick = covers[0] || locals[0];
			if (pick)
				return (
					"/gallery/" + encodeURIComponent(state.selected) + "/" + encodeURIComponent(pick.name)
				);
