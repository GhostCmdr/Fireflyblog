---
// [OURS] 相册就地编辑器（相册页 /gallery/ 内联组件，形态与动态页 DynamicEditor 一致）
//
// 交互：配过 GitHub Token 的浏览器里，相册页标题行右侧出现「管理」按钮 ⇒ 点开**弹窗**
//       就地管理相册（新建 / 编辑 / 删除 / 照片上传删除 / 封面 / 远程清单），**不跳转页面**。
//
// 为什么做成"组件 + 弹窗"而不是独立页面：
//   ① 用户要求与动态页一致的弹窗体验；
//   ② 对上游相册页的改动仍只有 1 行（`<GalleryEditor items={...} />`），
//      全部逻辑收在本组件内 ⇒ 上游更新相册页时冲突面极小（历史教训：曾达 +488 行）。
//
// 数据与文件通道：
//   - 相册元数据：src/config/ours/gallery-albums.json（本组件在线增删改的就是它）
//   - 相册照片：public/gallery/<相册 id>/（本地照片 + cover.* + urls.txt 远程清单）
//   - 读写：浏览器内 GitHub Contents API（凭证取 localStorage，与友链/动态编辑器一致）
//
// 关键约束：
//   - 只读 oursGalleryConfig.albums（我方数据），绝不用合并后的 galleryConfig.albums
//     （后者含上游默认示例相册，写回会污染我方数据）
//   - 相册 id 同时是网址与照片目录名 ⇒ 编辑时不可修改
//   - 封面必须写 cover 字段：上游"自动取 cover 文件"的分支实际不生效
//     （scanAlbumPhotos 已把 cover.* 排除在照片列表外）
import type { GalleryAlbum } from "@/types/galleryConfig";
import { url } from "@/utils/url-utils";

interface Props {
	/** 首屏快照（由相册页传入我方相册数据），让弹窗打开即为终态 */
	items?: GalleryAlbum[];
	/**
	 * 各相册的照片张数：id → 张数。
	 * 由相册页在**构建时**扫描目录算好（用的是同一个 scanAlbumPhotos，口径与前台一致）。
	 * ⚠️ 单独传而不是塞进 items：相册页那份数据里的 cover 是 getAlbumCover 算出的"回退封面"，
	 * 混进 items 会被编辑器当成真实 cover 写回配置 ⇒ 污染数据。
	 * 运行时上传/删除照片后，由前端 reloadPhotos() 就地刷新对应项。
	 */
	photoCounts?: Record<string, number>;
	/**
	 * 构建时内嵌的**照片清单**：id → { files: 本地图片文件名[], urls: 外链[] }。
	 * 编辑器读取全部走这份快照 ⇒ 打开弹窗 / 切 Tab / 切相册**零请求**、照片秒出图；
	 * 只有写操作（上传 / 删除 / 改配置 / 外链）才调 GitHub API（需要 sha 的当场获取）。
	 * 快照是"上次构建时"的状态，与仓库不一致时点「刷新」手动同步。
	 */
	photoManifest?: Record<string, { files: string[]; urls: string[] }>;
}

const { items = [], photoCounts = {}, photoManifest = {} } = Astro.props;
const initialJson = JSON.stringify(items);
const initialCountsJson = JSON.stringify(photoCounts);
const initialManifestJson = JSON.stringify(photoManifest);
---

<div
	id="ge-root"
	class="flex shrink-0 items-center"
	data-albums={initialJson}
	data-photo-counts={initialCountsJson}
	data-photo-manifest={initialManifestJson}
	data-config-path="src/config/ours/gallery-albums.json"
	data-photo-dir="public/gallery"
>
	<!-- 管理入口：默认隐藏，脚本判定通过后才显示（无 Token 的访客完全看不到） -->
	<button
		id="ge-open"
		type="button"
		class="absolute right-9 top-6 hidden shrink-0 cursor-pointer items-center gap-1.5 rounded-lg bg-(--primary) px-3 py-1.5 text-sm font-medium text-white transition-all hover:opacity-90 active:scale-95 focus-visible:ring-2 focus-visible:ring-(--primary)/40 focus-visible:outline-none dark:text-black/80"
		aria-label="管理相册"
	>
		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 24 24"
			width="16"
			height="16"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
			><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"></path><path
				d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg
		>
		<span class="hidden sm:inline">管理</span>
	</button>
</div>

<!-- ── 主弹窗（720px 三段式，与动态/友链编辑器同款） ── -->
<div
	id="ge-mask"
	class="fixed inset-0 z-[999] hidden items-center justify-center p-4 backdrop-blur-sm sm:p-6"
	style="background: rgba(0, 0, 0, 0.45); overscroll-behavior: contain;"
	role="dialog"
	aria-modal="true"
	aria-label="管理相册"
>
	<div class="card-base relative flex max-h-[92vh] w-full max-w-[720px] flex-col shadow-2xl sm:max-h-[85vh]">
		<!-- 头部（固定） -->
		<div class="flex shrink-0 items-start justify-between gap-3 border-b border-(--line-divider) px-5 py-4">
			<div class="min-w-0">
				<div id="ge-title" class="text-lg font-bold text-neutral-900 dark:text-neutral-100">管理相册</div>
				<div id="ge-subtitle" class="mt-0.5 truncate text-xs text-neutral-500 dark:text-neutral-400">
					正在读取…
				</div>
			</div>
			<button
				id="ge-close"
				type="button"
				class="shrink-0 cursor-pointer rounded-lg p-1.5 text-neutral-400 transition-colors hover:bg-neutral-100 hover:text-neutral-700 dark:hover:bg-neutral-700 dark:hover:text-neutral-200"
				aria-label="关闭"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					width="20"
					height="20"
					fill="currentColor"
					aria-hidden="true"
					><path
						d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
					></path></svg
			>
			</button>
		</div>

		<!-- ── 内容区：左列相册导航 + 右侧双 Tab（信息 / 图片）── -->
		<div class="flex min-h-0 grow">
			<!-- 左列：搜索 + 相册列表（独立滚动） -->
			<div class="flex w-[200px] shrink-0 flex-col border-r border-(--line-divider)">
				<!-- 高度 h-11 与右列 Tab 栏一致 ⇒ 两侧的分隔线才能齐平 -->
				<!-- 左右内边距与下方列表对齐：左 18px；右 18px（列表右侧是 pr-8 + 常驻 10px 滚动条槽位）。
				     搜索框与卡片左右边缘严格对齐，不要改回 px-2。 -->
				<div class="flex h-11 shrink-0 items-center border-b border-(--line-divider) pl-5 pr-[18px]">
					<input
						id="ge-search"
						type="text"
						placeholder="搜索相册…"
						autocomplete="off"
						class="w-full rounded-lg border border-(--line-divider) bg-transparent px-2 py-1 text-xs text-neutral-900 outline-none transition-all placeholder-neutral-400 focus:border-(--primary) focus:ring-1 focus:ring-(--primary)/40 dark:text-neutral-100"
					/>
				</div>
				<div
					id="ge-nav"
					class="ge-scroll min-h-0 grow overflow-y-auto py-2 pl-5 pr-[8px]"
					style="overscroll-behavior: contain;"
				>
				</div>
				<div
					id="ge-empty"
					class="hidden shrink-0 flex-col items-center justify-center px-5 py-8 text-center text-xs text-neutral-400 dark:text-neutral-500"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						width="30"
						height="30"
						fill="currentColor"
						aria-hidden="true"
						class="mb-2 opacity-60"
						><path
							d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
						></path></svg
					>
					<!-- 文案由脚本按场景切换：一个相册都没有 ↔ 搜索无匹配 -->
					<span data-empty-text>还没有相册，点下方「+ 新建相册」创建第一个。</span>
				</div>
			</div>

			<!-- 右列：Tab 栏 + 面板 -->
			<div class="flex min-w-0 grow flex-col">
				<!-- Tab 栏（右侧是全局操作区：编辑 / 取消 / 提交 / 刷新）；高度 h-11 与左列搜索行一致 -->
				<div class="flex h-11 shrink-0 items-center border-b border-(--line-divider) pr-4 pl-4">
					<div class="flex items-center gap-0.5">
						<button
							id="ge-tab-info"
							type="button"
							class="-mb-px border-b-2 px-3 py-2.5 text-sm transition-colors"
						>
							基本信息
						</button>
						<button
							id="ge-tab-photos"
							type="button"
							class="-mb-px flex items-center gap-1.5 border-b-2 px-3 py-2.5 text-sm transition-colors"
						>
							图片管理
						</button>
					</div>
					<div id="ge-actions" class="ml-auto flex items-center gap-1.5"></div>
				</div>

				<!-- 面板 A：信息（字段常驻，只读 / 编辑两态共用同一套 DOM）
				     flex + 内部卡片 grow ⇒ 内容少时卡片自动撑满，不会在下方露出一段空白 -->
				<div
					id="ge-panel-info"
					class="ge-panel-flex ge-scroll flex h-[340px] grow flex-col overflow-y-auto pl-5 pr-[8px]"
					style="overscroll-behavior: contain;"
				>
					<!-- 一个相册都没有时的空态（与动态弹窗的空态同款：居中图标 + 一句话） -->
					<div
						id="ge-info-empty"
						class="my-3 hidden grow flex-col items-center justify-center py-16 text-center text-sm text-neutral-400 dark:text-neutral-500"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							viewBox="0 0 24 24"
							width="36"
							height="36"
							fill="currentColor"
							aria-hidden="true"
							class="mb-2 opacity-60"
							><path
								d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
							></path></svg
						>
						还没有相册，点下方「+ 新建相册」创建第一个。
					</div>
					<div
						id="ge-info-form"
						class="card-base my-3 min-h-[calc(100%-1.5rem)] w-full shrink-0 rounded-xl border border-(--line-divider) p-4"
					>
						<!-- 布局用**外层三栏 grid**：第 1 栏（封面图 + 其下方的「封面路径」「密码提示」）与
						     第 2、3 栏（表单，内部再分两列）宽度由网格自动保证相等 ——
						     不要再改成固定像素宽度（试过 157/152/150px，实测左栏 148 vs 右栏 156，永远差几像素）。
						     第 1 栏用 mt-4 / mt-2 逐个控制间距，让两个输入框分别落在第 3、4 行
						     （封面图下边 460 + 16 = 476；封面路径输入框下边 527 + 8 = 535）✓ -->
						<div class="grid grid-cols-1 gap-2.5 sm:grid-cols-3">
							<div class="flex flex-col">
								<div class="relative mx-auto">
									<div
										id="ge-cover-preview"
										class="relative grid h-[104px] w-[104px] place-items-center overflow-hidden rounded-xl bg-gradient-to-br from-(--primary)/35 to-(--primary)/5 text-center text-[9px] leading-tight text-neutral-500 dark:text-neutral-400"
									>
									</div>
								</div>
								<label class="ge-field mt-4 flex flex-col gap-1">
									<span class="text-[11px] font-medium text-neutral-500 dark:text-neutral-400"
										>封面路径</span
									>
									<input
										data-f="cover"
										type="text"
										placeholder="/gallery/xx/cover.jpg"
										class="w-full rounded-lg border border-(--line-divider) px-2.5 py-1.5 text-sm text-neutral-900 outline-none transition-all focus:border-(--primary) focus:ring-1 focus:ring-(--primary)/40 dark:text-neutral-100"
									/>
								</label>
								<label class="ge-field mt-2 flex flex-col gap-1">
									<span class="text-[11px] font-medium text-neutral-500 dark:text-neutral-400"
										>密码提示（可选）</span
									>
									<input
										data-f="passwordHint"
										type="text"
										placeholder="提示语"
										class="w-full rounded-lg border border-(--line-divider) px-2.5 py-1.5 text-sm text-neutral-900 outline-none transition-all focus:border-(--primary) focus:ring-1 focus:ring-(--primary)/40 dark:text-neutral-100"
									/>
								</label>
								<input
									id="ge-cover-input"
									type="file"
									accept="image/*"
									tabindex="-1"
									class="hidden"
								/>
							</div>
							<!-- 字段按**行优先**排列（grid-cols-2 逐行填充）：
							     相册名称 | 日期 / 相册 ID | 标签 / 描述 | 拍摄地点 / 访问密码 -->
							<div class="grid grid-cols-1 gap-2.5 sm:col-span-2 sm:grid-cols-2">
								<label class="ge-field flex flex-col gap-1">
									<span class="text-[11px] font-medium text-neutral-500 dark:text-neutral-400"
										>相册名称</span
									>
									<input
										data-f="name"
										type="text"
										placeholder="如 2026 旅行日记"
										class="w-full rounded-lg border border-(--line-divider) px-2.5 py-1.5 text-sm text-neutral-900 outline-none transition-all focus:border-(--primary) focus:ring-1 focus:ring-(--primary)/40 dark:text-neutral-100"
									/>
								</label>
								<label class="ge-field flex flex-col gap-1">
									<span class="text-[11px] font-medium text-neutral-500 dark:text-neutral-400"
										>日期（可选）</span
									>
									<input
										data-f="date"
										type="date"
										class="w-full rounded-lg border border-(--line-divider) px-2.5 py-1.5 text-sm text-neutral-900 outline-none transition-all focus:border-(--primary) focus:ring-1 focus:ring-(--primary)/40 dark:text-neutral-100"
									/>
								</label>
								<label class="ge-field flex flex-col gap-1">
									<span class="text-[11px] font-medium text-neutral-500 dark:text-neutral-400"
										>相册 ID（创建后不可改）</span
									>
									<input
										data-f="id"
										type="text"
										readonly
										placeholder="如 travel-2026"
										class="w-full rounded-lg border border-(--line-divider) px-2.5 py-1.5 text-sm text-neutral-900 outline-none transition-all dark:text-neutral-100"
									/>
								</label>
								<label class="ge-field flex flex-col gap-1">
									<span class="text-[11px] font-medium text-neutral-500 dark:text-neutral-400"
										>标签（逗号分隔）</span
									>
									<input
										data-f="tags"
										type="text"
										placeholder="旅行, 风景"
										class="w-full rounded-lg border border-(--line-divider) px-2.5 py-1.5 text-sm text-neutral-900 outline-none transition-all focus:border-(--primary) focus:ring-1 focus:ring-(--primary)/40 dark:text-neutral-100"
									/>
								</label>
								<label class="ge-field flex flex-col gap-1">
									<span class="text-[11px] font-medium text-neutral-500 dark:text-neutral-400"
										>描述（可选）</span
									>
									<input
										data-f="description"
										type="text"
										placeholder="一句话描述"
										class="w-full rounded-lg border border-(--line-divider) px-2.5 py-1.5 text-sm text-neutral-900 outline-none transition-all focus:border-(--primary) focus:ring-1 focus:ring-(--primary)/40 dark:text-neutral-100"
									/>
								</label>
								<label class="ge-field flex flex-col gap-1">
									<span class="text-[11px] font-medium text-neutral-500 dark:text-neutral-400"
										>拍摄地点（可选）</span
									>
									<input
										data-f="location"
										type="text"
										placeholder="如 杭州"
										class="w-full rounded-lg border border-(--line-divider) px-2.5 py-1.5 text-sm text-neutral-900 outline-none transition-all focus:border-(--primary) focus:ring-1 focus:ring-(--primary)/40 dark:text-neutral-100"
									/>
								</label>
								<label class="ge-field flex flex-col gap-1">
									<span class="text-[11px] font-medium text-neutral-500 dark:text-neutral-400"
										>访问密码（可选）</span
									>
									<input
										data-f="password"
										type="text"
										placeholder="留空不加密"
										class="w-full rounded-lg border border-(--line-divider) px-2.5 py-1.5 text-sm text-neutral-900 outline-none transition-all focus:border-(--primary) focus:ring-1 focus:ring-(--primary)/40 dark:text-neutral-100"
									/>
								</label>
							</div>
						</div>
					</div>
				</div>

				<!-- 面板 B：图片（网格；编辑态时第一格是「＋ 添加图片」） -->
				<div
					id="ge-panel-photos"
					class="ge-panel-flex ge-scroll hidden h-[340px] grow flex-col overflow-y-auto pl-5 pr-[8px]"
					style="overscroll-behavior: contain;"
				>
					<!-- ⚠️ 卡片必须 shrink-0：它是面板 flex 列容器的子项，默认 flex-shrink:1 会被
					     压回容器高度 ⇒ 网格内容溢出但面板 scrollHeight 不变 ⇒ "看着被截了却滚不动"。 -->
					<div
						class="card-base my-3 flex min-h-[calc(100%-1.5rem)] w-full shrink-0 flex-col rounded-xl border border-(--line-divider) p-4"
					>
						<div id="ge-photo-hint" class="mb-2 shrink-0 text-xs text-neutral-400 dark:text-neutral-500">
						</div>
						<div id="ge-photo-grid" class="grid grid-cols-3 gap-2"></div>
						<div
							id="ge-photo-empty"
							class="hidden grow flex-col items-center justify-center text-center text-xs text-neutral-400 dark:text-neutral-500"
							>
							<!-- 文案由脚本切换：真的没照片 ↔ 快照里没有这个相册的数据 -->
							<span data-empty-text>这个相册还没有照片</span>
							</div>
					</div>
				</div>
			</div>
		</div>

		<!-- 底部操作条（固定） -->
		<div class="flex shrink-0 items-center gap-2 border-t border-(--line-divider) px-5 py-3.5">
			<button
				id="ge-add"
				type="button"
				class="cursor-pointer rounded-xl border border-dashed border-(--line-divider) px-3.5 py-2 text-sm font-medium text-neutral-600 transition-colors hover:border-(--primary)/50 hover:bg-(--primary)/5 hover:text-(--primary) dark:text-neutral-300"
			>
				+ 新建相册
			</button>
			<div class="ml-auto flex items-center gap-1.5">
				<button
					id="ge-del-album"
					type="button"
					class="hidden cursor-pointer rounded-xl border border-red-500/40 px-3.5 py-2 text-sm font-medium text-red-500 transition-colors hover:bg-red-500/10"
				>
					删除相册
				</button>
				<button
					id="ge-done"
					type="button"
					class="cursor-pointer rounded-xl border border-(--line-divider) px-4 py-2 text-sm font-medium text-neutral-600 transition-colors hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-700"
				>
					关闭
				</button>
			</div>
		</div>
	</div>
</div>

<!-- ── 上传弹窗（独立浮层：本地上传 + 外链清单） ── -->
<!-- 遮罩不加背景色也不加 blur（规范 2-1；与友链/动态的二次确认框同款），blur 只在面板自身 -->
<div
	id="ge-upload"
	class="fixed inset-0 z-[1000] hidden items-center justify-center p-4"
	style="overscroll-behavior: contain;"
	role="dialog"
	aria-modal="true"
	aria-label="添加图片"
>
	<!-- ⚠️ 宽高**固定**（副弹窗规范：尺寸不得随内容变化，且必须**明显小于**主弹窗 720×max-h-[92vh]）：
	     固定 500×440（宽约为主弹窗的 70%、高约 86%），小屏用 max-w/max-h 兜底；
	     待提交清单只在右栏内部滚动，不会拉伸整个弹窗 -->
	<div
		class="card-base flex h-[410px] max-h-[80vh] w-full max-w-[500px] flex-col overflow-hidden border border-(--line-divider) shadow-2xl backdrop-blur-sm"
	>
		<div class="flex shrink-0 items-start justify-between gap-3 border-b border-(--line-divider) px-5 py-3.5">
			<div class="min-w-0">
				<div class="text-base font-bold text-neutral-900 dark:text-neutral-100">添加图片</div>
				<div
					id="ge-upload-sub"
