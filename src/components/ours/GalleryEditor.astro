					: '<span class="px-1">' +
						(ro ? "暂无封面" : isNew ? "新建后<br />可上传封面" : "点击上传封面") +
						"</span>";
				// 封面地址 / 只读态 / 新建态都没变就不重画 ⇒ 封面大图不重新加载
				var coverSig = cov + "|" + (ro ? "1" : "0") + "|" + (isNew ? "1" : "0");
				if (coverSig !== lastCoverSig) {
					lastCoverSig = coverSig;
