			state.busy = !!on;
			state.busyLabel = on && label ? label : "";
			render();
		}

		/* ═══════════════ 滚动锁（弹窗/确认框期间，事件拦截版；不用 overflow:hidden） ═══════════════ */

		var scrollLockCount = 0;
		var SCROLL_KEYS = {
			ArrowUp: 1,
			ArrowDown: 1,
			PageUp: 1,
			PageDown: 1,
			Home: 1,
			End: 1,
			" ": 1,
		};
		/**
		 * 阻断"滚动链"：确认框 / 上传弹窗期间不让网页跟着滚。
		 * ⚠️ 必须放行**弹窗内部的滚动容器**（.ge-scroll）—— 否则滚轮会被窗口级 capture 监听整体拦掉，
		 * 表现成"鼠标放在图片页滚不动、只能拖滚动条"（实测踩过）。
		 */
		function inScrollArea(target) {
			return !!(target && target.closest && target.closest(".ge-scroll"));
		}

		function preventScrollInput(e) {
			if (scrollLockCount <= 0) return;
			if (inScrollArea(e.target)) return;
			e.preventDefault();
		}

		function preventScrollKey(e) {
			if (scrollLockCount <= 0 || !SCROLL_KEYS[e.key]) return;
			if (inScrollArea(e.target)) return;
			e.preventDefault();
		}
		function lockPageScroll() {
			scrollLockCount++;
			if (scrollLockCount > 1) return;
			window.addEventListener("wheel", preventScrollInput, { passive: false, capture: true });
			window.addEventListener("touchmove", preventScrollInput, { passive: false, capture: true });
			window.addEventListener("keydown", preventScrollKey, { capture: true });
		}
		function unlockPageScroll() {
			if (scrollLockCount > 0) scrollLockCount--;
			if (scrollLockCount > 0) return;
			scrollLockCount = 0;
			window.removeEventListener("wheel", preventScrollInput, { capture: true });
			window.removeEventListener("touchmove", preventScrollInput, { capture: true });
			window.removeEventListener("keydown", preventScrollKey, { capture: true });
		}

		/* ═══════════════ 站内确认框 ═══════════════ */

		function askConfirm(text, opts) {
			opts = opts || {};
			var kind = opts.kind || "danger";
			var skin = CONFIRM_SKINS[kind] || CONFIRM_SKINS.danger;
			confirmTitleEl.textContent = opts.title || "请确认";
			confirmTextEl.textContent = text;
			confirmOkBtn.textContent = "确定";
			confirmCancelBtn.textContent = "取消";
			confirmOkBtn.style.backgroundColor = skin.btn;
			confirmIconEl.style.color = skin.fg;
			for (var i = 0; i < confirmIcons.length; i++) {
				confirmIcons[i].classList.toggle(
					"hidden",
					confirmIcons[i].getAttribute("data-kind") !== kind,
				);
			}
			confirmEl.classList.remove("hidden");
			confirmEl.classList.add("flex");
			// ⚠️ 确认框期间必须锁住页面滚动（与动态/友链一致）——
			// 遗漏会导致"确认框弹出后鼠标滚轮还能滚网页"（用户实测报障过）。
			lockPageScroll();
			try {
				confirmCancelBtn.focus({ preventScroll: true });
			} catch (e) {
				/* ignore */
			}
			return new Promise(function (resolve) {
				confirmResolve = resolve;
			});
		}

		function settleConfirm(result) {
			if (!confirmResolve) return;
			var resolve = confirmResolve;
			confirmResolve = null;
			confirmEl.classList.add("hidden");
			confirmEl.classList.remove("flex");
			unlockPageScroll(); // 无条件解锁（与动态/友链同一套）
			resolve(result);
		}

		/* ═══════════════ GitHub Contents API ═══════════════ */

		function apiHeaders(token) {
			return {
				Authorization: "token " + token,
				Accept: "application/vnd.github.v3+json",
				"Content-Type": "application/json",
			};
		}
		function contentsUrl(repo, path) {
			return (
				"https://api.github.com/repos/" +
				repo +
				"/contents/" +
				path.split("/").map(encodeURIComponent).join("/")
			);
		}

		/**
		 * 带超时的 GitHub 请求。⚠️ 必须有超时：否则网络挂起时 fetch 会一直 pending，
		 * `state.busy` 永远不恢复 ⇒ 上传弹窗的「取消」点不动、网页滚动被锁死
		 * （用户实测："点了上传后无法关闭弹窗、整个网页不能操作"）。
		 */
		var GH_TIMEOUT_MS = 20000;
		function ghFetch(url, opts) {
			opts = opts || {};
			try {
				if (typeof AbortSignal !== "undefined" && AbortSignal.timeout)
					opts.signal = AbortSignal.timeout(GH_TIMEOUT_MS);
			} catch (e) {
				/* 老浏览器不支持 ⇒ 退化为不设超时 */
			}
			return fetch(url, opts);
		}
		function requireToken() {
			var c = cfg();
			if (!c.token) {
				return null;
			}
			return c;
		}

		/**
		 * GitHub API 失败的**全站统一**提示 —— 只分两类（相册 / 友链 / 动态三个编辑器同一套口径）：
		 *  ① Token 类（401 / 403）⇒ 返回**唯一那一句**（用户只需去更新 Token）；
		 *  ② 其它（404 / 409 / 5xx / 网络）⇒ 返回 ""，由调用方补上动作名。
		 * ⚠️ 相册早先**完全没有** 401/403 判断 ⇒ Token 过期时只会显示"读取失败（HTTP 401）"。
		 */
		function tokenHint(res) {
			if (res.status === 401 || res.status === 403)
				return "Token 无效或已过期，请到编辑器页更新后再试。";
			return "";
		}

		function getFile(c, path) {
			return ghFetch(contentsUrl(c.repo, path) + "?ref=" + encodeURIComponent(c.branch), {
				headers: apiHeaders(c.token),
			}).then(function (res) {
				if (res.status === 404) return { missing: true, sha: "", content: "" };
				if (!res.ok)
					throw new Error(tokenHint(res) || "读取失败，请点「刷新」后重试。");
				return res.json().then(function (j) {
					return { sha: j.sha || "", content: j.content ? fromB64(j.content) : "", missing: false };
				});
			});
		}
		function listDir(c, dir) {
			return ghFetch(contentsUrl(c.repo, dir) + "?ref=" + encodeURIComponent(c.branch), {
				headers: apiHeaders(c.token),
			}).then(function (res) {
				if (res.status === 404) return [];
				if (!res.ok)
					throw new Error(tokenHint(res) || "读取失败，请点「刷新」后重试。");
				return res.json().then(function (j) {
					return Array.isArray(j) ? j : [];
				});
			});
		}
		function putFile(c, path, text, sha, message) {
			var body = { message: message, content: toB64(text), branch: c.branch };
			if (sha) body.sha = sha;
			return ghFetch(contentsUrl(c.repo, path), {
				method: "PUT",
				headers: apiHeaders(c.token),
				body: JSON.stringify(body),
			}).then(function (res) {
				if (!res.ok) throw new Error(tokenHint(res) || "提交失败，请重试。");
				return res.json();
			});
		}
		function putFileRaw(c, path, base64, sha, message) {
			var body = { message: message, content: base64, branch: c.branch };
			if (sha) body.sha = sha;
			return ghFetch(contentsUrl(c.repo, path), {
				method: "PUT",
				headers: apiHeaders(c.token),
				body: JSON.stringify(body),
			}).then(function (res) {
				if (!res.ok) throw new Error(tokenHint(res) || "上传失败，请重试。");
				return res.json();
			});
		}
		function deleteFile(c, path, sha, message) {
			return ghFetch(contentsUrl(c.repo, path), {
				method: "DELETE",
				headers: apiHeaders(c.token),
				body: JSON.stringify({ message: message, sha: sha, branch: c.branch }),
			}).then(function (res) {
				if (!res.ok) throw new Error(tokenHint(res) || "删除失败，请重试。");
				return true;
			});
		}

		/* ═══════════════ 相册数据：解析 / 渲染 ═══════════════ */

		function normalizeAlbum(raw) {
			return {
				id: String(raw.id == null ? "" : raw.id),
				name: String(raw.name == null ? "" : raw.name),
				description: String(raw.description == null ? "" : raw.description),
				location: String(raw.location == null ? "" : raw.location),
				date: String(raw.date == null ? "" : raw.date),
				tags: Array.isArray(raw.tags) ? raw.tags.map(String) : [],
				cover: String(raw.cover == null ? "" : raw.cover),
				password: String(raw.password == null ? "" : raw.password),
				passwordHint: String(raw.passwordHint == null ? "" : raw.passwordHint),
			};
		}

		/**
		 * 相册名称 → 相册 ID（URL 与目录名）：空白转连字符，只保留字母/数字/中文/连字符/下划线。
		 * 与 validateAlbum 的校验规则一致 ⇒ 自动生成的结果一定合法。
		 */
		function slugifyAlbumId(name) {
			return String(name == null ? "" : name)
				.trim()
				.replace(/\s+/g, "-")
				.replace(/[^\w\u4e00-\u9fa5-]/g, "")
