		var urlsEl = document.getElementById("ge-urls");
		var btnSaveUrls = document.getElementById("ge-save-urls");
		var confirmEl = document.getElementById("ge-confirm");
		var confirmIconEl = document.getElementById("ge-confirm-icon");
		var confirmTitleEl = document.getElementById("ge-confirm-title");
		var confirmTextEl = document.getElementById("ge-confirm-text");
		var confirmOkBtn = document.getElementById("ge-confirm-ok");
		var confirmCancelBtn = document.getElementById("ge-confirm-cancel");
		var confirmIcons = confirmIconEl ? confirmIconEl.querySelectorAll("svg[data-kind]") : [];
