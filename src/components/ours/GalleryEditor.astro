			var ro = state.editing === null;
			var a = isNew ? normalizeAlbum({}) : currentAlbum() || normalizeAlbum({});
			// ⚠️ 只在"换相册 / 进出编辑态 / 数据真的变了"时才回填表单 ——
			// 否则 setBusy() → render() → fillInfo() 会把用户正在输入、还没提交的内容冲掉。
			var infoSig = state.selected + "|" + String(state.editing) + "|" + JSON.stringify(a);
			if (infoSig !== lastInfoSig) {
