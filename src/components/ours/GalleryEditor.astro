			for (var ki = 0; ki < restKeys.length; ki++) {
				var fe = fieldEl(restKeys[ki]);
				if (fe) fe.readOnly = ro;
			}

			// 一个相册都没有、也不在新建态 ⇒ 右侧显示空态（与动态弹窗同款）
			var hasTarget = isNew || !!currentAlbum();
			if (infoFormEl) infoFormEl.classList.toggle("hidden", !hasTarget);
			if (infoEmptyEl) {
				infoEmptyEl.classList.toggle("hidden", hasTarget);
				infoEmptyEl.classList.toggle("flex", !hasTarget);
			}

			// 封面：编辑态时可点击上传（用户要求"点编辑后封面图可以点击 ⇒ 点击就是上传封面图"）
			if (coverPreviewEl) {
				coverPreviewEl.classList.toggle("cursor-pointer", !ro);
				coverPreviewEl.title = ro ? "" : "点击上传封面";
			}
		}

		/** 总渲染入口：左列 + 信息面板 + 图片面板 + Tab 状态 + 操作区 */
		function render() {
			renderNav();
			renderInfo();
			renderPhotoPanel();
			applyTab();
			applyActions();
			// 待提交清单 / 「提交」按钮文案要跟着 busy 状态走（过程文案显示在按钮上）
			renderStagedList();
			updateSubtitle();
			// 「删除相册」：没有选中相册（或正在编辑 / 新建）时不显示
			if (btnDelAlbum)
				btnDelAlbum.classList.toggle(
					"hidden",
					!state.selected || state.editing !== null || state.busy,
				);
			if (btnAdd) btnAdd.disabled = state.busy || state.editing !== null;
		}

		/** 左列：按搜索词过滤后的相册列表（新建态顶部多一个「新建相册」项） */
		function renderNav() {
			var q = searchEl ? String(searchEl.value || "").trim().toLowerCase() : "";
			var list = state.albums.filter(function (a) {
				if (!q) return true;
				var hay = [
					a.name || "",
					a.id,
					a.location || "",
					a.description || "",
					(a.tags || []).join(" "),
				]
					.join(" ")
					.toLowerCase();
				return hay.indexOf(q) >= 0;
			});
			var html = state.editing === "" ? navNewHtml() : "";
			html += list.map(navItemHtml).join("");
			if (navEl) navEl.innerHTML = html;
			if (emptyEl) {
				// 两种空态：① 一个相册都没有；② 搜索词没匹配上（早先只判断 ①，
				// 搜不到时左列一片空白、没有任何提示，用户会以为相册丢了）
				var noAlbums = state.albums.length === 0 && state.editing !== "";
				var noMatch = !!q && state.albums.length > 0 && list.length === 0;
				var show = noAlbums || noMatch;
				emptyEl.classList.toggle("hidden", !show);
				emptyEl.classList.toggle("flex", show);
				var txt = emptyEl.querySelector("[data-empty-text]");
				if (txt)
					txt.textContent = noMatch
						? "没有匹配的相册，换个关键词试试。"
						: "还没有相册，点下方「+ 新建相册」创建第一个。";
			}
		}

		/**
		 * 图片总数：**不含封面文件**，与前台相册页的"张数"口径一致
		 * （上游 scanAlbumPhotos 会把 cover.* 排除在照片列表外）。
		 * 外链图片计入（它确实是相册里的一张图）。
		 */
		function photoTotal() {
			// ⚠️ **不含封面文件**：与前台相册页保持一致（上游 scanAlbumPhotos 会把 cover.*
			// 排除掉，页面显示的张数从来不含封面）⇒ 弹窗用同一口径，避免两边数字对不上。
			var locals = state.photoFiles.filter(function (f) {
				return IMG_RE.test(f.name) && !COVER_RE.test(f.name);
			});
			return locals.length + (state.remotePhotos || []).length;
		}

		/* ═══════════════ 内嵌快照（读取零请求） ═══════════════ */

		/**
		 * 用内嵌快照填充当前相册的照片数据。
		 * 构造出的条目与 listDir 返回的**同构**（name / path / sha / type），
		 * 但 **sha 留空** —— 构建时无法预知 sha，需要 sha 的写操作（删照片 / 清空清单）
		 * 已改为操作时当场获取。
		 */
		function applyEmbeddedPhotos() {
			if (!state.selected) return;
			var m = state.photoManifest[state.selected];
			if (!m) {
				// 快照里没有这个相册（例如刚在网站端建的相册、尚未重新构建）
				state.photoFiles = [];
				state.remotePhotos = [];
				renderPhotoPanel();
				syncPhotoCount();
				return;
			}
			state.photoFiles = (m.files || []).map(function (name) {
				return {
					name: name,
					path: PHOTO_DIR + "/" + state.selected + "/" + name,
					sha: "",
					type: "file",
				};
			});
			state.remotePhotos = (m.urls || []).slice();
			renderPhotoPanel();
			syncPhotoCount();
		}

		/** 确保当前相册的照片数据已就绪（幂等：同一个相册只应用一次） */
		function ensurePhotoData() {
			if (!state.selected) return;
			if (state.loadedFor === state.selected) return;
			state.loadedFor = state.selected;
			applyEmbeddedPhotos();
		}

		/**
		 * 把当前照片数据回写进内存快照。
		 * 上传 / 删除 / 刷新之后调用，保证"切到别的相册再切回来"看到的仍是刚操作过的最新状态
		 * （否则会退回构建时的旧快照）。
		 */
		function snapshotCurrent() {
			if (!state.selected) return;
			var files = (state.photoFiles || [])
				.filter(function (f) {
					return f && IMG_RE.test(f.name) && !COVER_RE.test(f.name);
				})
				.map(function (f) {
					return f.name;
				});
			state.photoManifest[state.selected] = {
				files: files,
				urls: (state.remotePhotos || []).slice(),
			};
		}

		/**
		 * 重算左列张数（口径与 photoTotal 完全一致）。
		 * ⚠️ 拉目录（reloadPhotos）与拉外链（loadUrls）是**并行**发出的 ⇒
		 * 早先只在拉目录成功后算一次，会把"外链还没到"的数字写成最终值且不再自愈；
		 * 现在两处回调各调一次 ⇒ 无论谁先返回，最终都以"两边都齐"的数据收敛。
		 */
		function syncPhotoCount() {
			if (!state.selected) return;
			var t = photoTotal();
			if (state.photoCounts[state.selected] !== t) {
				state.photoCounts[state.selected] = t;
				renderNav();
			}
		}

		/** 乐观写入快照（上传成功后立刻生效，即使随后的校正请求失败也不丢） */
		function addManifestFile(albumId, fileName) {
			if (!albumId || !fileName) return;
			var m = state.photoManifest[albumId];
			if (!m) m = state.photoManifest[albumId] = { files: [], urls: [] };
			if (!m.files) m.files = [];
			if (m.files.indexOf(fileName) < 0) m.files.push(fileName);
		}

		/** 从快照移除一个文件名（删除成功后立刻生效） */
		function removeManifestFile(albumId, fileName) {
			var m = state.photoManifest[albumId];
			if (!m || !m.files) return;
			var i = m.files.indexOf(fileName);
			if (i >= 0) m.files.splice(i, 1);
		}

		/** Tab 切换：两个面板互斥显示 + Tab 高亮 */
		function applyTab() {
			var isPhotos = state.tab === "photos";
			if (panelInfoEl) panelInfoEl.classList.toggle("hidden", isPhotos);
			if (panelPhotosEl) panelPhotosEl.classList.toggle("hidden", !isPhotos);
			if (tabInfoEl) tabInfoEl.setAttribute("data-active", isPhotos ? "0" : "1");
			if (tabPhotosEl) tabPhotosEl.setAttribute("data-active", isPhotos ? "1" : "0");
		}

		/**
		 * Tab 栏右侧的操作区 —— 按 Tab 分区（用户要求：「编辑 / 提交」只管基本信息）。
		 *  ·「基本信息」：只读 ⇒「编辑」；编辑中 ⇒「取消 / 提交」（管相册元数据）
		 *  ·「图片管理」：只「刷新」—— 图片操作（添加 / 设封面 / 删除）是**点击即生效**的，
		 *    不需要提交态，所以这里不出现「编辑 / 提交」。
		 * 编辑态下 setTab() 禁止切到图片 Tab ⇒ 这个分支不会遇到"编辑中"。
		 */
		function applyActions() {
			if (!actionsEl) return;
			var busy = state.busy ? " disabled" : "";
			var html = "";
			if (state.tab === "photos") {
				// 「刷新」只要选中了相册就给（早先用 state.photoFiles.length 判断，
				// 导致"只有外链的相册"和"照片还没加载完"时按钮根本不出现）
				// 刷新中把过程文案显示在按钮上（替代原来的蓝色提示条）
				if (state.selected)
					html +=
						'<button type="button" data-act="reload" class="' +
						BTN_CLS +
						'"' +
						busy +
						">" +
						(state.refreshing ? "刷新中…" : "刷新") +
						"</button>";
			} else if (state.editing !== null) {
				html +=
					'<button type="button" data-act="cancel" class="' +
					BTN_CLS +
					'"' +
					busy +
					'>取消</button>';
				html +=
					'<button type="button" data-act="save" class="' +
					BTN_PRIMARY_CLS +
					'"' +
					busy +
					">提交</button>";
			} else if (state.selected) {
				html +=
					'<button type="button" data-act="edit" class="' +
					BTN_CLS +
					'"' +
					busy +
					">编辑</button>";
			}
			actionsEl.innerHTML = html;
		}

		function updateSubtitle() {
			if (!subtitleEl) return;
			if (state.editing === "") {
				subtitleEl.textContent = "新建中，填好后点「提交」";
				return;
			}
			var a = currentAlbum();
			if (a) {
				subtitleEl.textContent =
					(a.name || a.id) +
					(state.tab === "photos" ? " · public/gallery/" + a.id + "/" : "") +
					(state.editing !== null ? " · 编辑中" : "");
				return;
			}
			subtitleEl.textContent = "";
		}

		/** 选中某个相册（编辑中有未提交改动时先弹放弃确认，避免静默丢弃） */
		function selectAlbum(id) {
			// 左列的「新建相册」项（data-nav=""）不可点选，避免把新建态切走
			if (id === "") return;
			if (id === state.selected && state.editing !== "") return;
			if (state.editing !== null && state.editing !== id) {
				// 弹确认（不再用悬浮提示条拦人）；确认放行后 editing 已归零 ⇒ 递归走正常流程
				confirmLeaveEdit().then(function (ok) {
					if (ok) selectAlbum(id);
				});
				return;
			}
			state.selected = id;
			state.editing = null;
			clearPendingCover();
			state.photoFiles = [];
			state.remotePhotos = [];
			state.loadedFor = ""; // 换了相册 ⇒ 照片/外链数据作废，需重新拉
			if (queueEl) {
				queueEl.classList.add("hidden");
				queueEl.innerHTML = "";
			}
			if (photoGridEl) photoGridEl.innerHTML = "";
			resetRenderCache(); // 网格刚被清空，必须让签名失效
			render();
			if (state.tab === "photos") {
				// 零请求：直接用内嵌快照渲染（不再 reloadPhotos + loadUrls）
				ensurePhotoData();
			}
		}

		/** 切换 Tab */
		function setTab(tab) {
			if (tab === state.tab) return;
			// ⚠️ 编辑态只作用于「基本信息」：切到图片 Tab 会没有「取消 / 提交」按钮 ⇒
			// 先弹「放弃未提交的修改？」（用户要求用弹窗，不用悬浮提示条）；
			// 确认放行后 editing 已归零 ⇒ 递归走正常流程
			if (state.editing !== null && tab !== "info") {
				confirmLeaveEdit().then(function (ok) {
					if (ok) setTab(tab);
				});
				return;
			}
			state.tab = tab;
			// 切过去时补画目标面板（否则 applyTab 只切显隐，面板内容还是旧的）
			if (tab === "photos") {
				// 零请求：内嵌快照渲染（同一个相册只应用一次，来回切 Tab 不发任何请求）
				ensurePhotoData();
			} else {
				renderInfo();
			}
			applyTab();
			applyActions();
			updateSubtitle();
		}

		/* ═══════════════ 打开 / 关闭弹窗 ═══════════════ */

		function openModal() {
			state.tab = "info";
			state.editing = null;
			state.dirty = false;
			// 每次打开都重新应用快照 ⇒ 清掉"已加载"标记与渲染签名缓存
			state.loadedFor = "";
			resetRenderCache();
			// 打开即选中第一个相册（让右侧立刻有内容，而不是空白）
			if (!state.selected && state.albums.length) state.selected = state.albums[0].id;
			render();
			mask.classList.remove("hidden");
			mask.classList.add("flex");
			// ⚠️ 打开弹窗**不发任何请求**（相册列表 / 张数 / 照片清单全部已内嵌）⇒ 秒开。
			// 需要最新数据时点「刷新」（唯一主动拉取入口）。
			// ⚠️ 主弹窗**不锁**页面滚动（项目铁律：主弹窗打开时鼠标移出去仍能滚网页）；
			// 只有"确认框 / 上传弹窗"这类二次浮层才锁。
			if (!cfg().token && subtitleEl)
				subtitleEl.textContent = "只读：未配置 Token";
			try {
				var closeBtn = document.getElementById("ge-close");
				if (closeBtn) closeBtn.focus({ preventScroll: true });
			} catch (e) {
				/* ignore */
			}
		}

		function doClose() {
			closeUpload(true);
			mask.classList.add("hidden");
			mask.classList.remove("flex");
			state.editing = null;
			state.dirty = false;
			// 彻底复位滚动锁（主弹窗本身不锁；这里兜底清掉可能残留的计数）
			while (scrollLockCount > 0) unlockPageScroll();
		}

		/** 关闭弹窗（有未提交改动时先确认；沿用动态编辑器那套确认框逻辑） */
		function requestClose(force) {
			if (state.dirty && !force) {
				askConfirm("改动还没提交到云端，放弃后改动会丢失。", {
					title: "放弃未提交的修改？",
					okText: "确定",
					cancelText: "取消",
					kind: "warning",
				}).then(function (ok) {
					if (ok) {
						restoreSaved();
						doClose();
					}
				});
				return;
			}
			doClose();
		}

		/* ═══════════════ 上传弹窗（独立浮层） ═══════════════ */

		function openUpload() {
			// 兜底：入口「＋ 添加图片」格本就只在有选中相册时渲染 ⇒ 这里静默返回即可
			// （不再弹"请先在左侧选择一个相册"——网格空态已经在说同一件事）
			if (!state.selected) return;
			if (uploadSubEl) uploadSubEl.textContent = (currentAlbum() || {}).name || state.selected;
			// ⚠️ 只有"没有正在进行的提交、也没有上次失败的待重试项"时才从空清单开始。
			// 否则保留 —— 提交中点「关闭」跑后台、回来时要能看到进度 / 失败项。
			if (!state.busy && !state.lastCommitFailed) clearStaged();
			if (urlInputEl) urlInputEl.value = "";
			uploadEl.classList.remove("hidden");
			uploadEl.classList.add("flex");
			lockPageScroll();
			// 零请求：照片/外链清单都来自内嵌快照（需要最新时点右上「刷新」）
			ensurePhotoData();
			// 后台提交过 / 留下失败项时，重新打开要把结果与清单对齐一遍
			renderStagedList();
		}

		/**
		 * 关闭上传弹窗。
		 * force=true 用于 swup 切页 / 整体重入：跳过确认、直接收拾干净。
		 * keepStaged=true 用于**提交中**关闭（用户要求：隐藏弹窗、后台继续提交）：
		 *   只隐藏弹窗、**保留清单**（否则失败项被丢弃、用户无从重试）。
		 * ⚠️ 普通关闭即**丢弃**待提交清单（缩略图的 blob 一并释放）。
		 */
		function closeUpload(force, keepStaged) {
			if (!uploadEl || uploadEl.classList.contains("hidden")) return;
			uploadEl.classList.add("hidden");
			uploadEl.classList.remove("flex");
			if (!keepStaged) {
				clearStaged();
				// 用户明确放弃 ⇒ 结果提示也一并清掉（提交中关闭 keepStaged=true 则保留）
				state.stageResult = null;
				state.lastCommitFailed = false;
				if (urlInputEl) urlInputEl.value = "";
			}
			// 焦点会留在入口按钮上，但焦点圈已由 src/styles/main.css 统一抑制
			//（搜「编辑器浮层：统一收掉键盘焦点圈」）⇒ 这里**不再 blur**，
			// 保留"关闭浮层后焦点回到触发按钮"这一可访问性惯例。
			if (!force) unlockPageScroll();
		}

		/**
		 * 用户主动关闭上传弹窗的**唯一入口**（取消按钮 / 右上 × / 点遮罩 / Esc）。
		 * 清单非空 ⇒ 复用站内确认框（与「放弃未提交的修改？」同款）问一句再放弃。
		 * ⚠️ **提交中允许直接关闭**（用户要求）：隐藏弹窗、提交在后台继续，清单留着。
		 */
		function requestCloseUpload() {
			if (!uploadEl || uploadEl.classList.contains("hidden")) return;
			if (state.busy) {
				closeUpload(false, true);
				return;
			}
			if (!(state.stagedUploads || []).length) {
				closeUpload(false);
				return;
			}
			// ⚠️ 文案必须与「基本信息」放弃修改**完全同一句**（MEMORY 2-4 定稿，不许自创）；
			// 确认框的**外貌**（外壳/图标/按钮/尺寸）也一律沿用既定设计，不得改动。
			askConfirm("改动还没提交到云端，放弃后改动会丢失。", {
				title: "放弃未提交的修改？",
				kind: "warning",
			}).then(function (ok) {
				if (ok) closeUpload(false);
			});
		}

		/** 回滚到"已保存"快照（放弃修改用） */
		function restoreSaved() {
			if (state.saved) state.albums = JSON.parse(JSON.stringify(state.saved));
			state.dirty = false;
		}

		/**
		 * 离开编辑态前的**统一守卫**（切 Tab / 切相册 / 关闭弹窗共用）。
		 *  · 不在编辑态 ⇒ 直接放行
		 *  · 在编辑态但没有改动 ⇒ 静默退出编辑态并放行
		 *  · 有未提交改动 ⇒ 弹站内确认框（用户要求：这种场景用**弹窗**，不要用悬浮提示条）
		 * @returns {Promise<boolean>} 是否放行
		 */
		function confirmLeaveEdit() {
			if (state.editing === null) return Promise.resolve(true);
			if (!state.dirty) {
				state.editing = null;
				return Promise.resolve(true);
			}
			return askConfirm("改动还没提交到云端，放弃后改动会丢失。", {
				title: "放弃未提交的修改？",
				kind: "warning",
			}).then(function (ok) {
				if (ok) {
					restoreSaved();
					state.editing = null;
					clearPendingCover();
					render();
				}
				return ok;
			});
		}

		/* ═══════════════ 读取云端数据 ═══════════════ */

		function loadFromRemote() {
			var c = requireToken();
			if (!c) {
				subtitleEl.textContent = "只读：未配置 Token";
				return;
			}
			return getFile(c, CONFIG_PATH)
				.then(function (f) {
					state.baseSha = f.sha;
					if (f.missing) return;
					// 用户在等待期间已经开始编辑 ⇒ 不要用远端数据覆盖，避免吞掉刚落下的改动
					if (state.dirty) return;
					var parsed = [];
					try {
						parsed = JSON.parse(f.content);
					} catch (e) {
						return;
					}
					if (!Array.isArray(parsed)) return;
					state.albums = parsed.map(normalizeAlbum);
					state.saved = JSON.parse(JSON.stringify(state.albums));
					if (!state.selected && state.albums.length) state.selected = state.albums[0].id;
					render();
				})
				.catch(function (e) {
				});
		}

		/* ═══════════════ 保存 / 新建 / 删除 ═══════════════ */

		/** 从信息面板收集当前表单值（新建 / 编辑共用） */
		function collectInfo() {
			function v(key) {
				var el = fieldEl(key);
				return el ? String(el.value || "").trim() : "";
			}
			var tagsRaw = v("tags");
			return normalizeAlbum({
				id: v("id"),
				name: v("name"),
				description: v("description"),
				location: v("location"),
				date: v("date"),
				tags: tagsRaw
					? tagsRaw
							.split(/[,，]/)
							.map(function (s) {
								return s.trim();
							})
							.filter(Boolean)
					: [],
				cover: v("cover"),
				password: v("password"),
				passwordHint: v("passwordHint"),
			});
		}

		function validateAlbum(a, isNew) {
			if (!a.name) return "相册名称不能为空。";
			if (isNew || !a.id) {
				if (!a.id) return "相册 ID 不能为空。";
				if (!/^[\w\u4e00-\u9fa5-]+$/.test(a.id))
					return "相册 ID 只能包含字母、数字、中文、连字符和下划线。";
				if (
					state.albums.some(function (x) {
						return x.id === a.id;
					})
				)
					return "相册 ID「" + a.id + "」已存在，请换一个。";
			}
			if (a.date && !/^\d{4}-\d{2}-\d{2}$/.test(a.date)) return "日期格式应为 YYYY-MM-DD。";
			return "";
		}

		function commitConfig(c, message) {
			var text = albumsToJson(state.albums);
			return getFile(c, CONFIG_PATH)
				.then(function (f) {
					return putFile(c, CONFIG_PATH, text, f.sha || state.baseSha, message);
				})
				.then(function () {
					state.baseSha = "";
					state.saved = JSON.parse(JSON.stringify(state.albums));
				});
		}

		/** 提交信息面板的改动（新建 / 更新） */
		function saveInfo() {
			if (state.busy) return;
			var c = requireToken();
			if (!c) return;
			var isNew = state.editing === "";
			var a = collectInfo();
			var err = validateAlbum(a, isNew);
			if (err) {
				return;
			}
			setBusy(true, "正在写入…");
			var next = state.albums.slice();
			if (isNew) {
				next.push(a);
			} else {
				var idx = -1;
				for (var i = 0; i < next.length; i++) if (next[i].id === a.id) idx = i;
				if (idx >= 0) next[idx] = a;
			}
			state.albums = next;
			var chain = Promise.resolve();
			if (isNew) {
				// ⚠️ 建目录前先看一眼磁盘上有没有同名目录：validateAlbum 只查了**配置里**的 id 重复，
				// 而 public/gallery/<id>/ 可能还在（例如相册从配置里删过、目录没清），
				// 此时新相册会**无声接管**里面已有的照片 ⇒ 先问一句再继续。
				chain = chain.then(function () {
					return listDir(c, PHOTO_DIR + "/" + a.id)
						.then(function (entries) {
							var files = (entries || []).filter(function (x) {
								return x && x.type === "file";
							});
							if (!files.length) return;
							return askConfirm(
								"目录 public/gallery/" +
									a.id +
									"/ 里已经有 " +
									files.length +
									" 个文件，继续创建会把这些文件当成这个新相册的照片。",
								{
									title: "目录已存在，仍要创建？",
									okText: "继续创建",
									cancelText: "取消",
								},
							).then(function (ok) {
								if (!ok) throw new Error(ABORT_CREATE);
							});
						})
						.catch(function (e) {
							// 目录不存在（404）属正常情况 ⇒ 放行；只有"用户点了取消"才中断
							if (e && e.message === ABORT_CREATE) throw e;
						});
				});
				chain = chain.then(function () {
					return putFile(
						c,
						PHOTO_DIR + "/" + a.id + "/.gitkeep",
						"",
						"",
						"chore(gallery): 新建相册目录（" + a.id + "）",
					).catch(function () {
						/* 目录已存在或失败都不阻断配置写入 */
					});
				});
				// 新建时若已选好封面 ⇒ 目录建好后立刻上传，并让配置的 cover 指向它
				// （对齐旧版流程：封面图和相册信息一起提交）
				if (state.pendingCoverFile) {
					var coverFile = state.pendingCoverFile;
					chain = chain.then(function () {
						var ext = (coverFile.name.split(".").pop() || "jpg").toLowerCase();
						var rel = "/gallery/" + a.id + "/cover." + ext;
						var cpath = PHOTO_DIR + "/" + a.id + "/cover." + ext;
						return readB64(coverFile)
							.then(function (b64) {
								if (!b64) return;
								// 目录里可能已存在同名 cover.<ext>（例如同 id 相册被删配置后又重建），
								// 带上 sha 才不会 422
								return getFile(c, cpath).then(function (f) {
									return putFileRaw(
										c,
										cpath,
										b64,
										f.missing ? "" : f.sha || "",
										"feat(gallery): 网站端上传相册封面（" + a.id + "）",
									);
								});
							})
							.then(function () {
								a.cover = rel; // a 已是 state.albums 里的同一个对象 ⇒ 直接生效
							})
							.catch(function () {
							});
					});
				}
			}
			chain
				.then(function () {
					return commitConfig(
						c,
						"feat(gallery): 网站端" +
							(isNew ? "发布" : "更新") +
							"相册（" +
							state.albums.length +
							" 个）",
					);
				})
				.then(function () {
					state.editing = null;
					state.dirty = false;
					state.selected = a.id; // 新建成功后选中它，右侧继续可管理
					// 清理新建态暂存的封面
					if (state.pendingCoverUrl) URL.revokeObjectURL(state.pendingCoverUrl);
					state.pendingCoverFile = null;
					state.pendingCoverUrl = "";
					setBusy(false);
					render();
				})
				.catch(function (e) {
					state.albums = state.saved ? JSON.parse(JSON.stringify(state.saved)) : state.albums;
					setBusy(false);
					render();
					// 用户在"目录已存在"确认框里主动取消 ⇒ 回滚后静默退出，不报错
					if (e && e.message === ABORT_CREATE) {
						return;
					}
				});
		}

		function deleteAlbum(a) {
			if (state.busy) return;
			var c = requireToken();
			if (!c) return;
			// 确认框文案统一格式：「xxx」+ 一句陈述（与友链/动态保持一致，只换「」里的内容）
			askConfirm("「" + (a.name || a.id) + "」这个相册将被删除。", {
				title: "删除这个相册？",
				kind: "danger",
			}).then(function (ok) {
				if (!ok) return;
				setBusy(true, "正在删除照片…");
				var dir = PHOTO_DIR + "/" + a.id;
				listDir(c, dir)
					.then(function (entries) {
						var files = (entries || []).filter(function (x) {
							return x && x.type === "file";
						});
						// 顺序删除，任一失败即中止（此时配置尚未改动，可重试）
						return files.reduce(function (p, f) {
							return p.then(function () {
								return deleteFile(
									c,
									f.path,
									f.sha,
									"chore(gallery): 删除相册照片（" + a.id + "）",
								);
							});
						}, Promise.resolve());
					})
					.then(function () {
						state.albums = state.albums.filter(function (x) {
							return x.id !== a.id;
						});
						return commitConfig(c, "feat(gallery): 网站端删除相册（" + a.id + "）");
					})
					.then(function () {
						setBusy(false);
						render();
					})
					.catch(function (e) {
						setBusy(false);
						render();
					});
			});
		}

		/* ═══════════════ 照片管理（视图 B） ═══════════════ */

		function reloadPhotos() {
			var c = cfg();
			if (!c.token) {
				return;
			}
			// ⚠️ 捕获发起时的相册：请求返回时用户可能已切走 ⇒ 若不判断，会把 A 相册的
			// 数据写进 B 相册（污染内存快照与左列张数）。
			var target = state.selected;
			if (!target) return;
			var dir = PHOTO_DIR + "/" + target;
			return listDir(c, dir)
				.then(function (entries) {
					if (target !== state.selected) return; // 已切走 ⇒ 丢弃结果
					state.photoFiles = (entries || []).filter(function (x) {
						return x && x.type === "file";
					});
					renderPhotoPanel();
					// 张数与「拉外链」各自收敛一次（早先只在这里算 ⇒ 会把"外链还没到"的数字固化）
					syncPhotoCount();
					snapshotCurrent(); // 回写内存快照 ⇒ 切走再切回看到的仍是最新，不会退回旧快照
					// 封面在"没有 cover 字段"时会回退到第一张照片 ⇒ 照片到齐后要重画封面
					renderInfo();
					renderNav();
				})
				.catch(function (e) {
					if (target !== state.selected) return;
				});
		}

		/** 解析外链清单文本 → 地址数组（跳过空行与 # 注释） */
		function parseRemote(text) {
			return String(text || "")
				.split(/\r?\n/)
				.map(function (s) {
					return s.trim();
				})
				.filter(function (s) {
					return s && s.charAt(0) !== "#";
				});
		}

		/** 图片面板：本地上传的照片 + 外链照片，混排在同一网格里 */
		function renderPhotoPanel() {
			if (!photoGridEl) return;
			// ⚠️ 图片 Tab **不再依赖编辑态**（用户要求：打开即可操作）——
			// 添加图片 / 设为封面 / 删除全部常驻显示。「编辑 / 提交」只属于「基本信息」Tab。
			var base = "/gallery/" + encodeURIComponent(state.selected) + "/";
			var locals = state.photoFiles.filter(function (f) {
				return IMG_RE.test(f.name) && !COVER_RE.test(f.name);
			});
			var remotes = state.remotePhotos || [];
			// ⚠️ 计数**不含封面文件**（与前台相册页口径一致）
			var total = photoTotal();
			var album = currentAlbum() || {};
			var coverField = String(album.cover || "");

			if (photoEmptyEl) {
				// hidden 与 flex 必须成对切（只切 hidden 的话元素是 block，justify-center 不生效）
				// 有选中相册时网格里永远有「＋ 添加图片」格 ⇒ 不算空 ⇒ 只有"没选相册"才提示
				var noPhotos = !state.selected;
				photoEmptyEl.classList.toggle("hidden", !noPhotos);
				photoEmptyEl.classList.toggle("flex", noPhotos);
				// 快照里没有这个相册（如网站端刚建、尚未重新构建）⇒ 给可行动的引导，
				// 而不是误导性的"这个相册还没有照片"
				var emptyTxt = photoEmptyEl.querySelector("[data-empty-text]");
				if (emptyTxt)
					emptyTxt.textContent =
						state.selected && !state.photoManifest[state.selected]
							? "这里没有该相册的照片数据 —— 点右上「刷新」从仓库读取。"
							: "这个相册还没有照片";
			}
			if (photoHintEl) {
				// 正常态不显示「共 N 张」（张数已由 Tab 角标体现，这行是冗余信息）；
				// 只在"没选中相册 / 相册还没保存"这两种需要指引的情况下出现
				var hint = state.selected
					? ""
					: state.editing === ""
						? "相册还没保存 —— 点右上「提交」创建后就能添加图片了。"
						: "请先在左侧选择一个相册";
				photoHintEl.textContent = hint;
				photoHintEl.classList.toggle("hidden", !hint);
			}

			function card(src, label, isRemote, delKey) {
				var isCover = coverField && coverField === src;
				// ⚠️ 高度结构固定：图片区 aspect-4/3 + 名称行 h-8 ⇒ 无论图片是否加载成功、
				// 也无论有没有 ★/🗑 按钮，**每张卡片的总高与名称行位置都完全一致**。
				// self-start：网格行高被容器 min-h 撑满时（照片很少）卡片不跟着被拉长。
				return (
					'<div class="flex flex-col self-start overflow-hidden rounded-xl border border-(--line-divider)">' +
					'<div class="relative grid aspect-4/3 min-h-0 w-full shrink-0 place-items-center overflow-hidden bg-black/5 dark:bg-white/5">' +
					'<img src="' +
					escHtml(src) +
					'" alt="' +
					escHtml(label) +
					'" loading="lazy" class="h-full w-full object-cover" onerror="this.style.visibility=\'hidden\'" />' +
					(isCover
						? '<span class="absolute top-1 left-1 rounded bg-(--primary) px-1 py-0.5 text-[9px] font-medium text-white">封面</span>'
						: "") +
					(isRemote
						? '<span class="absolute top-1 right-1 rounded bg-amber-500/90 px-1 py-0.5 text-[9px] font-medium text-white">外链</span>'
						: "") +
					"</div>" +
					'<div class="flex h-8 shrink-0 items-center gap-1 px-1.5">' +
					'<span class="min-w-0 grow truncate text-[10px] text-neutral-500 dark:text-neutral-400" title="' +
					escHtml(label) +
					'">' +
					escHtml(label) +
					"</span>" +
					(!isCover
						? '<button type="button" data-photo-act="cover" data-src="' +
							escHtml(src) +
							'" title="设为封面" class="shrink-0 cursor-pointer rounded border border-(--line-divider) px-1 py-0.5 text-[9px] text-neutral-600 hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-700">★</button>'
						: "") +
					(state.selected
						? '<button type="button" data-photo-act="del" data-src="' +
							escHtml(src) +
							'" data-key="' +
							escHtml(delKey) +
							'" data-remote="' +
							(isRemote ? "1" : "0") +
							'" title="删除" class="shrink-0 cursor-pointer rounded border border-red-500/40 px-1 py-0.5 text-[9px] text-red-500 hover:bg-red-500/10">' +
							'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><path d="M9 3v1H4v2h16V4h-5V3H9zM6 8v12a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V8H6zm3 2h2v9H9v-9zm4 0h2v9h-2v-9z"></path></svg></button>'
						: "") +
					"</div></div>"
				);
			}

			// ⚠️ 网格内容签名：没变就不重建 innerHTML ——
			// 每张 <img> 重建都会重新解码/请求，而 setBusy() → render() 一次操作就会触发两次。
			var gridSig = [
				state.selected,
				coverField,
				locals
					.map(function (f) {
						return f.name;
					})
					.join(","),
				remotes.join("\n"),
			].join("|");
			if (gridSig === lastGridSig) return;
			lastGridSig = gridSig;

			var html = "";
			// 「＋ 添加图片」固定在第一格（**常驻**：有选中相册就显示，不再要求先点编辑）。
			// 结构与照片卡片**逐字同构**（4:3 图区 + h-8 名称行）⇒ 两者高度天然一致，
			// 且不会因为"网格里没有别的照片"而被拉伸。
			if (state.selected) {
				html +=
					'<button type="button" data-act="upload" class="ge-add-photo" title="添加图片">' +
					'<span class="ge-add-photo-frame">' +
					'<span class="flex flex-col items-center gap-1">' +
					'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>' +
					'<span class="text-[11px]">添加图片</span></span>' +
					"</span>" +
					'<span class="h-8 shrink-0"></span>' +
					"</button>";
			}
			// ⚠️ **不渲染封面文件**（cover.*）：因为它不计入"共 N 张"，渲染出来会让
			// "显示的张数"与"统计数字"对不上。封面只在"基本信息"页的预览里体现 ✓
			locals.forEach(function (f) {
				html += card(base + encodeURIComponent(f.name), f.name, false, f.name);
			});
			remotes.forEach(function (u) {
				html += card(u, u, true, u);
			});
			photoGridEl.innerHTML = html;
		}

		function loadUrls() {
			var c = cfg();
			if (!c.token) return Promise.resolve();
			// 同 reloadPhotos：捕获发起时的相册，返回时若已切走就丢弃，避免串数据
			var target = state.selected;
			if (!target) return Promise.resolve();
			var path = PHOTO_DIR + "/" + target + "/urls.txt";
			return getFile(c, path)
				.then(function (f) {
					if (target !== state.selected) return;
					var text = f.missing ? "" : f.content;
					state.remotePhotos = parseRemote(text);
					renderPhotoPanel();
					// 外链到齐后同样收敛一次张数（与"拉目录"两路收敛 ⇒ 不再漏算外链）
					syncPhotoCount();
					snapshotCurrent();
				})
				.catch(function () {
					if (target !== state.selected) return;
					// ⚠️ 读取失败**不清理**已有数据（原先会把外链文本 / 数组全清空 ⇒
					// 网络抖一下界面上外链就"消失"）。
					// 保留旧值即可 —— 真正的"没有清单"由 404 分支（f.missing）表达。
					renderPhotoPanel();
				});
		}

		/**
		 * 把外链清单文本写入仓库（**提交**与**移除单条外链**共用）。
		 *  · 文本非空 ⇒ 写 urls.txt；文本为空 ⇒ 删掉 urls.txt
		 *  · silent=true 时不弹提示（由调用方统一汇总，避免一次操作弹两条）
		 */
		function writeUrlsText(text, silent) {
			var c = requireToken();
			if (!c || !state.selected) return Promise.resolve();
			var albumId = state.selected;
			var path = PHOTO_DIR + "/" + albumId + "/urls.txt";
			var body = String(text || "")
				.replace(/\r\n/g, "\n")
				.trim();
			// ⚠️ silent=true 时**绝不碰 busy**：该模式由调用方（commitUploads）统一管理忙碌态，
			// 这里再 setBusy(true) 会清空按钮文案，而 silent 分支又不负责恢复 ⇒ 忙碌态被污染、
			// 「取消」按钮一直点不动（实测用户报"点了上传后无法关闭弹窗、网页也不能操作"）。
			if (!silent) setBusy(true, "正在保存外链清单…");
			var chain;
			if (body) {
				chain = getFile(c, path).then(function (f) {
					return putFile(
						c,
						path,
						body + "\n",
						f.sha || "",
						"feat(gallery): 网站端更新外链清单（" + albumId + "）",
					);
				});
			} else {
				// 清空清单：快照模式下拿不到 sha（构建期无法预知）⇒
				// 必须**当场取 sha** 才能删掉仓库里的文件
				chain = getFile(c, path).then(function (f) {
					if (f.missing || !f.sha) return; // 仓库里本来就没有 ⇒ 无需删
					return deleteFile(
						c,
						path,
						f.sha,
						"chore(gallery): 网站端清空外链清单（" + albumId + "）",
					);
				});
			}
			return chain
				.then(function () {
					if (!silent) {
						setBusy(false);
					}
					return loadUrls();
				})
				.catch(function (e) {
					if (!silent) {
						setBusy(false);
					}
					throw e; // 让 silent 的调用方能感知失败并标记该项
				});
		}

		/* ═══════════════ 待提交清单（「添加图片」弹窗） ═══════════════
		   用户要求：选中的本地文件 / 输入的外链**先入队**，点弹窗「提交」才真正写入仓库。
		   队列只存内存，来源仍是构建期快照 ⇒ 打开弹窗依旧**零请求**。
		   每项带稳定 id（行 DOM 用 data-stage-id 定位），避免移除后索引错位。 */

		var stageSeq = 0;

		/** 本地文件入队：只校验、不发请求 */
		function stageFiles(files) {
			var list = Array.prototype.slice.call(files || []);
			if (!list.length) return;
			if (!state.selected) return; // 入口只在有选中相册时可达，静默兜底
			var added = 0;
			var skipped = 0;
			list.forEach(function (f) {
				// 不合格的在入队时就拦掉 —— 否则用户点「提交」才发现被跳过
				if (!IMG_RE.test(f.name || "") || f.size > MAX_UPLOAD_BYTES) {
					skipped++;
					return;
				}
				state.stagedUploads.push({
					id: ++stageSeq,
					kind: "file",
					file: f,
					name: f.name,
					size: f.size,
					thumbUrl: URL.createObjectURL(f),
					status: "ready",
				});
				added++;
			});
			renderStagedList();
			// 入队反馈只靠右栏清单 + 计数（用户要求：不再有任何悬浮提示）
		}

		/**
		 * 外链入队：**支持一次粘贴多条**（一行一个，`#` 开头的行忽略）。
		 * 逐行校验 + 去重 ⇒ 合法的全部入队，最后给一次汇总反馈。
		 * @returns {boolean} 是否有内容被加入
		 */
		function stageUrl(rawText) {
			var lines = String(rawText || "")
				.split("\n")
				.map(function (l) {
					return l.trim();
				})
				.filter(function (l) {
					return l && l.charAt(0) !== "#";
				});
			if (!lines.length) return false;
			if (!state.selected) return false; // 入口只在有选中相册时可达，静默兜底
			var added = 0;
			var dups = 0;
			var bad = 0;
			lines.forEach(function (u) {
				if (!/^https?:\/\//i.test(u)) {
					bad++;
					return;
				}
				var exists =
					(state.remotePhotos || []).indexOf(u) >= 0 ||
					state.stagedUploads.some(function (it) {
						return it.kind === "url" && it.url === u;
					});
				if (exists) {
					dups++;
					return;
				}
				state.stagedUploads.push({ id: ++stageSeq, kind: "url", url: u, status: "ready" });
				added++;
			});
			renderStagedList();
			// 入队反馈只靠右栏清单 + 计数（用户要求：不再有任何悬浮提示）
			return added > 0;
		}

		/** 原地刷新某一项的右侧状态文字（不重建整个清单） */
		function paintStageRow(id, text, tone) {
			if (!queueEl) return;
			var row = queueEl.querySelector('[data-stage-id="' + id + '"]');
			if (!row) return;
			row.style.opacity = tone === "fail" ? "0.6" : "";
			var badge = row.querySelector("[data-stage-status]");
			if (!badge) return;
			badge.textContent = text;
			badge.className =
				"shrink-0 text-[11px] " +
				(tone === "ok"
					? "text-green-600 dark:text-green-400"
					: tone === "fail"
						? "text-red-500"
						: "text-neutral-400");
		}

		/** 渲染待提交清单 + 同步「提交」按钮状态 */
		function renderStagedList() {
			var list = state.stagedUploads || [];
			if (btnUploadCommit) {
				btnUploadCommit.disabled = !list.length || state.busy;
				// 忙碌时把过程文案显示在按钮上；上次有失败项 ⇒「重试 (N)」
				btnUploadCommit.textContent =
					state.busy && state.busyLabel
						? state.busyLabel
						: list.length
							? (state.lastCommitFailed ? "重试 (" : "提交 (") + list.length + ")"
							: "提交";
			}
			// 待上传区的**唯一一处**结果提示：推送中 / 推送成功 / 推送失败
			if (stageResultEl) {
				var rs = state.stageResult;
				if (rs && rs.text) {
					stageResultEl.textContent = rs.text;
					stageResultEl.className =
						"mb-2 shrink-0 rounded-lg px-2.5 py-1.5 text-xs " +
						(rs.tone === "ok"
							? "bg-green-500/12 text-green-700 dark:text-green-400"
							: rs.tone === "fail"
								? "bg-red-500/12 text-red-600 dark:text-red-400"
								: "bg-(--primary)/10 text-(--primary)");
				} else {
					stageResultEl.textContent = "";
					stageResultEl.className = "mb-2 hidden shrink-0 rounded-lg px-2.5 py-1.5 text-xs";
				}
			}
			// 右栏的空态 / 计数。⚠️ 空态模板带 `flex`，必须 hidden/flex 成对切，
			// 否则（带 grow）会一直抢占空间，把上面的清单挤成 0 高 ⇒ 看不见已添加的文件。
			if (stageEmptyEl) {
				stageEmptyEl.classList.toggle("hidden", !!list.length);
				stageEmptyEl.classList.toggle("flex", !list.length);
			}
			if (stageCountEl)
				stageCountEl.textContent = list.length ? list.length + " 项" : "";
			// 提交中「取消」**保持可点**（用户要求：可以关 —— 隐藏弹窗、后台继续提交）；
			// 文案随之改成「关闭」，避免被误读成"中断提交"。
			if (btnUploadDone) {
				btnUploadDone.disabled = false;
				btnUploadDone.textContent = state.busy ? "关闭" : "取消";
			}
			if (urlInputEl) urlInputEl.disabled = state.busy;
			if (btnUrlAdd) btnUrlAdd.disabled = state.busy;
			if (!queueEl) return;
			if (!list.length) {
				queueEl.innerHTML = "";
				return;
			}
			var html = "";
			list.forEach(function (it) {
				var isFile = it.kind === "file";
				var label = isFile ? it.name : it.url;
				var meta = isFile
					? Math.round(it.size / 1024) + " KB"
					: "外链";
				var thumb = isFile
					? '<img src="' +
						escHtml(it.thumbUrl) +
						'" alt="" class="h-9 w-9 shrink-0 rounded object-cover" />'
					: '<span class="grid h-9 w-9 shrink-0 place-items-center rounded bg-amber-500/15 text-[10px] font-medium text-amber-600 dark:text-amber-400">外链</span>';
				var locked = it.status !== "ready" ? " disabled" : "";
				html +=
					'<div data-stage-id="' +
					it.id +
					'" class="flex items-center gap-2.5 rounded-lg border border-(--line-divider) px-2.5 py-1.5">' +
					thumb +
					'<span class="min-w-0 grow truncate text-xs text-neutral-600 dark:text-neutral-300" title="' +
					escHtml(label) +
					'">' +
					escHtml(label) +
					'</span>' +
					'<span class="shrink-0 text-[11px] text-neutral-400">' +
					meta +
					"</span>" +
					'<span data-stage-status class="shrink-0 text-[11px] text-neutral-400"></span>' +
					'<button type="button" data-stage-remove="' +
					it.id +
					'"' +
					locked +
					' title="移出清单" class="shrink-0 cursor-pointer rounded border border-(--line-divider) px-1.5 py-0.5 text-[11px] leading-none text-neutral-500 transition-colors hover:bg-neutral-100 disabled:cursor-not-allowed disabled:opacity-40 dark:text-neutral-400 dark:hover:bg-neutral-700">&times;</button>' +
					"</div>";
			});
			queueEl.innerHTML = html;
		}

		/** 移出清单（释放缩略图的 blob 地址，避免泄漏） */
		function removeStaged(id) {
			var hit = state.stagedUploads.filter(function (it) {
				return it.id === id;
			})[0];
			if (!hit || hit.status !== "ready") return;
			if (hit.thumbUrl) URL.revokeObjectURL(hit.thumbUrl);
			state.stagedUploads = state.stagedUploads.filter(function (it) {
				return it.id !== id;
			});
			renderStagedList();
		}

		/** 清空清单（关闭弹窗 / 切相册 / swup 重入时调用） */
		function clearStaged() {
			(state.stagedUploads || []).forEach(function (it) {
				if (it.thumbUrl) URL.revokeObjectURL(it.thumbUrl);
			});
			state.stagedUploads = [];
			// ⚠️ 这里**不清** stageResult / lastCommitFailed：
			// 后台提交完成后重新打开弹窗，还要能看到「推送成功 / 推送失败」。
			// 真正"放弃"的路径（closeUpload 且 keepStaged=false）会显式清。
			renderStagedList();
		}

		/**
		 * 「提交」：本地文件**逐个**上传（串行，避免并发写同一目录）⇒
		 * 外链与既有清单合并去重后**一次**写入 urls.txt ⇒ 成功项移出、失败项保留可重试。
		 */
		// 「推送成功」提示的自动消失令牌：避免旧的定时器把新状态覆盖掉
		var resultToken = 0;

		function commitUploads() {
			if (state.busy) return;
			var c = requireToken();
			if (!c) return;
			// ⚠️ 固定发起时的相册：提交过程中用户可能切走 ⇒ 否则会把照片写进另一个相册
			var albumId = state.selected;
			if (!albumId) return;
			var files = (state.stagedUploads || []).filter(function (it) {
				return it.kind === "file";
			});
			var urls = (state.stagedUploads || []).filter(function (it) {
				return it.kind === "url";
			});
			if (!files.length && !urls.length) return;

			var total = files.length;
			var okFiles = 0;
			var failFiles = 0;
			var doneFiles = 0;
			// 唯一一处结果提示：先置「推送中」（读屏与视觉都在同一处）
			state.lastCommitFailed = false;
			state.stageResult = {
				tone: "busy",
				text: total ? "正在上传 0/" + total + "…" : "正在推送…",
			};
			// 进度同时显示在「提交」按钮上
			setBusy(true, total ? "上传中 0/" + total : "提交中…");

			files
				.reduce(function (p, it) {
					return p.then(function () {
						paintStageRow(it.id, "上传中…", "busy");
						return readB64(it.file)
							.then(function (b64) {
								if (!b64) throw new Error("读取失败");
								var ext = (it.name.split(".").pop() || "jpg").toLowerCase();
								var fileName =
									Date.now() +
									"-" +
									Math.random().toString(36).slice(2, 8) +
									"." +
									ext;
								return putFileRaw(
									c,
									PHOTO_DIR + "/" + albumId + "/" + fileName,
									b64,
									"",
									"feat(gallery): 网站端上传照片（" + albumId + "）",
								).then(function () {
									okFiles++;
									it.status = "done";
									it.savedAs = fileName;
									// 乐观写入内存快照 ⇒ 即使随后的校正请求失败，切走再切回也不丢
									addManifestFile(albumId, fileName);
									paintStageRow(it.id, "已上传", "ok");
								});
							})
							.catch(function () {
								// 失败项**保留在清单里**，用户可以再点一次「提交」重试
								failFiles++;
								it.status = "fail";
								paintStageRow(
									it.id,
									it.status === "fail" ? "失败，可重试" : "失败",
									"fail",
								);
							})
							.then(function () {
								doneFiles++;
								// 只改按钮文案 —— 不能走 renderStagedList()，那会重建清单 HTML
								// 并抹掉刚 paint 上去的「上传中 / 已上传」行状态
								if (total && btnUploadCommit)
									btnUploadCommit.textContent =
										"上传中 " + doneFiles + "/" + total;
								// 唯一一处提示同步进度（直接改文本 —— 不能走 renderStagedList，
								// 那会重建清单并抹掉刚 paint 上的行状态）
								if (total && state.stageResult) {
									state.stageResult.text =
										"正在上传 " + doneFiles + "/" + total + "…";
									if (stageResultEl)
										stageResultEl.textContent = state.stageResult.text;
								}
							});
					});
				}, Promise.resolve())
				.then(function () {
					// 外链：与既有清单合并去重，**一次**写入（用户要求外链合并提交）
					if (!urls.length) return null;
					var merged = (state.remotePhotos || []).slice();
					urls.forEach(function (it) {
						if (merged.indexOf(it.url) < 0) merged.push(it.url);
					});
					return writeUrlsText(merged.join("\n"), true).then(
						function () {
							urls.forEach(function (it) {
								it.status = "done";
							});
							return true;
						},
						function () {
							urls.forEach(function (it) {
								it.status = "fail";
							});
							return false;
						},
					);
				})
				.then(function (urlsOk) {
					// 成功项移出清单（含刚上传成功、`status==="done"` 且是新文件的那些）
					var keep = [];
					(state.stagedUploads || []).forEach(function (it) {
						if (it.status === "done") {
							if (it.thumbUrl) URL.revokeObjectURL(it.thumbUrl);
						} else {
							keep.push(it);
						}
					});
					state.stagedUploads = keep;
					// 失败项恢复到「可重试」状态（下次提交仍会尝试）
					keep.forEach(function (it) {
						it.status = "ready";
					});
					var urlTotal = urls.length;
					var urlFail = urlsOk === false ? urlTotal : 0;
					var okTotal =
						okFiles + (urlTotal && urlsOk !== false ? urlTotal : 0);
					var failed = failFiles + urlFail;
					state.lastCommitFailed = failed > 0;
					if (failed) {
						// 失败项**保留**在清单里（清单不清空）；提示常驻到下次提交
						var bits = [];
						if (okTotal) bits.push("成功 " + okTotal + " 项");
						bits.push("推送失败 " + failed + " 项，请重试");
						state.stageResult = { tone: "fail", text: bits.join("，") };
					} else if (okTotal) {
						// 全部成功 ⇒ 成功项已移出、清单自然清空；提示 4 秒后自动消失
						state.stageResult = { tone: "ok", text: "推送成功 ✓ 共 " + okTotal + " 项" };
						var myToken = ++resultToken;
						window.setTimeout(function () {
							if (myToken !== resultToken) return; // 期间又提交过 ⇒ 别覆盖
							state.stageResult = null;
							if (!uploadEl || uploadEl.classList.contains("hidden")) return;
							renderStagedList();
						}, 4000);
					} else {
						state.stageResult = null;
					}
					setBusy(false);
					renderStagedList();
					return reloadPhotos();
				})
				.catch(function (e) {
					state.lastCommitFailed = true;
					state.stageResult = { tone: "fail", text: "推送失败，请重试。" };
					setBusy(false);
					renderStagedList();
					return reloadPhotos();
				});
		}

		/**
		 * 删除一张照片。
		 * 本地照片：从仓库删文件；外链照片：从 urls.txt 里移除这一行。
		 */
		function deletePhoto(src, key, isRemote) {
			var c = requireToken();
			if (!c) return;
			if (isRemote) {
				var label = key || src;
				askConfirm("「" + label + "」这条外链将被移除。", {
					title: "移除这条外链？",
					kind: "danger",
				}).then(function (ok) {
					if (!ok) return;
					// 外链的就地移除**即时生效**（和删除照片一致），走同一条写入函数
					state.remotePhotos = (state.remotePhotos || []).filter(function (u) {
						return u !== label;
					});
					writeUrlsText(state.remotePhotos.join("\n"));
				});
				return;
			}
			var hit = state.photoFiles.filter(function (f) {
				return f.name === key;
			})[0];
			if (!hit) {
				return;
			}
			// 确认框文案统一格式：「xxx」+ 一句陈述
			askConfirm("「" + key + "」这张照片将被删除。", {
				title: "删除这张照片？",
				kind: "danger",
			}).then(function (ok) {
				if (!ok) return;
				var albumId = state.selected;
				setBusy(true, "正在删除…");
				// ⚠️ 内嵌快照里**没有 sha**（构建时无法预知）⇒ 必须**当场取**。
				// 若仓库里已不存在（快照过期，或该文件在别处删过）⇒ getFile 返回 missing ⇒ 给可行动提示。
				getFile(c, hit.path)
					.then(function (f) {
						if (f.missing || !f.sha)
							throw new Error(
								"仓库里已经找不到这张照片了（列表可能已过期），请点右上「刷新」。",
							);
						return deleteFile(
							c,
							hit.path,
							f.sha,
							"chore(gallery): 网站端删除照片（" + albumId + "）",
						);
					})
					.then(function () {
						setBusy(false);
						// 界面与内存快照立刻同步移除（乐观更新，不必等校正请求）
						removeManifestFile(albumId, key);
						if (albumId === state.selected) {
							state.photoFiles = state.photoFiles.filter(function (x) {
								return x.name !== key;
							});
							renderPhotoPanel();
							syncPhotoCount();
							renderInfo();
						}
						return reloadPhotos();
					})
					.catch(function (e) {
						setBusy(false);
					});
			});
		}

		/** 把某张照片设为封面：只改配置字段（零文件操作、可逆）。src 可以是本地路径或外链地址 */
		function setCover(src) {
			if (state.busy) return;
			var c = requireToken();
			if (!c) return;
			var idx = -1;
			for (var i = 0; i < state.albums.length; i++)
				if (state.albums[i].id === state.selected) idx = i;
			if (idx < 0) {
				return;
			}
			setBusy(true, "正在设置封面…");
			state.albums[idx].cover = src;
			commitConfig(c, "feat(gallery): 网站端设置相册封面（" + state.selected + "）")
				.then(function () {
					setBusy(false);
					renderInfo();
					renderPhotoPanel();
				})
				.catch(function (e) {
					setBusy(false);
				});
		}

		/** 清掉新建态暂存的封面（取消 / 切换相册 / 关闭弹窗时调用，顺手释放 blob 地址） */
		function clearPendingCover() {
			if (state.pendingCoverUrl) URL.revokeObjectURL(state.pendingCoverUrl);
			state.pendingCoverFile = null;
			state.pendingCoverUrl = "";
		}

		/** 读文件为 base64（去掉 data:xxx;base64, 前缀） */
		function readB64(file) {
			return new Promise(function (resolve) {
				var reader = new FileReader();
				reader.onload = function () {
					resolve(String(reader.result).split(",")[1] || "");
				};
				reader.onerror = function () {
					resolve("");
				};
				reader.readAsDataURL(file);
			});
		}

		/**
		 * 选中封面后的分流：
		 *  - 已有相册（编辑态）⇒ 立即上传，写 cover.<ext> 并改配置 ✓
		 *  - 新建相册（还没 id）⇒ 先暂存内存 + 本地预览，等「提交」时随相册一起写入 ✓
		 *    （对齐旧版设计：封面图和相册信息是一起提交的）
		 */
		function pickCover(file) {
			if (!file || state.busy) return;
			if (!IMG_RE.test(file.name)) {
				return;
			}
			if (file.size > MAX_UPLOAD_BYTES) {
				return;
			}
			if (state.editing !== null && !state.selected) {
				if (state.pendingCoverUrl) URL.revokeObjectURL(state.pendingCoverUrl);
				state.pendingCoverFile = file;
				state.pendingCoverUrl = URL.createObjectURL(file);
				state.dirty = true;
				renderInfo();
				// 不弹提示：封面预览区已即时显示所选图片，本身就是反馈
				return;
			}
			uploadCover(file);
		}

		/**
		 * 上传封面：写 public/gallery/<id>/cover.<ext>，再把 config 的 cover 字段指向它。
		 * 由"编辑态下点击封面预览"触发（用户要求：点编辑后封面图可点击 ⇒ 点击就是上传封面图）。
		 */
		function uploadCover(file) {
			if (!file || state.busy) return;
			var c = requireToken();
			if (!c || !state.selected) return;
			if (!IMG_RE.test(file.name)) {
				return;
			}
			if (file.size > MAX_UPLOAD_BYTES) {
				return;
			}
			var idx = -1;
			for (var i = 0; i < state.albums.length; i++)
				if (state.albums[i].id === state.selected) idx = i;
			if (idx < 0) {
				return;
			}
			setBusy(true, "正在上传封面…");
			var ext = (file.name.split(".").pop() || "jpg").toLowerCase();
			var rel = "/gallery/" + state.selected + "/cover." + ext;
			readB64(file)
				.then(function (b64) {
					if (!b64) throw new Error("读取图片失败。");
					// ⚠️ 必须带上"已存在封面"的 sha：Contents API 对**已存在**的文件要求 sha，
					// 否则同一扩展名二次上传会直接 422（早先固定传 "" ⇒ 再传一次 cover.png 就失败，
					// 传不同扩展名才恰好成功，掩盖了这个问题）。
					var cpath = PHOTO_DIR + "/" + state.selected + "/cover." + ext;
					return getFile(c, cpath).then(function (f) {
						return putFileRaw(
							c,
							cpath,
							b64,
							f.missing ? "" : f.sha || "",
							"feat(gallery): 网站端上传相册封面（" + state.selected + "）",
						);
					});
				})
				.then(function () {
					// 先写新的、再清理旧封面：避免出现"没有封面的空窗期"。
					// 同一个相册只应保留一个 cover.*（否则 cover.jpg 与 cover.png 并存，
					// 上游 getAlbumCover 会取到不确定的那个）。
					var dir = PHOTO_DIR + "/" + state.selected;
					var keep = ("cover." + ext).toLowerCase();
					return listDir(c, dir)
						.then(function (entries) {
							var olds = (entries || []).filter(function (x) {
								return (
									x &&
									x.type === "file" &&
									COVER_RE.test(x.name) &&
									String(x.name).toLowerCase() !== keep
								);
							});
							return olds.reduce(function (p, f) {
								return p.then(function () {
									return deleteFile(
										c,
										f.path,
										f.sha,
										"chore(gallery): 清理旧封面（" + state.selected + "）",
									);
								});
							}, Promise.resolve());
						})
						.catch(function () {
							/* 清理失败不阻断封面设置 */
						});
				})
				.then(function () {
					state.albums[idx].cover = rel;
					return commitConfig(
						c,
						"feat(gallery): 网站端设置相册封面（" + state.selected + "）",
					);
				})
				.then(function () {
					setBusy(false);
					render();
					if (state.tab === "photos") reloadPhotos();
				})
				.catch(function (e) {
					setBusy(false);
				});
		}

		/* ═══════════════ 编辑态切换 ═══════════════ */

		function enterEdit() {
			if (state.editing !== null) return;
			if (!state.selected && state.albums.length) state.selected = state.albums[0].id;
			if (!state.selected) {
				return;
			}
			state.editing = state.selected;
			state.saved = JSON.parse(JSON.stringify(state.albums));
			state.dirty = false;
			state.idTouched = false;
			render();
			var el = fieldEl("name");
			if (el) {
				try {
					el.focus({ preventScroll: true });
				} catch (e) {
					/* ignore */
				}
			}
		}

		// 取消编辑（有未提交改动时先确认；沿用动态编辑器那套确认框逻辑）
		function cancelEdit() {
			if (state.editing === null) return;
			if (state.dirty) {
				askConfirm("改动还没提交到云端，放弃后改动会丢失。", {
					title: "放弃未提交的修改？",
					okText: "确定",
					cancelText: "取消",
					kind: "warning",
				})				.then(function (ok) {
					if (!ok) return;
					restoreSaved();
					state.editing = null;
					clearPendingCover();
					render();
				});
				return;
			}
			state.editing = null;
			clearPendingCover();
			render();
		}

		/* ═══════════════ 事件绑定 ═══════════════ */

		// 信息面板：编辑态下点封面 = 上传封面（只读态不可点）
		if (coverPreviewEl)
			coverPreviewEl.addEventListener("click", function () {
				// 编辑态才可点；新建态也能选（选中后先暂存，提交时随相册一起上传）
				if (state.editing === null || state.busy) return;
				if (coverInputEl) coverInputEl.click();
			});
		if (coverInputEl)
			coverInputEl.addEventListener("change", function () {
				pickCover(coverInputEl.files && coverInputEl.files[0]);
				coverInputEl.value = "";
			});

		// 左列导航：点一项即选中（编辑中有未提交改动时会被拦住并提示）
		if (navEl) {
			navEl.addEventListener("click", function (e) {
				var item = e.target.closest ? e.target.closest("[data-nav]") : null;
				if (!item) return;
				selectAlbum(item.getAttribute("data-nav") || "");
			});
		}
		if (searchEl) searchEl.addEventListener("input", renderNav);

		if (tabInfoEl)
			tabInfoEl.addEventListener("click", function () {
				setTab("info");
			});
		if (tabPhotosEl)
			tabPhotosEl.addEventListener("click", function () {
				setTab("photos");
			});

		// Tab 栏右侧操作区（按钮由 applyActions 动态生成 ⇒ 绑在容器上做委托）
		if (actionsEl) {
			actionsEl.addEventListener("click", function (e) {
				var btn = e.target.closest ? e.target.closest("button[data-act]") : null;
				if (!btn) return;
				var act = btn.getAttribute("data-act");
				if (act === "edit") enterEdit();
				else if (act === "cancel") cancelEdit();
				else if (act === "save") saveInfo();
				else if (act === "reload") {
					// 「刷新」是**唯一的主动拉取入口**（其余读取全部走内嵌快照）：
					// 照片目录 + 外链清单 + 相册列表一起重同步。
					// 相册列表也要拉 —— 否则网站端新增的相册本地永远看不到。
					// 过程反馈走**按钮文案**（refreshing 独立标记，避免"正在删除…"等文案串进来）
					state.refreshing = true;
					applyActions();
					state.loadedFor = state.selected;
					Promise.all([reloadPhotos(), loadUrls(), loadFromRemote()])
						.catch(function () {
							/* 各分支内部的错误提示已处理 */
						})
						.then(function () {
							state.refreshing = false;
							applyActions();
						});
				}
			});
		}

		// 信息面板：任何输入 / 切换都算"有未提交改动"
		if (panelInfoEl) {
			panelInfoEl.addEventListener("input", function (e) {
				if (state.editing !== null) state.dirty = true;
				var t = e.target;
				if (!t || !t.getAttribute) return;
				var f = t.getAttribute("data-f");
				// 相册 ID 默认跟随「相册名称」自动生成；用户一旦手动改过 ID 就不再跟随
				if (f === "id") {
					state.idTouched = true;
					return;
				}
				if (f === "name" && !state.idTouched) {
					var idEl = fieldEl("id");
					if (idEl) idEl.value = slugifyAlbumId(t.value);
				}
			});
			panelInfoEl.addEventListener("change", function () {
				if (state.editing !== null) state.dirty = true;
			});
		}

		if (btnAdd)
			btnAdd.addEventListener("click", function () {
				if (state.busy || state.editing !== null) return;
				state.saved = JSON.parse(JSON.stringify(state.albums));
				state.editing = "";
				state.selected = "";
				state.photoFiles = [];
				state.remotePhotos = [];
				state.dirty = false;
				state.idTouched = false;
				state.tab = "info";
				state.loadedFor = "";
				// 清掉上一次新建遗留的暂存封面
				if (state.pendingCoverUrl) URL.revokeObjectURL(state.pendingCoverUrl);
				state.pendingCoverFile = null;
				state.pendingCoverUrl = "";
				render();
			});

		if (btnDelAlbum)
			btnDelAlbum.addEventListener("click", function () {
				var a = currentAlbum();
				if (a) deleteAlbum(a);
			});

		if (btnDone)
			btnDone.addEventListener("click", function () {
				requestClose(false);
			});
		if (btnOpen) btnOpen.addEventListener("click", openModal);

		var btnClose = document.getElementById("ge-close");
		if (btnClose)
			btnClose.addEventListener("click", function () {
				requestClose(false);
			});
		if (mask)
			mask.addEventListener("click", function (e) {
				if (e.target === mask) requestClose(false);
			});

		/* 上传弹窗：四个"用户主动关闭"入口统一走 requestCloseUpload（清单非空会先确认） */
		if (btnUploadDone)
			btnUploadDone.addEventListener("click", function () {
				requestCloseUpload();
			});
		if (btnUploadClose)
			btnUploadClose.addEventListener("click", function () {
				requestCloseUpload();
			});
		if (uploadEl)
			uploadEl.addEventListener("click", function (e) {
				if (e.target === uploadEl) requestCloseUpload();
			});
		if (dropzoneEl)
			dropzoneEl.addEventListener("click", function () {
				fileInputEl.click();
			});
		if (fileInputEl)
			fileInputEl.addEventListener("change", function () {
				// 只入队，不发请求 —— 点弹窗「提交」才真正上传
				stageFiles(fileInputEl.files);
				fileInputEl.value = "";
			});
		if (dropzoneEl) {
			dropzoneEl.addEventListener("dragover", function (e) {
				e.preventDefault();
				dropzoneEl.classList.add("border-(--primary)");
			});
			dropzoneEl.addEventListener("dragleave", function () {
				dropzoneEl.classList.remove("border-(--primary)");
			});
			dropzoneEl.addEventListener("drop", function (e) {
				e.preventDefault();
				dropzoneEl.classList.remove("border-(--primary)");
				if (e.dataTransfer && e.dataTransfer.files) stageFiles(e.dataTransfer.files);
			});
		}

		// 图片网格：委托（「＋ 添加图片」/ ★ 设为封面 / 🗑 删除）
		if (photoGridEl)
			photoGridEl.addEventListener("click", function (e) {
				var up = e.target.closest ? e.target.closest('[data-act="upload"]') : null;
				if (up) {
					openUpload();
					return;
				}
				var btn = e.target.closest ? e.target.closest("button[data-photo-act]") : null;
				if (!btn) return;
				var src = btn.getAttribute("data-src") || "";
				if (btn.getAttribute("data-photo-act") === "del") {
					deletePhoto(
						src,
						btn.getAttribute("data-key") || "",
						btn.getAttribute("data-remote") === "1",
					);
				} else {
					setCover(src);
				}
			});
		// 外链：多行文本框，点「添加」把里面所有合法地址一次性入队
		// （textarea 里回车是换行 ⇒ 不拦截 Enter）
		if (btnUrlAdd)
			btnUrlAdd.addEventListener("click", function () {
				if (urlInputEl && stageUrl(urlInputEl.value)) {
					urlInputEl.value = "";
					urlInputEl.focus();
				}
			});
		// 待提交清单：点 × 移出（委托；清单内容会随入队/提交重建）
		if (queueEl)
			queueEl.addEventListener("click", function (e) {
				var b = e.target.closest ? e.target.closest("[data-stage-remove]") : null;
				if (!b) return;
				removeStaged(Number(b.getAttribute("data-stage-remove")));
			});
		if (btnUploadCommit) btnUploadCommit.addEventListener("click", commitUploads);

		if (confirmOkBtn)
			confirmOkBtn.addEventListener("click", function () {
				settleConfirm(true);
			});
		if (confirmCancelBtn)
			confirmCancelBtn.addEventListener("click", function () {
				settleConfirm(false);
			});
		if (confirmEl)
			confirmEl.addEventListener("click", function (e) {
				if (e.target === confirmEl) settleConfirm(false);
			});

		// Esc 的优先顺序：确认框 → 上传弹窗 → 取消编辑 → 关闭主弹窗
		function onKeydown(e) {
			if (e.key !== "Escape") return;
			if (confirmEl && !confirmEl.classList.contains("hidden")) {
				settleConfirm(false);
				return;
			}
			if (uploadEl && !uploadEl.classList.contains("hidden")) {
				// 走守卫：清单里有东西时先问一句，避免误按 Esc 丢掉待提交内容
				requestCloseUpload();
				return;
			}
			if (!mask || mask.classList.contains("hidden")) return;
			if (state.editing !== null) {
				cancelEdit();
				return;
			}
			requestClose(false);
		}

		/* ═══════════════ 可见性 + 首屏快照 + swup 重入 ═══════════════ */

		function initVisibility() {
			if (!btnOpen) return;
			var c = cfg();
			var force = /[?&]manage=1\b/.test(window.location.search);
			if (!c.token && !force) return;
			btnOpen.classList.remove("hidden");
			btnOpen.classList.add("inline-flex");
		}

		function bootstrap() {
			var raw = root.getAttribute("data-albums") || "[]";
			try {
				var arr = JSON.parse(raw);
				state.albums = (Array.isArray(arr) ? arr : []).map(normalizeAlbum);
				state.saved = JSON.parse(JSON.stringify(state.albums));
			} catch (e) {
				state.albums = [];
			}
			state.editing = null;
			state.dirty = false;
			// 各相册张数（服务端构建时扫目录算好）⇒ 左列每项显示用
			try {
				var counts = JSON.parse(root.getAttribute("data-photo-counts") || "{}");
				state.photoCounts = counts && typeof counts === "object" ? counts : {};
			} catch (e) {
				state.photoCounts = {};
			}
			// 内嵌照片清单（读取零请求的数据源）
			try {
				var mf = JSON.parse(root.getAttribute("data-photo-manifest") || "{}");
				state.photoManifest = mf && typeof mf === "object" ? mf : {};
			} catch (e) {
				state.photoManifest = {};
			}
			if (!state.selected && state.albums.length) state.selected = state.albums[0].id;
			render();
		}

		// 【swup 重入】先拿走并执行上一次登记的清理（必须在本次重新登记之前，否则会清掉自己刚建的状态）
		var prevCleanup = window.__geCleanup;
		if (typeof prevCleanup === "function") {
			try {
				prevCleanup();
			} catch (e) {
				/* ignore */
			}
		}
		window.__geCleanup = null;

		// 浮层挂到 body（站点卡片祖先带 transform/backdrop-filter 时 fixed 会相对该祖先定位而错位）
		if (mask && mask.parentNode !== document.body) document.body.appendChild(mask);
		if (uploadEl && uploadEl.parentNode !== document.body) document.body.appendChild(uploadEl);
		if (confirmEl && confirmEl.parentNode !== document.body) document.body.appendChild(confirmEl);

		bootstrap();
		initVisibility();
		if (!window.__geKeydownBound) {
			document.addEventListener("keydown", onKeydown);
			window.__geKeydownBound = true;
		}

		/**
		 * 彻底收拾：解绑键盘监听、复位滚动锁、把浮层从 body 上移除。
		 * 两个调用点：
		 *  ① 本组件脚本被重放之前（swup 的 scripts-plugin 会重放内联脚本）；
		 *  ② **切到没有本组件的页面时**（见 bindSwup）—— 这一点早先漏了，
		 *     导致离开相册页后 3 个隐藏浮层一直挂在 body 上（无头浏览器实测残留）。
		 */
		function teardown() {
			window.__geKeydownBound = false;
			try {
				document.removeEventListener("keydown", onKeydown);
			} catch (e) {
				/* ignore */
			}
			while (scrollLockCount > 0) unlockPageScroll();
			// 释放待提交清单的缩略图 blob 地址（切页时组件整体作废，不释放会泄漏）
			(state.stagedUploads || []).forEach(function (it) {
				if (it.thumbUrl) URL.revokeObjectURL(it.thumbUrl);
			});
			state.stagedUploads = [];
			if (mask && mask.parentNode) mask.parentNode.removeChild(mask);
			if (uploadEl && uploadEl.parentNode) uploadEl.parentNode.removeChild(uploadEl);
			if (confirmEl && confirmEl.parentNode) confirmEl.parentNode.removeChild(confirmEl);
			confirmResolve = null;
		}

		// 登记清理入口（供下一次脚本重放时兜底；必须在末尾登记）
		window.__geCleanup = teardown;

		function bindSwup() {
			if (window.__geSwupHooked) return true;
			if (!window.swup || !window.swup.hooks) return false;
			window.swup.hooks.on("content:replace", function () {
				adoptDialog();
				if (!document.getElementById("ge-root")) {
					// 切走了：先复位状态，再把浮层等一切本组件的东西从页面上清理干净
					doClose();
					teardown();
					return;
				}
				// 仍在本页：入口是新元素，需要重新判定可见性
				refreshRefs();
				initVisibility();
			});
			window.__geSwupHooked = true;
			return true;
		}

		/** 接管文档里最新的那份浮层（swup 重放会带来新 DOM），并删掉重复 */
		function adoptDialog() {
			var masks = document.querySelectorAll("#ge-mask");
			var confs = document.querySelectorAll("#ge-confirm");
			var ups = document.querySelectorAll("#ge-upload");
			var m = masks.length ? masks[masks.length - 1] : null;
			var c = confs.length ? confs[confs.length - 1] : null;
			var u = ups.length ? ups[ups.length - 1] : null;
			var i;
			for (i = 0; i < masks.length - 1; i++) {
				if (masks[i].parentNode) masks[i].parentNode.removeChild(masks[i]);
			}
			for (i = 0; i < confs.length - 1; i++) {
				if (confs[i].parentNode) confs[i].parentNode.removeChild(confs[i]);
			}
			for (i = 0; i < ups.length - 1; i++) {
				if (ups[i].parentNode) ups[i].parentNode.removeChild(ups[i]);
			}
			var docM = document.getElementById("ge-mask");
			var docC = document.getElementById("ge-confirm");
			var docU = document.getElementById("ge-upload");
			if (docM && docM.parentNode !== document.body) document.body.appendChild(docM);
			if (docU && docU.parentNode !== document.body) document.body.appendChild(docU);
			if (docC && docC.parentNode !== document.body) document.body.appendChild(docC);
			m = m || docM;
			c = c || docC;
			u = u || docU;
			if (m) mask = m;
			if (c) confirmEl = c;
			if (u) uploadEl = u;
			if (mask) {
				var oc = mask.querySelector("#ge-close");
				if (oc) {
					oc.onclick = null;
					oc.addEventListener("click", function () {
						requestClose(false);
					});
				}
			}
			if (uploadEl) {
				var uc = uploadEl.querySelector("#ge-upload-close");
				var ud = uploadEl.querySelector("#ge-upload-done");
				var uq = uploadEl.querySelector("#ge-upload-queue");
				var uf = uploadEl.querySelector("#ge-file-input");
				var uz = uploadEl.querySelector("#ge-dropzone");
				var ui = uploadEl.querySelector("#ge-url-input");
				var ua = uploadEl.querySelector("#ge-url-add");
				var ucm = uploadEl.querySelector("#ge-upload-commit");
				var ut = uploadEl.querySelector("#ge-upload-sub");
				if (uq) queueEl = uq;
				if (uf) fileInputEl = uf;
				if (uz) dropzoneEl = uz;
				if (ui) urlInputEl = ui;
				if (ua) btnUrlAdd = ua;
				if (ucm) btnUploadCommit = ucm;
				if (ut) uploadSubEl = ut;
				// ⚠️ uploadEl 被整体替换 ⇒ 新元素没有监听器，必须在这里重新绑（与 uc/ud 同理）
				if (uc)
					uc.addEventListener("click", function () {
						requestCloseUpload();
					});
				if (ud)
					ud.addEventListener("click", function () {
						requestCloseUpload();
					});
				if (ua)
					ua.addEventListener("click", function () {
						if (urlInputEl && stageUrl(urlInputEl.value)) {
							urlInputEl.value = "";
							urlInputEl.focus();
						}
					});
				if (ucm) ucm.addEventListener("click", commitUploads);
				if (uq)
					uq.addEventListener("click", function (e) {
						var b = e.target.closest ? e.target.closest("[data-stage-remove]") : null;
						if (!b) return;
						removeStaged(Number(b.getAttribute("data-stage-remove")));
					});
			}
			if (confirmEl) {
				confirmOkBtn = confirmEl.querySelector("#ge-confirm-ok") || confirmOkBtn;
				confirmCancelBtn = confirmEl.querySelector("#ge-confirm-cancel") || confirmCancelBtn;
				confirmIconEl = confirmEl.querySelector("#ge-confirm-icon") || confirmIconEl;
				confirmTitleEl = confirmEl.querySelector("#ge-confirm-title") || confirmTitleEl;
				confirmTextEl = confirmEl.querySelector("#ge-confirm-text") || confirmTextEl;
				confirmIcons = confirmIconEl ? confirmIconEl.querySelectorAll("svg[data-kind]") : [];
			}
		}

		/** 重新取入口按钮引用（swup 切页后是新元素） */
		function refreshRefs() {
			root = document.getElementById("ge-root") || root;
			var fresh = document.getElementById("ge-open");
			if (fresh && fresh !== btnOpen) {
				btnOpen = fresh;
				if (!btnOpen.__geBound) {
					btnOpen.__geBound = true;
					btnOpen.addEventListener("click", openModal);
				}
			}
		}

		if (!bindSwup()) {
			document.addEventListener(
				"swup:enable",
				function () {
					bindSwup();
				},
				{ once: true },
			);
		}
	})();
</script>
