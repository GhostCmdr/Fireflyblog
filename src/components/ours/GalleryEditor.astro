<style is:global>
	/* 提示条配色由 JS 内联 cssText 设置（与动态编辑器同一套 palette、无圆角）⇒
	   这里不再写 #ge-msg 的样式，避免与内联样式打架。 */

	/* 弹窗内滚动条：细 + 圆角，颜色接近系统默认灰（不跟随主色） */
	.ge-scroll {
		scrollbar-width: thin;
		scrollbar-color: rgba(0, 0, 0, 0.3) transparent;
	}
	.dark .ge-scroll {
		scrollbar-color: rgba(255, 255, 255, 0.28) transparent;
	}
	.ge-scroll::-webkit-scrollbar {
		width: 8px;
		height: 8px;
	}
	.ge-scroll::-webkit-scrollbar-track {
		background: transparent;
	}
	.ge-scroll::-webkit-scrollbar-thumb {
		background: rgba(0, 0, 0, 0.3);
		background-clip: content-box;
		border: 2px solid transparent;
		border-radius: 999px;
	}
	.dark .ge-scroll::-webkit-scrollbar-thumb {
		background: rgba(255, 255, 255, 0.28);
	}
	#ge-body-list {
		scrollbar-gutter: stable;
	}

	/* 确认框内的按钮不显示键盘焦点环（与友链/动态一致：避免按 Esc 唤出时出现橙圈） */
	#ge-confirm button:focus,
	#ge-confirm button:focus-visible {
		outline: none;
	}

	/* 浮层被 append 到 body 后类选择器会失效 ⇒ 用 id 选择器给按钮手型光标 */
	#ge-root button,
	#ge-mask button,
	#ge-confirm button,
	#ge-upload button {
		cursor: pointer;
	}

	/* ── 右列两个 Tab：选中态用 data-active 控制（避免 JS 反复切类名） ── */
	#ge-tab-info,
	#ge-tab-photos {
		border-bottom-color: transparent;
		color: #737373;
		font-weight: 500;
	}
	.dark #ge-tab-info,
	.dark #ge-tab-photos {
		color: #a3a3a3;
	}
	#ge-tab-info:hover,
	#ge-tab-photos:hover {
		color: #404040;
	}
	.dark #ge-tab-info:hover,
	.dark #ge-tab-photos:hover {
		color: #e5e5e5;
	}
	#ge-tab-info[data-active="1"],
	#ge-tab-photos[data-active="1"] {
		border-bottom-color: var(--primary);
		color: var(--primary);
		font-weight: 600;
	}

	/* ── 左列相册导航项 ── */
	.ge-nav-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.375rem;
		padding: 0.5rem;
		border-radius: 0.5rem;
		cursor: pointer;
	}
	.ge-nav-item:hover {
		background-color: rgba(115, 115, 115, 0.08);
	}
	.ge-nav-item[data-active="1"] {
		background-color: color-mix(in srgb, var(--primary) 10%, transparent);
	}
	.ge-nav-name {
		font-size: 0.75rem;
		color: #404040;
	}
	.dark .ge-nav-name {
		color: #d4d4d4;
	}
	.ge-nav-item[data-active="1"] .ge-nav-name {
		color: var(--primary);
		font-weight: 600;
	}

	/* ── 信息面板：只读态字段 ──
	   与动态编辑器完全一致：去掉边框做成"文本样子"、只留一层极淡底色
	   （避免大片空白显得太空）；不加 pointer-events:none，这样只读时也能选中复制，
	   真正的"不可改"由 renderInfo() 里的 readOnly 保证（键盘同样改不了）。 */
	#ge-panel-info[data-ro="1"] .ge-field input {
		border-color: transparent;
		box-shadow: none;
		background: rgba(0, 0, 0, 0.03);
		cursor: default;
	}
	.dark #ge-panel-info[data-ro="1"] .ge-field input {
		background: rgba(255, 255, 255, 0.04);
	}

	/* 右侧两个面板：未隐藏时必须是 flex 列容器（内部卡片靠 grow 撑满）。
	   不能写 Tailwind 的 flex + hidden 同时存在（hidden 会赢），所以用这条兜住。 */
	.ge-panel-flex:not(.hidden) {
		display: flex;
	}

	/* ── 左列相册项：白底卡片（与动态列表同款）── */
	.ge-nav-item {
		border: 1px solid var(--line-divider);
	}
	.ge-nav-item[data-active="1"] {
		border-color: color-mix(in srgb, var(--primary) 45%, transparent);
	}

	/* ── 图片网格第一格的「＋ 添加图片」虚线格 ──
	   ⚠️ 必须**自己**撑出与照片卡片一致的高度（照片卡 = 4:3 图区 + 一行 h-8 名称行）。
	   **不能**依赖网格 stretch —— 相册里只有封面、没有其它照片时，网格里就只剩这一格，
	   行高会被容器的 min-h 撑满（约 380px）⇒ 按钮被拉成一个巨大的空框（用户实测报障）。
	   所以改成与照片卡逐字同构：aspect-4/3 的虚线图区 + h-8 的空行，再用 align-self:start 兜底。 */
	.ge-add-photo {
		display: flex;
		flex-direction: column;
		align-self: start;
		overflow: hidden;
		border-radius: 0.75rem;
		color: var(--color-neutral-400, #a3a3a3);
		background: transparent;
		transition: all 0.2s;
	}
	.ge-add-photo-frame {
		display: grid;
		place-items: center;
		width: 100%;
		flex-shrink: 0;
		aspect-ratio: 4 / 3;
		border: 2px dashed var(--line-divider);
		border-radius: 0.75rem;
	}
	.ge-add-photo:hover .ge-add-photo-frame {
		border-color: color-mix(in srgb, var(--primary) 50%, transparent);
		background-color: color-mix(in srgb, var(--primary) 5%, transparent);
		color: var(--primary);
	}
</style>

<script is:inline>
	(function () {
