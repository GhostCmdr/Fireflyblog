			set("name", a.name);
			set("description", a.description);
			set("location", a.location);
			set("date", a.date);
			set("tags", (a.tags || []).join(", "));
			set("cover", a.cover);
			set("password", a.password);
			set("passwordHint", a.passwordHint);
		}

		/** 信息面板：封面预览 + 状态标签 + 只读/编辑两态 */
