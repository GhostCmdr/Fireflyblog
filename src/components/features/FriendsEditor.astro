---
// [OURS] 友链就地编辑器（/friends/ 页面）
//
// 用途：配置过 GitHub Token 的浏览器里，友链页标题行右侧会出现「编辑友链」按钮；
//      点开弹窗即可直接增删改友链，保存时由浏览器用 GitHub Contents API
//      整块重写 src/config/ours/values.ts 里的 oursFriendsConfig 数组。
//
// 设计约定（与 AGENTS.md 的 Repository-Specific Conventions 一致）：
//   - 只重写方括号内的数组体，文件其余部分字节级不动
//   - 字段顺序固定 title → imgurl → desc → siteurl → tags → weight → enabled
//   - weight 由列表顺序自动生成（首条最大），用户不必手填
//   - 生成为纯数据（无注释），所以 values.ts 的注释必须写在数组外部
//   - 无前端框架、无新依赖，缩进 tab、字符串双引号
import type { FriendLink } from "@/types/friendsConfig";

interface Props {
	/** 当前全部友链（含 enabled: false 的，便于重新启用）；顺序按 weight 降序 */
	items?: FriendLink[];
}

const { items = [] } = Astro.props;
const initialJson = JSON.stringify(items);
---

<div id="fe-root" class="ml-auto flex shrink-0 items-center" data-items={initialJson}>
	<!-- 编辑入口：默认隐藏，脚本判定通过后才显示（无 Token 的访客完全看不到） -->
	<button
		id="fe-open"
		type="button"
		class="ml-auto hidden shrink-0 cursor-pointer items-center gap-1.5 rounded-lg bg-(--primary) px-3 py-1.5 text-sm font-medium text-white transition-all hover:opacity-90 active:scale-95 focus-visible:ring-2 focus-visible:ring-(--primary)/40 focus-visible:outline-none dark:text-black/80"
		aria-label="编辑友链"
		>
		<svg
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 24 24"
			width="16"
			height="16"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
			><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"></path><path
				d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg
		>
		<span class="hidden sm:inline">管理</span>
		</button>

	<!-- 弹窗 -->
	<div
		id="fe-mask"
		class="fixed inset-0 z-[999] hidden items-center justify-center p-4 backdrop-blur-sm sm:p-6"
		style="background: rgba(0, 0, 0, 0.45); overscroll-behavior: contain;"
		role="dialog"
		aria-modal="true"
		aria-label="编辑友链"
	>
		<div
			id="fe-panel"
			class="card-base relative flex max-h-[92vh] w-full max-w-[720px] flex-col shadow-2xl sm:max-h-[85vh]"
		>
			<!-- 头部（固定） -->
			<div
				class="flex shrink-0 items-start justify-between gap-3 border-b border-(--line-divider) px-5 py-4"
			>
				<div class="min-w-0">
					<div class="text-lg font-bold text-neutral-900 dark:text-neutral-100">
						编辑友链
					</div>
					<div id="fe-subtitle" class="mt-0.5 text-xs text-neutral-500 dark:text-neutral-400">
						列表顺序 = 页面显示顺序（保存时自动生成权重）
					</div>
				</div>
				<button
					id="fe-close"
					type="button"
					class="shrink-0 rounded-lg p-1.5 text-neutral-400 transition-colors hover:bg-neutral-100 hover:text-neutral-700 dark:hover:bg-neutral-700 dark:hover:text-neutral-200"
					aria-label="关闭"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						width="20"
						height="20"
						fill="currentColor"
						aria-hidden="true"
						><path
							d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
						></path></svg
					>
				</button>
			</div>

			<!-- 状态提示条（按需显示）：
			     外观与原来完全一致（同 padding、同字号、同语义色），只把定位改为浮层 ——
			     absolute 脱离文档流后，它出现/消失不再把列表推下再弹回（实测 33px 位移）。
			     位置＝头部正下方（即它原本的视觉位置），因此会盖住列表第一行上沿，这是"不占位"的代价。
			     top 的 4.875rem 等于头部实测高度（约 70.2px @root14.4），头部改版需同步此值。 -->
			<div
				id="fe-msg"
				class="absolute inset-x-0 top-[4.875rem] z-10 hidden px-5 py-2.5 pr-11 text-sm"
				role="status"
				aria-live="polite"
			>
				<span id="fe-msg-text"></span>
				<button
					id="fe-msg-close"
					type="button"
					class="absolute top-1/2 right-2.5 -translate-y-1/2 rounded p-1 text-lg opacity-70 transition-opacity hover:opacity-100"
					aria-label="关闭提示"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						width="1em"
						height="1em"
						fill="currentColor"
						aria-hidden="true"
						><path
							d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
						></path></svg
					>
				</button>
			</div>

			<!-- 列表（独立滚动）。flex + 空态 grow ⇒ 空态提示垂直居中于弹窗 -->
			<div
				id="fe-body"
				class="fe-scroll flex h-[380px] grow flex-col overflow-y-auto px-5 py-4"
				style="overscroll-behavior: contain;"
			>
				<div id="fe-list" class="flex flex-col gap-3"></div>
				<div
					id="fe-empty"
					class="hidden grow flex-col items-center justify-center text-center text-sm text-neutral-400 dark:text-neutral-500"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						width="36"
						height="36"
						fill="currentColor"
						aria-hidden="true"
						class="mb-2 opacity-60"
						><path
							d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
						></path></svg
					>
					还没有友链，点下方「+ 添加友链」开始。
				</div>
			</div>

			<!-- 底部操作条（固定） -->
			<div
				class="flex shrink-0 flex-col gap-2 border-t border-(--line-divider) px-5 py-3.5 sm:flex-row sm:items-center sm:justify-between"
			>
				<div class="flex items-center gap-2">
					<button
						id="fe-add"
						type="button"
						class="rounded-xl border border-dashed border-(--line-divider) px-3.5 py-2 text-sm font-medium text-neutral-600 transition-colors hover:border-(--primary)/50 hover:bg-(--primary)/5 hover:text-(--primary) dark:text-neutral-300"
					>
						+ 添加友链
					</button>
					<!-- [OURS] 唯一的主动拉取入口：读取全部走页面内嵌快照（打开弹窗零请求） -->
					<button
						id="fe-refresh"
						type="button"
						class="rounded-xl border border-(--line-divider) px-3.5 py-2 text-sm font-medium text-neutral-600 transition-colors hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-700"
					>
						刷新
					</button>
				</div>
				<div class="flex items-center gap-2">
					<button
						id="fe-cancel"
						type="button"
						class="flex-1 rounded-xl border border-(--line-divider) px-4 py-2 text-sm font-medium text-neutral-600 transition-colors hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-700 sm:flex-none"
					>
						取消
					</button>
					<button
						id="fe-save"
						type="button"
						class="flex-1 rounded-xl bg-(--primary) px-4 py-2 text-sm font-semibold text-white transition-all duration-200 hover:brightness-110 disabled:cursor-not-allowed disabled:opacity-60 sm:flex-none"
					>
						提交到云端
					</button>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- [OURS] 站内风格确认框：替代原生 window.confirm（否则会弹出「localhost:4321 显示」这种浏览器弹窗） -->
<div
	id="fe-confirm"
	class="fixed inset-0 z-[1000] hidden items-center justify-center p-4"
	style="overscroll-behavior: contain;"
	role="alertdialog"
	aria-modal="true"
	aria-labelledby="fe-confirm-title"
>
	<div
		id="fe-confirm-panel"
		class="card-base w-full max-w-[380px] border border-(--line-divider) shadow-2xl backdrop-blur-sm"
	>
		<div class="px-5 pt-5 pb-4">
			<div class="flex items-start gap-3">
				<span id="fe-confirm-icon" class="shrink-0" style="color: #DC2626;">
					<svg
						data-kind="danger"
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						width="24"
						height="24"
						fill="currentColor"
						aria-hidden="true"
						><path
							d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
						></path></svg
					>
					<svg
						data-kind="warning"
						class="hidden"
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						width="24"
						height="24"
						fill="currentColor"
						aria-hidden="true"
						><path d="M12 2 1 21h22L12 2zm1 14h-2v2h2v-2zm0-7h-2v5h2V9z"></path></svg
					>
					<svg
						data-kind="info"
						class="hidden"
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						width="24"
						height="24"
						fill="currentColor"
						aria-hidden="true"
						><path
							d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"
						></path></svg
					>
				</span>
				<div class="min-w-0 flex-1">
					<div
						id="fe-confirm-title"
						class="text-[1.0625rem] leading-6 font-bold text-neutral-900 dark:text-neutral-100"
					>
						请确认
					</div>
					<div
						id="fe-confirm-text"
						class="mt-1.5 text-sm leading-6 break-words text-neutral-600 dark:text-neutral-400"
					>
					</div>
				</div>
			</div>
		</div>
		<div
			class="flex items-center justify-end gap-2 px-5 py-3.5"
		>
			<button
				id="fe-confirm-cancel"
				type="button"
				class="rounded-lg border border-(--line-divider) px-4 py-2 text-sm font-medium text-neutral-600 transition-colors hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-700"
			>
				取消
			</button>
			<button
				id="fe-confirm-ok"
				type="button"
				class="rounded-lg px-4 py-2 text-sm font-semibold text-white shadow-sm transition-all duration-200 hover:brightness-110"
			>
				确定
			</button>
		</div>
	</div>
</div>

<style>
	/* 弹窗内滚动条：保留"细 + 圆角"的形状，颜色用接近系统默认的灰（不再跟随主色）。
	   纯 CSS 绘制层，不参与布局、无 JS、无渲染负担。
	   Chrome/Edge/Safari 走 ::-webkit-scrollbar；Firefox 走 scrollbar-width/scrollbar-color。 */
	.fe-scroll {
		scrollbar-width: thin;
		scrollbar-color: rgba(0, 0, 0, 0.3) transparent;
	}
	/* 深色主题下用浅灰，贴近系统默认观感 */
	:global(.dark) .fe-scroll {
		scrollbar-color: rgba(255, 255, 255, 0.28) transparent;
	}
	.fe-scroll::-webkit-scrollbar {
		width: 8px;
		height: 8px;
	}
	.fe-scroll::-webkit-scrollbar-track {
		background: transparent;
	}
	.fe-scroll::-webkit-scrollbar-thumb {
		background: rgba(0, 0, 0, 0.3);
		background-clip: content-box;
		border: 2px solid transparent;
		border-radius: 999px;
	}
	.fe-scroll::-webkit-scrollbar-thumb:hover {
		background: rgba(0, 0, 0, 0.45);
		background-clip: content-box;
	}
	:global(.dark) .fe-scroll::-webkit-scrollbar-thumb {
		background: rgba(255, 255, 255, 0.28);
		background-clip: content-box;
	}
	:global(.dark) .fe-scroll::-webkit-scrollbar-thumb:hover {
		background: rgba(255, 255, 255, 0.42);
		background-clip: content-box;
	}

	/* 弹窗列表：始终预留滚动条槽位。
	   否则"内容没撑满（无滚动条）→ 撑出滚动条"会让列表可用宽度瞬间变化（实测 720 → 710），
	   表现为打开弹窗时卡片横向"弹"一下。只作用于本容器，不影响页面根滚动条与 vw。 */
	#fe-body {
		scrollbar-gutter: stable;
	}

	/* 弹窗内所有按钮都用手型光标（<button> 浏览器默认不给 pointer） */
	#fe-open,
	#fe-root > button,
	#fe-panel button,
	#fe-confirm-panel button {
		cursor: pointer;
	}

	/* ── 确认框内的按钮不显示键盘焦点环 ──
	   原因同动态编辑器：askConfirm() 会程序化聚焦「取消」，按 Esc（键盘）唤出确认框时
	   命中全站 :focus-visible 基线，画出一圈橙框。纯 CSS、零运行时开销。 */
	#fe-confirm button:focus,
	#fe-confirm button:focus-visible {
		outline: none;
	}
</style>

<script is:inline>
	(function () {
		"use strict";

		// 【swup 重入】本站点 @swup/scripts-plugin 会在 content:replace 时**重新执行全文档内联脚本**
		// （无头浏览器打点实测：一次切页里出现两次 `script exec`，其间一次 `cleanup called`）。
		// 因此本组件每次切回友链页都会重放，重放前先执行上一次登记的清理 —— 移除上一轮的 keydown
		// 监听与 body 上那份旧弹窗，避免监听器与 DOM 累积（重复绑定会让「保存」被触发多次）。
		// ⚠️ 切勿移除该插件或给本脚本加豁免：那时脚本不再重放，切页后入口按钮会失效（按钮已被换成
		// 新元素，而绑定只发生在首屏）。重入的正式处理见文件末尾的 adoptDialog / attachEntry。
		try {
			if (typeof window.__feCleanup === "function") window.__feCleanup();
		} catch (e) {
			/* 清理失败不得阻断本次初始化 */
		}

		var root = document.getElementById("fe-root");
		if (!root) return;

		var btnOpen = document.getElementById("fe-open");
		var mask = document.getElementById("fe-mask");
		var panel = document.getElementById("fe-panel");
		var listEl = document.getElementById("fe-list");
		var emptyEl = document.getElementById("fe-empty");
		var msgEl = document.getElementById("fe-msg");
		var subtitleEl = document.getElementById("fe-subtitle");
		var btnAdd = document.getElementById("fe-add");
		var btnRefresh = document.getElementById("fe-refresh");
		var btnSave = document.getElementById("fe-save");
		var btnCancel = document.getElementById("fe-cancel");
		var btnClose = document.getElementById("fe-close");
		var msgCloseBtn = document.getElementById("fe-msg-close");
		var msgTextEl = document.getElementById("fe-msg-text");

		// 编辑器维护的数据文件（与 values.ts 中 oursFriendsConfig 的位置一致）
		var FILE_PATH = "src/config/ours/values.ts";
		var MARKER = "export const oursFriendsConfig";
		var DEFAULT_REPO = "GhostCmdr/Fireflyblog";

		var state = {
			items: [],
			saved: null, // "已保存"快照：放弃修改 / 重新打开弹窗时回滚用
			dirty: false,
			busy: false,
		};

		/* ───────────── 小工具 ───────────── */

		function cfg() {
			var ls = window.localStorage;
			return {
				token: ls.getItem("gh-token") || ls.getItem("gh-editor-token") || "",
				repo: ls.getItem("gh-repo") || ls.getItem("gh-editor-repo") || DEFAULT_REPO,
				branch: ls.getItem("gh-branch") || "main",
			};
		}

		function escHtml(s) {
			return String(s == null ? "" : s)
				.replace(/&/g, "&amp;")
				.replace(/</g, "&lt;")
				.replace(/>/g, "&gt;")
				.replace(/"/g, "&quot;")
				.replace(/'/g, "&#39;");
		}

		// 幂等绑定：本站点 @swup/scripts-plugin 会在切页时**重新执行全文档内联脚本**，同一元素会被
		// 多个闭包反复 addEventListener。副作用：切换类操作会被"开 + 关"互相抵消，提交 / 删除类
		// 会被重复触发（实测 `#fe-open` 的监听器数量会随切页累积）。标记写在元素上 ⇒ 跨闭包可见
		// ⇒ 每个「元素 + 事件」只绑一次；元素换新时会自动重新绑定。
		function bindOnce(el, type, fn) {
			if (!el || !el.addEventListener) return;
			var flag = "__feBound_" + type;
			if (el[flag]) return;
			el[flag] = true;
			el.addEventListener(type, fn);
		}

		function showMsg(text, kind) {
			// 底色恢复为占位版的原始取值（半透明 10~12% 语义色），逐字与历史一致：
			// 它靠与背后底色（面板的 --card-bg，壁纸透明模式下是 --card-bg-transparent）叠加呈现淡彩，
			// 因此观感与占位时期完全相同。cssText 只写 background/color，不影响 class 上的定位与显隐。
			var palette = {
				info: "background: rgba(59,130,246,0.10); color: #2563EB;",
				success: "background: rgba(22,163,74,0.12); color: #15803D;",
				warn: "background: rgba(217,119,6,0.12); color: #B45309;",
				error: "background: rgba(220,38,38,0.12); color: #B91C1C;",
			};
			msgEl.style.cssText = palette[kind] || palette.info;
			// 注意：必须写进 #fe-msg-text 而不是 #fe-msg —— 对父元素赋 textContent 会清空所有子节点，
			// 把里面的关闭按钮一起抹掉（这条坑踩过一次）。
			if (msgTextEl) msgTextEl.textContent = text;
			else msgEl.textContent = text;
			msgEl.classList.remove("hidden");
		}

		function hideMsg() {
			msgEl.classList.add("hidden");
		}

		function setBusy(on, label) {
			state.busy = !!on;
			btnSave.disabled = !!on;
			btnSave.textContent = on ? "提交中…" : "提交到云端";
			if (on && label) showMsg(label, "info");
		}

		function setSubtitle() {
			subtitleEl.textContent =
				"共 " + state.items.length + " 条 · 列表顺序 = 页面显示顺序（保存时自动生成权重）";
			emptyEl.classList.toggle("hidden", state.items.length > 0);
			emptyEl.classList.toggle("flex", state.items.length === 0);
		}

		/* ───────────── 解析 values.ts ───────────── */

		// 定位 oursFriendsConfig 数组体：
		//   起点 —— 必须锁定 "= ["，不能用第一个 "["
		//          （声明行是 `... : FriendLink[] = [`，第一个 [ 属于类型标注，会拼坏文件）
		//   终点 —— 向下找「行首的 ];」（数组内存在 tags: ["Blog"] 这类内容，不能用第一个 ] 判断）
		//   区间 —— body 以换行开头、以逗号结尾（即 [ 与 行首]; 之间的原文）
		function locateArrayBody(src) {
			var decl = src.indexOf(MARKER);
			if (decl === -1) return null;
			var eq = src.indexOf("= [", decl);
			if (eq === -1) return null;
			var open = eq + 2;
			var close = src.indexOf("\n];", open);
			if (close === -1) return null;
			return { open: open, close: close, body: src.slice(open + 1, close) };
		}

		// 按顶层逗号切分（跳过引号内的逗号）：单行 / 多行标签数组都能拆成一项一项
		function splitTopLevel(s) {
			var out = [];
			var buf = "";
			var quote = "";
			for (var i = 0; i < s.length; i++) {
				var ch = s.charAt(i);
				if (quote) {
					buf += ch;
					if (ch === "\\") {
						buf += s.charAt(i + 1) || "";
						i++;
						continue;
					}
					if (ch === quote) quote = "";
					continue;
				}
				if (ch === '"' || ch === "'") {
					quote = ch;
					buf += ch;
					continue;
				}
				if (ch === ",") {
					out.push(buf);
					buf = "";
					continue;
				}
				buf += ch;
			}
			out.push(buf);
			return out;
		}

		// 与生成侧对称：两种引号都认（quote() 在"值含双引号"时会改用单引号），并按 Biome 规则反转义
		function parseValue(raw) {
			var v = raw.trim().replace(/,$/, "").trim();
			var first = v.charAt(0);
			if (first === '"' || first === "'") {
				var end = v.lastIndexOf(first);
				if (end > 0) return v.slice(1, end).replace(/\\(["'\\])/g, "$1");
			}
			if (first === "[") {
				var last = v.lastIndexOf("]");
				var inside = last > 0 ? v.slice(1, last) : "";
				if (!inside.trim()) return [];
				return splitTopLevel(inside)
					.map(function (x) {
						return parseValue(x);
					})
					.filter(function (x) {
						return x !== "";
					});
			}
			if (v === "true") return true;
			if (v === "false") return false;
			if (v !== "" && !isNaN(Number(v))) return Number(v);
			return v;
		}

		// 解析数组体（格式由本编辑器与项目约定固定，无嵌套对象）：
		// 先按 `{` / `}` 切块，块内以「key:」为分段起点、把后续行拼回同一个值 ——
		// 这样 Biome 生成的"超宽值换行"（key: 换行 + 缩进值）与"多行数组"都能正确读回。
		function parseArrayBody(body) {
			var out = [];
			var cur = null;
			var key = null;
			var buffer = "";
			function flushValue() {
				if (!cur || key == null) return;
				cur[key] = parseValue(buffer);
				key = null;
				buffer = "";
			}
			var lines = body.split("\n");
			for (var i = 0; i < lines.length; i++) {
				var line = lines[i].trim();
				if (!line || line.indexOf("//") === 0) continue;
				if (line === "{" || line === "{,") {
					flushValue();
					cur = {};
					continue;
				}
				if (line === "}" || line === "},") {
					flushValue();
					if (cur) out.push(cur);
					cur = null;
					continue;
				}
				if (!cur) continue;
				var m = line.match(/^([A-Za-z_][A-Za-z0-9_]*)\s*:\s*([\s\S]*)$/);
				if (m) {
					flushValue();
					key = m[1];
					buffer = m[2];
					continue;
				}
				// 续行：上一个键的值还没写完（超宽标量的下一行 / 多行数组的元素行）
				if (key != null) buffer += " " + line;
			}
			flushValue();
			return out;
		}

		function normalize(raw) {
			return {
				title: String(raw.title == null ? "" : raw.title),
				imgurl: String(raw.imgurl == null ? "" : raw.imgurl),
				desc: String(raw.desc == null ? "" : raw.desc),
				siteurl: String(raw.siteurl == null ? "" : raw.siteurl),
				tags: Array.isArray(raw.tags) ? raw.tags.map(String) : [],
				weight: Number(raw.weight) || 0,
				enabled: raw.enabled !== false,
			};
		}

		function sortByWeight(arr) {
			return arr.slice().sort(function (a, b) {
				return (Number(b.weight) || 0) - (Number(a.weight) || 0);
			});
		}

		/* ───────────── 生成数组体文本 ───────────── */

		// ── 与 Biome 的 formatter 对齐（否则 biome ci 会判 format error，用户每次保存都会让 CI 变红）──
		// 依据 biome.json：formatter.indentStyle = tab，未设 indentWidth（默认 2），lineWidth 默认 80
		// 实测探针结论：`imgurl: "值",` 在 65 字符值时可放单行（65+15=80），66 字符必须换行；
		//              超宽的数组则每个元素独占一行并带尾随逗号。
		var LINE_WIDTH = 80;
		var INDENT_WIDTH = 2;

		// Biome 用 unicode-width 计算行宽：CJK / 全角 / emoji 等宽字符按 2 计
		function charWidth(cp) {
			if (
				cp >= 0x1100 &&
				(cp <= 0x115f ||
					cp === 0x2329 ||
					cp === 0x232a ||
					(cp >= 0x2e80 && cp <= 0xa4cf && cp !== 0x303f) ||
					(cp >= 0xac00 && cp <= 0xd7a3) ||
					(cp >= 0xf900 && cp <= 0xfaff) ||
					(cp >= 0xfe30 && cp <= 0xfe6f) ||
					(cp >= 0xff00 && cp <= 0xff60) ||
					(cp >= 0xffe0 && cp <= 0xffe6) ||
					(cp >= 0x1f300 && cp <= 0x1faff) ||
					(cp >= 0x20000 && cp <= 0x3fffd))
			)
				return 2;
			return 1;
		}

		function textWidth(s) {
			var w = 0;
			for (var i = 0; i < s.length; i++) {
				var cp = s.codePointAt(i);
				if (cp > 0xffff) i++;
				w += charWidth(cp);
			}
			return w;
		}

		// Biome 的 quoteStyle 是 double，但字符串内含双引号、且不含单引号时改用单引号（减少转义）
		function quote(s) {
			var v = String(s == null ? "" : s);
			if (v.indexOf('"') !== -1 && v.indexOf("'") === -1) {
				return "'" + v.replace(/\\/g, "\\\\") + "'";
			}
			return '"' + v.replace(/\\/g, "\\\\").replace(/"/g, '\\"') + '"';
		}

		function tabs(n) {
			var s = "";
			for (var i = 0; i < n; i++) s += "\t";
			return s;
		}

		function fits(tabCount, text) {
			return tabCount * INDENT_WIDTH + textWidth(text) <= LINE_WIDTH;
		}

		// 标量字段：放不下时把值换到下一行并多缩进一级（Biome 行为）
		function scalarField(tabCount, key, valueText) {
			var oneLine = key + ": " + valueText + ",";
			if (fits(tabCount, oneLine)) return tabs(tabCount) + oneLine + "\n";
			return tabs(tabCount) + key + ":\n" + tabs(tabCount + 1) + valueText + ",\n";
		}

		// 数组字段：放不下时每个元素独占一行
		function arrayField(tabCount, key, valueTexts) {
			var oneLine = key + ": [" + valueTexts.join(", ") + "],";
			if (fits(tabCount, oneLine)) return tabs(tabCount) + oneLine + "\n";
			var out = tabs(tabCount) + key + ": [\n";
			for (var i = 0; i < valueTexts.length; i++) {
				out += tabs(tabCount + 1) + valueTexts[i] + ",\n";
			}
			return out + tabs(tabCount) + "],\n";
		}

		function buildArrayBody(items) {
			var total = items.length;
			var out = "\n";
			for (var i = 0; i < total; i++) {
				var it = items[i];
				out += "\t{\n";
				out += scalarField(2, "title", quote(it.title));
				out += scalarField(2, "imgurl", quote(it.imgurl));
				out += scalarField(2, "desc", quote(it.desc));
				out += scalarField(2, "siteurl", quote(it.siteurl));
				if (it.tags && it.tags.length) {
					out += arrayField(
						2,
						"tags",
						it.tags.map(function (t) {
							return quote(t);
						}),
					);
				}
				out += scalarField(2, "weight", String(total - i));
				out += scalarField(2, "enabled", it.enabled === false ? "false" : "true");
				out += "\t},\n";
			}
			return out;
		}

		/* ───────────── 渲染 ───────────── */

		var FIELD_LABELS = {
			title: "标题",
			imgurl: "图标地址",
			desc: "描述",
			siteurl: "站点地址",
			tags: "标签（逗号分隔，中英文都行）",
		};

		function fieldHtml(name, value, placeholder, extra) {
			return (
				'<label class="flex min-w-0 flex-col gap-1">' +
				'<span class="text-[11px] font-medium text-neutral-500 dark:text-neutral-400">' +
				escHtml(FIELD_LABELS[name] || name) +
				"</span>" +
				'<div class="flex items-center gap-2">' +
				'<input data-f="' +
				name +
				'" type="text" value="' +
				escHtml(value) +
				'" placeholder="' +
				escHtml(placeholder || "") +
				'" class="min-w-0 grow rounded-lg border border-(--line-divider) bg-transparent px-2.5 py-1.5 text-sm text-neutral-900 outline-none transition-all focus:border-(--primary) focus:ring-1 focus:ring-(--primary)/40 dark:text-neutral-100" />' +
				(extra || "") +
				"</div>" +
				"</label>"
			);
		}

		function itemHtml(it) {
			var thumb =
				'<img data-f="thumb" src="' +
				escHtml(it.imgurl) +
				'" alt="" class="h-9 w-9 shrink-0 rounded-md border border-(--line-divider) object-cover" onerror="this.style.visibility=&#39;hidden&#39;" />';
			return (
				'<div class="fe-item card-base relative rounded-xl border border-(--line-divider) p-3">' +
				'<div class="flex items-start gap-2">' +
				// 排序按钮
				'<div class="flex shrink-0 flex-col gap-1 pt-4">' +
				'<button type="button" data-act="up" title="上移" aria-label="上移" class="rounded-md border border-(--line-divider) px-1.5 text-[11px] leading-5 text-neutral-500 transition-colors hover:border-(--primary)/50 hover:text-(--primary)">▲</button>' +
				'<button type="button" data-act="down" title="下移" aria-label="下移" class="rounded-md border border-(--line-divider) px-1.5 text-[11px] leading-5 text-neutral-500 transition-colors hover:border-(--primary)/50 hover:text-(--primary)">▼</button>' +
				"</div>" +
				// 字段区
				'<div class="grid min-w-0 grow grid-cols-1 gap-2 sm:grid-cols-2">' +
				fieldHtml("title", it.title, "友链名称") +
				fieldHtml("siteurl", it.siteurl, "https://example.com") +
				fieldHtml("imgurl", it.imgurl, "https://a.favicon.im/example.com", thumb) +
				fieldHtml("desc", it.desc, "一句话描述") +
				fieldHtml("tags", (it.tags || []).join(", "), "Blog, 技术") +
				// 启用开关
				'<label class="flex items-center gap-2 self-end pb-1">' +
				'<span class="text-[11px] font-medium text-neutral-500 dark:text-neutral-400">启用</span>' +
				'<span class="relative inline-flex h-5 w-9 shrink-0 cursor-pointer items-center">' +
				'<input data-f="enabled" type="checkbox" class="peer sr-only" ' +
				(it.enabled === false ? "" : "checked") +
				" />" +
				'<span class="absolute inset-0 rounded-full bg-neutral-300 transition-colors peer-checked:bg-(--primary) dark:bg-neutral-600"></span>' +
				'<span class="absolute left-0.5 h-4 w-4 rounded-full bg-white shadow transition-transform peer-checked:translate-x-4"></span>' +
				"</span>" +
				"</label>" +
				"</div>" +
				// 删除
				'<button type="button" data-act="del" title="删除" aria-label="删除" class="mt-4 shrink-0 rounded-lg border border-red-500/40 p-1.5 text-red-500 transition-colors hover:bg-red-500/10">' +
				'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M9 3v1H4v2h16V4h-5V3H9zM6 8v12a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V8H6zm3 2h2v9H9v-9zm4 0h2v9h-2v-9z"></path></svg>' +
				"</button>" +
				"</div>" +
				"</div>"
			);
		}

		function defaultItem() {
			return { title: "", imgurl: "", desc: "", siteurl: "", tags: [], enabled: true };
		}

		function render() {
			listEl.innerHTML = state.items.map(itemHtml).join("");
			setSubtitle();
		}

		/* ───────────── 从 DOM 收集 ───────────── */

		function collect() {
			var nodes = listEl.querySelectorAll(".fe-item");
			var out = [];
			for (var i = 0; i < nodes.length; i++) {
				var n = nodes[i];
				var get = function (f) {
					var el = n.querySelector('[data-f="' + f + '"]');
					return el ? el.value : "";
				};
				out.push({
					title: get("title").trim(),
					imgurl: get("imgurl").trim(),
					desc: get("desc").trim(),
					siteurl: get("siteurl").trim(),
					tags: get("tags")
						.split(/[,，]/)
						.map(function (t) {
							return t.trim();
						})
						.filter(Boolean),
					enabled: !!n.querySelector('[data-f="enabled"]').checked,
				});
			}
			return out;
		}

		function validate(items) {
			for (var i = 0; i < items.length; i++) {
				var n = i + 1;
				if (!items[i].title) return "请先修正：第 " + n + " 条的「标题」不能为空";
				if (!items[i].imgurl) return "请先修正：第 " + n + " 条的「图标地址」不能为空";
				if (!items[i].siteurl) return "请先修正：第 " + n + " 条的「站点地址」不能为空";
				if (!/^https?:\/\//i.test(items[i].siteurl))
					return "请先修正：第 " + n + " 条的「站点地址」需以 http(s):// 开头";
				if (!/^(https?:\/\/|\/)/i.test(items[i].imgurl))
					return "请先修正：第 " + n + " 条的「图标地址」需为 http(s):// 或 / 开头的地址";
			}
			return "";
		}

		function dupWarning(items) {
			var seenT = {};
			var seenU = {};
			for (var i = 0; i < items.length; i++) {
				var t = items[i].title;
				var u = items[i].siteurl;
				if (seenT[t]) return "第 " + seenT[t] + " 条与第 " + (i + 1) + " 条的「标题」相同。";
				if (seenU[u]) return "第 " + seenU[u] + " 条与第 " + (i + 1) + " 条的「站点地址」相同。";
				seenT[t] = i + 1;
				seenU[u] = i + 1;
			}
			return "";
		}

		/* ───────────── GitHub 读写 ───────────── */

		function apiHeaders(token) {
			var h = { Accept: "application/vnd.github.v3+json" };
			if (token) h.Authorization = "token " + token;
			return h;
		}

		function contentsUrl(repo, path) {
			return (
				"https://api.github.com/repos/" +
				repo +
				"/contents/" +
				path.split("/").map(encodeURIComponent).join("/")
			);
		}

		/**
		 * GitHub API 失败的**全站统一**提示 —— 只分两类（相册 / 友链 / 动态三个编辑器同一套口径）：
		 *  ① Token 类（401 / 403）⇒ 返回**唯一那一句**（用户只需去更新 Token）；
		 *  ② 其它（404 / 409 / 5xx / 网络）⇒ 返回 ""，由调用方补上动作名。
		 */
		function tokenHint(res) {
			if (res.status === 401 || res.status === 403)
				return "Token 无效或已过期，请到编辑器页更新后再试。";
			return "";
		}

		function readRemote() {
			var c = cfg();
			// 用 Promise.reject 而不是同步 throw：调用方是 readRemote().then(...).catch(...)，
			// 同步异常会在 Promise 链建立之前抛出，catch 永远接不到（界面无提示、控制台报错）。
			if (!c.token)
				return Promise.reject(new Error("未检测到 GitHub Token，请先在编辑器页面配置。"));
			// 此处**故意不显示**"正在读取…"：消息条在文档流里，出现/消失会把列表整体推下再弹回
			// （实测 36px），打开弹窗时看起来就是内容"从下往上移动"了一下。
			return fetch(contentsUrl(c.repo, FILE_PATH) + "?ref=" + encodeURIComponent(c.branch), {
				headers: apiHeaders(c.token),
			}).then(function (res) {
				// 统一口径：Token 类只有一句；其它（含 404 配置路径写错）一律"读取失败"+点刷新
				if (!res.ok)
					throw new Error(tokenHint(res) || "读取失败，请点「刷新」后重试。");
				return res.json().then(function (data) {
					var text = decodeURIComponent(escape(atob(data.content.replace(/\n/g, ""))));
					return { text: text, sha: data.sha };
				});
			});
		}

		function writeRemote(newText, sha) {
			var c = cfg();
			return fetch(contentsUrl(c.repo, FILE_PATH), {
				method: "PUT",
				headers: Object.assign(apiHeaders(c.token), { "Content-Type": "application/json" }),
				body: JSON.stringify({
					message:
						"feat(friends): 网站端更新友链列表（" + state.items.length + " 条）",
					content: btoa(unescape(encodeURIComponent(newText))),
					sha: sha,
					branch: c.branch,
				}),
			}).then(function (res) {
				if (res.status === 409 || res.status === 422)
					throw new Error("文件已被改动，请点「重新读取」后再保存。");
				if (!res.ok)
					throw new Error(tokenHint(res) || "提交失败，请重试。");
				return res.json();
			});
		}

		/* ───────────── 主流程 ───────────── */

		// 记下"已保存"快照（读取成功 / 提交成功时）。放弃修改、重新打开弹窗都回滚到这里，
		// 否则上一次未提交的改动（开关、输入、增删、排序）会残留在内存与 DOM 里，
		// 表现为"关掉开关 → 放弃关闭 → 再打开还是关的"。
		function markSaved() {
			state.saved = state.items.map(normalize);
			state.dirty = false;
		}

		function restoreSaved() {
			if (!state.saved) return;
			var restored = state.saved.map(normalize);
			// 与当前内容一致时不重绘：整体 innerHTML 重建会造成瞬时空帧，
			// 打开弹窗时这次调用（内容本来没变）会被看成"闪一下"。
			if (JSON.stringify(restored) === JSON.stringify(state.items)) {
				state.dirty = false;
				return;
			}
			state.items = restored;
			state.dirty = false;
			render();
		}

		function loadFromRemote() {
			readRemote()
				.then(function (r) {
					var loc = locateArrayBody(r.text);
					if (!loc) throw new Error("未能在 " + FILE_PATH + " 中定位 oursFriendsConfig 数组。");
					// 用户在等待期间已开始编辑 ⇒ 不要用远端数据覆盖，避免吞掉刚落下的改动
					if (state.dirty) return;
					var pulled = sortByWeight(parseArrayBody(loc.body).map(normalize));
					// 与当前列表一致时不再重绘：首次打开已用页面快照渲染过，
					// 这次多余的整体重建会让列表瞬时空一帧（也是"打开时弹一下"的加重因素）。
					var changed = JSON.stringify(pulled) !== JSON.stringify(state.items);
					state.items = pulled;
					markSaved();
					if (changed) render();
					hideMsg();
				})
				.catch(function (e) {
					// 读取失败时退回页面初始数据，仍可编辑、可重试
					if (!state.items.length) {
						try {
							state.items = sortByWeight(
								JSON.parse(root.getAttribute("data-items") || "[]").map(normalize),
							);
							markSaved();
							render();
						} catch (err) {
							/* ignore */
						}
					}
					showMsg(e.message || "读取失败，请点「刷新」后重试。", "error");
				});
		}

		/**
		 * 「刷新」：本编辑器的**唯一主动拉取入口**。
		 * 打开弹窗本身走页面内嵌快照（零请求、秒开），需要与仓库同步时点这里。
		 */
		function onRefreshClick() {
			if (state.busy) return;
			showMsg("正在从仓库刷新…", "info");
			loadFromRemote();
		}

		function openModal() {
			hideMsg(); // 先清掉上一次残留的提示（否则旧错误消息会带进本次打开的弹窗）
			mask.classList.remove("hidden");
			mask.classList.add("flex");
			// 焦点落到关闭按钮：键盘用户不必 Tab 穿越整份列表；preventScroll 避免顺带滚动页面
			btnClose.focus({ preventScroll: true });
			if (state.saved) {
				// 每次打开都回到"已保存"状态：上一次未提交的改动不会带进来
				restoreSaved();
			} else if (!state.items.length) {
				try {
					state.items = sortByWeight(
						JSON.parse(root.getAttribute("data-items") || "[]").map(normalize),
					);
					markSaved();
					render();
				} catch (e) {
					/* ignore */
				}
			}
			// ⚠️ 打开弹窗**不再自动拉远端**：列表首屏就用页面内嵌的快照渲染（零请求、秒开）。
			// 需要与仓库同步时点底部的「刷新」（唯一的主动拉取入口）。
		}

		// 直接关闭：无动画（不做位移/缩放过渡，也不延迟隐藏）
		function doClose() {
			state.dirty = false;
			mask.classList.add("hidden");
			mask.classList.remove("flex");
		}

		function closeModal(force) {
			if (state.dirty && !force) {
				askConfirm("改动还没提交到 GitHub，放弃后改动会丢失。", {
					title: "放弃未提交的修改？",
					okText: "确定",
					cancelText: "取消",
					kind: "warning",
				}).then(function (ok) {
					if (ok) {
						restoreSaved();
						doClose();
					}
				});
				return;
			}
			doClose();
		}

		/* ───────────── 站内确认框（替代 window.confirm，避免浏览器原生弹窗） ───────────── */

		var confirmEl = document.getElementById("fe-confirm");
		var confirmTitleEl = document.getElementById("fe-confirm-title");
		var confirmTextEl = document.getElementById("fe-confirm-text");
		var confirmOkBtn = document.getElementById("fe-confirm-ok");
		var confirmCancelBtn = document.getElementById("fe-confirm-cancel");
		var confirmIconEl = document.getElementById("fe-confirm-icon");
		var confirmIcons = confirmIconEl ? confirmIconEl.querySelectorAll("svg[data-kind]") : [];
		var confirmResolve = null;

		// 返回 Promise<boolean>：true = 确定，false = 取消
		// 三种语义：danger=删除/破坏性操作（红）、warning=会丢改动的操作（橙）、info=提醒类（主色）
		var CONFIRM_SKINS = {
			danger: { fg: "#DC2626", btn: "#DC2626" },
			warning: { fg: "#B45309", btn: "#DC2626" },
			info: { fg: "var(--primary)", btn: "var(--primary)" },
		};

		/* ───────────── 二次确认框期间的滚动拦截 ─────────────
		   主弹窗**不锁**根滚动（滚动条常显、鼠标移出弹窗才滚网页）。
		   确认框是模态决策：出现期间**不隐藏滚动条** —— 用 overflow:hidden 会让滚动条消失、
		   页面内容横向跳动（用户明确反馈过），改为在捕获阶段拦截"滚动类输入"：
		   滚轮 / 触摸滑动 / 方向键·翻页键·空格 ⇒ 滚动条始终可见、页面内容不动。
		   本实现与 DynamicEditor.astro 的同名实现逐字一致（两个页面行为必须相同）。 */
		var scrollLockCount = 0;
		var SCROLL_KEYS = {
			ArrowUp: 1,
			ArrowDown: 1,
			PageUp: 1,
			PageDown: 1,
			Home: 1,
			End: 1,
			" ": 1,
		};

		function preventScrollInput(e) {
			if (scrollLockCount > 0) e.preventDefault();
		}

		function preventScrollKey(e) {
			if (scrollLockCount > 0 && SCROLL_KEYS[e.key]) e.preventDefault();
		}

		function lockPageScroll() {
			scrollLockCount++;
			if (scrollLockCount > 1) return;
			window.addEventListener("wheel", preventScrollInput, { passive: false, capture: true });
			window.addEventListener("touchmove", preventScrollInput, {
				passive: false,
				capture: true,
			});
			window.addEventListener("keydown", preventScrollKey, { capture: true });
		}

		function unlockPageScroll() {
			if (scrollLockCount > 0) scrollLockCount--;
			if (scrollLockCount > 0) return;
			scrollLockCount = 0;
			window.removeEventListener("wheel", preventScrollInput, { capture: true });
			window.removeEventListener("touchmove", preventScrollInput, { capture: true });
			window.removeEventListener("keydown", preventScrollKey, { capture: true });
		}

		function askConfirm(text, opts) {
			opts = opts || {};
			var kind = opts.kind || (opts.danger === false ? "info" : "danger");
			var skin = CONFIRM_SKINS[kind] || CONFIRM_SKINS.danger;
			confirmTitleEl.textContent = opts.title || "请确认";
			confirmTextEl.textContent = text;
			confirmOkBtn.textContent = opts.okText || "确定";
			confirmCancelBtn.textContent = opts.cancelText || "取消";
			confirmOkBtn.style.backgroundColor = skin.btn;
			confirmIconEl.style.color = skin.fg;
			for (var i = 0; i < confirmIcons.length; i++) {
				confirmIcons[i].classList.toggle(
					"hidden",
					confirmIcons[i].getAttribute("data-kind") !== kind,
				);
			}
			confirmEl.classList.remove("hidden");
			confirmEl.classList.add("flex");
			lockPageScroll();
			// 默认焦点给「取消」：破坏性操作不该让回车直接落到确认键上
			confirmCancelBtn.focus({ preventScroll: true });
			return new Promise(function (resolve) {
				confirmResolve = resolve;
			});
		}

		function settleConfirm(result) {
			if (!confirmResolve) return;
			var resolve = confirmResolve;
			confirmResolve = null;
			confirmEl.classList.add("hidden");
			confirmEl.classList.remove("flex");
			unlockPageScroll(); // 无条件解锁
			resolve(result);
		}

		/* 滚动策略：不锁根滚动 ⇒ 网页滚动条始终正常显示（不会消失、不会跳位）。
		   弹窗内滚动不带动网页，靠两点实现：
		     1) #fe-body / #fe-mask 上的 overscroll-behavior: contain（纯 CSS，阻断滚动链）
		     2) 面板空白处的 wheel 兜底（见 initPanelWheelGuard，只做 preventDefault，无 DOM 操作）
		   鼠标在遮罩空白处滚动时仍放行给网页，符合预期。 */

		/* ───────────── 事件绑定 ───────────── */

		// 【关键】把弹窗搬到 <body> 下：
		// 组件位于友链卡片的标题行内，而站点卡片/布局祖先带 transform / backdrop-filter，
		// 这会让 position:fixed 相对"该祖先"而不是视口定位（弹窗被卡在卡片里、位置错乱）。
		// 挂到 body 后 fixed 才真正相对视口（相册页的弹窗是直接写在卡片外层的，同理）。
		if (mask.parentNode !== document.body) document.body.appendChild(mask);
		if (confirmEl.parentNode !== document.body) document.body.appendChild(confirmEl);

		// 面板空白处滚动的兜底：鼠标位于面板内但不在列表滚动容器上（头部/底部/卡片间隙）时，
		// 阻止滚动链传给网页；列表区内正常滚动；遮罩空白处不拦截（放行给网页滚动）。
		// 无 DOM 操作、无布局读取，开销可忽略。
		(function initPanelWheelGuard() {
			if (panel.__feWheelBound) return; // 脚本重放时不要重复绑
			panel.__feWheelBound = true;
			panel.addEventListener(
				"wheel",
				function (e) {
					if (e.target.closest && e.target.closest("#fe-body")) return;
					e.preventDefault();
				},
				{ passive: false },
			);
		})();

		// 入口按钮可见性：有 Token（或 ?manage=1 兜底）才显示。
		// 提成具名函数：swup 切页后入口按钮是新元素，需要重新判断一次可见性。
		function initVisibility() {
			if (!btnOpen) return;
			var hasToken = !!cfg().token;
			var force = /[?&]manage=1\b/.test(window.location.search);
			if (!hasToken && !force) return;
			btnOpen.classList.remove("hidden");
			btnOpen.classList.add("inline-flex");
		}
		initVisibility();

		// 入口按钮的绑定必须幂等：swup 重放的新闭包与 swup 钩子（attachEntry）都会尝试绑它，
		// 不加保护会每次切页 +1（实测 1 → 2），多个 handler 会让 openModal 被重复调用。
		// 标记写在元素上 ⇒ 跨闭包可见 ⇒ 无论两者谁先执行，最终都只有一次绑定。
		function bindOpen() {
			if (!btnOpen || btnOpen.__feOpenBound) return;
			btnOpen.__feOpenBound = true;
			btnOpen.addEventListener("click", openModal);
		}
		bindOpen();

		// 提示条右侧的关闭按钮：同样用元素级标记做幂等（切页会换成新元素，标记写在新元素上）
		function bindMsgClose() {
			if (!msgCloseBtn || msgCloseBtn.__feBound) return;
			msgCloseBtn.__feBound = true;
			msgCloseBtn.addEventListener("click", hideMsg);
		}
		bindMsgClose();
		bindOnce(btnClose, "click", function () {
			closeModal(false);
		});
		bindOnce(btnCancel, "click", function () {
			closeModal(false);
		});
		bindOnce(mask, "click", function (e) {
			if (e.target === mask) closeModal(false);
		});
		bindOnce(confirmOkBtn, "click", function () {
			settleConfirm(true);
		});
		bindOnce(confirmCancelBtn, "click", function () {
			settleConfirm(false);
		});
		bindOnce(confirmEl, "click", function (e) {
			if (e.target === confirmEl) settleConfirm(false);
		});
		// 具名函数：swup 重跑时需要能从 document 上精确移除（匿名函数无法移除）
		function onKeydown(e) {
			if (e.key !== "Escape") return;
			// 确认框优先：它开着时 Esc 只关它，不要连带把编辑弹窗也关掉
			if (!confirmEl.classList.contains("hidden")) {
				settleConfirm(false);
				return;
			}
			if (!mask.classList.contains("hidden")) closeModal(false);
		}
		// 监听器只注册一次：swup 换页不会重跑脚本，但清理函数（或将来启用脚本重放）可能把它摘掉，
		// 所以这里做成"保证存在"，切页钩子每次都会再确认一次
		function ensureKeydown() {
			if (window.__feKeydownBound) return;
			document.addEventListener("keydown", onKeydown);
			window.__feKeydownBound = true;
		}
		ensureKeydown();

		// 首屏快照：立刻用页面内嵌的 data-items 渲染一次，让弹窗打开那一帧就是终态。
		// 背景（2026-09-21 实测）：打开时会"列表从空 → N 条撑出滚动条"⇒ 内容宽度瞬跳 10px、
		// 高度也跳，表现为打开时抖一下。当日解法之一就是"首次用页面快照渲染"；
		// 后来为了修"放弃修改后重开仍保留旧值"改成了只在数组为空时才画，这条机制被意外丢掉，现补回。
		// 远端读取成功后若数据一致则跳过重绘（见 loadFromRemote 的比较）。
		(function bootstrapFromSnapshot() {
			try {
				var seed = sortByWeight(
					JSON.parse(root.getAttribute("data-items") || "[]").map(normalize),
				);
				// ⚠️ 快照为空时**也要渲染一次**：否则 #fe-empty 永远停在 hidden，
				// 打开弹窗只看到一片空白（历史 bug）。动态编辑器没有这个问题，是因为它的
				// render() 每次都会按"列表是否为空"切换空态显隐 —— 这里对齐同一行为。
				if (!seed.length) {
					render();
					return;
				}
				state.items = seed;
				markSaved();
				render();
			} catch (e) {
				/* 快照不可用时忽略，等远端数据 */
			}
		})();

		// 具名 handler：抽出后 attachEntry（swup 换页）才能简洁地重绑同一份逻辑
		function onAddClick() {
			state.items.push(defaultItem());
			state.dirty = true;
			render();
			var items = listEl.querySelectorAll(".fe-item");
			var last = items[items.length - 1];
			if (last) {
				last.scrollIntoView({ block: "nearest", behavior: "smooth" });
				var first = last.querySelector('[data-f="title"]');
				if (first) first.focus();
			}
		}
		bindOnce(btnAdd, "click", onAddClick);
		// ⚠️ 必须**同时**在首屏这里绑一次：attachEntry 只在 swup 换页时执行，
		// 只写在那里会导致"页面首次加载后按钮点了没反应"（实测踩过）。
		bindOnce(btnRefresh, "click", onRefreshClick);

		function onListClick(e) {
			var btn = e.target.closest ? e.target.closest("[data-act]") : null;
			if (!btn) return;
			var card = btn.closest(".fe-item");
			if (!card) return;
			var act = btn.getAttribute("data-act");

			if (act === "del") {
				var t = card.querySelector('[data-f="title"]');
				var name = t && t.value ? t.value : "这一条";
				askConfirm("「" + name + "」这条友链将被删除。", {
					title: "删除这条友链？",
					okText: "确定",
				}).then(function (ok) {
					if (!ok) return;
					card.parentNode.removeChild(card);
					// ⚠️ 必须从 DOM 重建 state（友链以 DOM 为唯一真相）——
					// 否则 setSubtitle() / 空态判断 / 保存都还按旧的 state.items 走：
					// 删光之后副标题仍显示"共 3 条"，中间也不出现空态提示（历史 bug）。
					state.items = collect();
					state.dirty = true;
					render();
				});
				return;
			}
			if (act === "up" || act === "down") {
				var prev = act === "up" ? card.previousElementSibling : card.nextElementSibling;
				if (!prev || !prev.classList || !prev.classList.contains("fe-item")) return;
				if (act === "up") card.parentNode.insertBefore(card, prev);
				else card.parentNode.insertBefore(prev, card);
				state.dirty = true;
			}
		}
		bindOnce(listEl, "click", onListClick);

		function onListInput() {
			state.dirty = true;
		}
		bindOnce(listEl, "input", onListInput);

		function doSave(items) {
			var c = cfg();
			if (!c.token) {
				showMsg("未检测到 GitHub Token，请先在编辑器页面配置。", "error");
				return;
			}

			// 保存前自检：把即将写入的文本解析回来，逐字段与内存数据比对 ——
			// 宁可阻止保存，也不把"读回来会变形/丢字段"的内容写进仓库。
			// （weight 由列表顺序重算，不参与比对。）
			var rtItems = parseArrayBody(buildArrayBody(items)).map(normalize);
			var RT_LABELS = {
				title: "标题",
				imgurl: "图标地址",
				desc: "描述",
				siteurl: "站点地址",
				tags: "标签",
				enabled: "启用开关",
			};
			var RT_FIELDS = ["title", "imgurl", "desc", "siteurl", "tags", "enabled"];
			var rtBad = rtItems.length === items.length ? "" : "条数";
			for (var ri = 0; !rtBad && ri < items.length; ri++) {
				var rtWant = normalize(items[ri]);
				var rtGot = rtItems[ri];
				for (var fi = 0; fi < RT_FIELDS.length; fi++) {
					var rtKey = RT_FIELDS[fi];
					var rtA = rtWant[rtKey] == null ? null : rtWant[rtKey];
					var rtB = rtGot[rtKey] == null ? null : rtGot[rtKey];
					if (JSON.stringify(rtA) !== JSON.stringify(rtB)) {
						rtBad = "第 " + (ri + 1) + " 条的「" + RT_LABELS[rtKey] + "」";
						break;
					}
				}
			}
			if (rtBad) {
				showMsg("保存前自检未通过：" + rtBad + "读回后与填写不一致，已阻止提交。", "error");
				return;
			}

			// 进度反馈用按钮上的"提交中…"：不占用消息条，避免列表被推下 36px（纵向跳动）
			setBusy(true);
			readRemote()
				.then(function (r) {
					var loc = locateArrayBody(r.text);
					if (!loc) throw new Error("未能在 " + FILE_PATH + " 中定位 oursFriendsConfig 数组。");
					var newText =
						r.text.slice(0, loc.open + 1) + buildArrayBody(items) + r.text.slice(loc.close + 1);
					return writeRemote(newText, r.sha);
				})
				.then(function () {
					state.items = items.slice();
					markSaved();
					render();
					showMsg("已提交 ✓", "success");
				})
				.catch(function (e) {
					showMsg(e.message || "保存失败，请重试。", "error");
				})
				.then(function () {
					setBusy(false);
				});
		}

		function onSaveClick() {
			if (state.busy) return;
			var items = collect();
			var err = validate(items);
			if (err) {
				showMsg(err, "warn");
				return;
			}
			var dup = dupWarning(items);
			if (dup) {
				askConfirm(dup, { title: "检测到重复", okText: "仍要保存", danger: false }).then(
					function (ok) {
						if (ok) doSave(items);
					},
				);
				return;
			}
			doSave(items);
		}
		bindOnce(btnSave, "click", onSaveClick);

		/**
		 * 彻底收拾：解绑键盘监听、复位滚动锁、把浮层从 body 上移除。
		 * 两个调用点：
		 *  ① 本组件脚本被重放之前（见文件开头）；
		 *  ② **切到没有本组件的页面时**（见 bindSwupHooks）—— 这一点早先漏了，
		 *     导致离开友链页后浮层一直挂在 body 上（无头浏览器实测残留）。
		 */
		function teardown() {
			window.__feKeydownBound = false;
			try {
				document.removeEventListener("keydown", onKeydown);
			} catch (e) {
				/* ignore */
			}
			["fe-mask", "fe-confirm"].forEach(function (id) {
				var el = document.getElementById(id);
				if (el && el.parentNode === document.body) el.parentNode.removeChild(el);
			});
			// 复位滚动拦截：避免上一次脚本重放把监听器留在 window 上
			while (scrollLockCount > 0) unlockPageScroll();
		}

		// 登记清理入口（供脚本重放时兜底，见文件开头）
		window.__feCleanup = teardown;

		// 【swup 重入 · 正式处理】两步：
		//   ① adoptDialog：接管"当前文档里最新的那份弹窗"。重放会在容器里带来新的一份 DOM，而闭包
		//      里的引用可能已被移出文档（表现成"页面读到的弹窗可见、handler 里的 mask 却是 hidden"）。
		//      接管最新那份 + 删掉重复 + 移入 body（fixed 定位才相对视口），引用便与文档一致。
		//   ② attachEntry：重新取入口按钮引用并重绑，并确认 keydown 监听存在。
		function adoptDialog() {
			var masks = document.querySelectorAll("#fe-mask");
			var confs = document.querySelectorAll("#fe-confirm");
			var m = masks.length ? masks[masks.length - 1] : null;
			var c = confs.length ? confs[confs.length - 1] : null;
			var i;
			for (i = 0; i < masks.length - 1; i++) {
				if (masks[i].parentNode) masks[i].parentNode.removeChild(masks[i]);
			}
			for (i = 0; i < confs.length - 1; i++) {
				if (confs[i].parentNode) confs[i].parentNode.removeChild(confs[i]);
			}
			if (m && m.parentNode !== document.body) document.body.appendChild(m);
			if (c && c.parentNode !== document.body) document.body.appendChild(c);
			if (m) mask = m;
			if (c) confirmEl = c;
			refreshRefs();
		}

		function attachEntry() {
			adoptDialog();
			root = document.getElementById("fe-root") || root;
			btnOpen = document.getElementById("fe-open");
			if (!root) return;
			initVisibility();
			bindOpen(); // 幂等：只有新元素才会真正绑定（重放闭包已绑过则跳过）
			bindMsgClose();
			// swup 换页后弹窗 DOM 可能是新的 ⇒ 把弹窗内部绑定再走一遍
			// （bindOnce 是元素级幂等：旧元素已绑则跳过，新元素才会真正绑上）
			bindOnce(btnClose, "click", function () {
				closeModal(false);
			});
			bindOnce(btnCancel, "click", function () {
				closeModal(false);
			});
			bindOnce(mask, "click", function (e) {
				if (e.target === mask) closeModal(false);
			});
			bindOnce(confirmOkBtn, "click", function () {
				settleConfirm(true);
			});
			bindOnce(confirmCancelBtn, "click", function () {
				settleConfirm(false);
			});
			bindOnce(confirmEl, "click", function (e) {
				if (e.target === confirmEl) settleConfirm(false);
			});
			bindOnce(btnAdd, "click", onAddClick);
			bindOnce(btnRefresh, "click", onRefreshClick);
			bindOnce(listEl, "click", onListClick);
			bindOnce(listEl, "input", onListInput);
			bindOnce(btnSave, "click", onSaveClick);
			ensureKeydown();
		}

		// 刷新元素引用：swup 换页后入口按钮是新的；万一弹窗 DOM 也被换掉（例如将来启用脚本重放），
		// 这里把弹窗内部引用一并指回当前文档中的那份。取不到时保留原引用，避免把引用清成 null。
		function refreshRefs() {
			root = document.getElementById("fe-root") || root;
			btnOpen = document.getElementById("fe-open") || btnOpen;
			mask = document.getElementById("fe-mask") || mask;
			confirmEl = document.getElementById("fe-confirm") || confirmEl;
			if (mask) {
				panel = mask.querySelector("#fe-panel") || panel;
				listEl = mask.querySelector("#fe-list") || listEl;
				emptyEl = mask.querySelector("#fe-empty") || emptyEl;
				msgEl = mask.querySelector("#fe-msg") || msgEl;
				subtitleEl = mask.querySelector("#fe-subtitle") || subtitleEl;
				btnAdd = mask.querySelector("#fe-add") || btnAdd;
				btnRefresh = mask.querySelector("#fe-refresh") || btnRefresh;
				btnSave = mask.querySelector("#fe-save") || btnSave;
				btnCancel = mask.querySelector("#fe-cancel") || btnCancel;
				btnClose = mask.querySelector("#fe-close") || btnClose;
				msgCloseBtn = mask.querySelector("#fe-msg-close") || msgCloseBtn;
				msgTextEl = mask.querySelector("#fe-msg-text") || msgTextEl;
			}
			if (confirmEl) {
				confirmTitleEl = confirmEl.querySelector("#fe-confirm-title") || confirmTitleEl;
				confirmTextEl = confirmEl.querySelector("#fe-confirm-text") || confirmTextEl;
				confirmOkBtn = confirmEl.querySelector("#fe-confirm-ok") || confirmOkBtn;
				confirmCancelBtn = confirmEl.querySelector("#fe-confirm-cancel") || confirmCancelBtn;
				confirmIconEl = confirmEl.querySelector("#fe-confirm-icon") || confirmIconEl;
				confirmIcons = confirmIconEl ? confirmIconEl.querySelectorAll("svg[data-kind]") : [];
			}
		}

		// window.swup 可能晚于本脚本就绪，用 swup:enable 兜底（与站内 Navbar 同款做法）
		function bindSwupHooks() {
			// 脚本若被重放会存在多个闭包；钩子只保留最早那个（它的引用由 adoptDialog 持续刷新）
			if (window.__feSwupHooked) return true;
			if (!window.swup || !window.swup.hooks) return false;
			window.swup.hooks.on("content:replace", function () {
				adoptDialog(); // 先接管文档里最新的那份弹窗（并删掉重复），保证引用一致
				// 切到没有本组件的页面时：关掉弹窗，并**把浮层/监听一并收拾掉**，
				// 不留空壳在 body 上（不必重绑入口）
				if (!document.getElementById("fe-root")) {
					doClose();
					teardown();
					return;
				}
				attachEntry();
			});
			window.__feSwupHooked = true;
			return true;
		}
		if (!bindSwupHooks()) {
			document.addEventListener(
				"swup:enable",
				function () {
					bindSwupHooks();
				},
				{ once: true },
			);
		}

	})();
</script>
