  }

  @media (max-width: 1023px) {
    body.enable-banner:not(.lg\:is-home) #main-grid {
      transform: none !important;
    }

    body.enable-banner:not(.lg\:is-home) #top-row {
      height: auto !important;
    }

    body.enable-banner:not(.lg\:is-home) #sidebar-sticky,
    body.enable-banner:not(.lg\:is-home) #left-sidebar-sticky,
    body.enable-banner:not(.lg\:is-home) #right-sidebar-sticky {
      top: 1rem !important;
    }

    html[data-wallpaper-mode="none"] body.sticky-navbar #sidebar-sticky,
    html[data-wallpaper-mode="none"] body.sticky-navbar #left-sidebar-sticky,
    html[data-wallpaper-mode="none"] body.sticky-navbar #right-sidebar-sticky,
    html[data-wallpaper-mode="overlay"] body.sticky-navbar #sidebar-sticky,
    html[data-wallpaper-mode="overlay"] body.sticky-navbar #left-sidebar-sticky,
    html[data-wallpaper-mode="overlay"] body.sticky-navbar #right-sidebar-sticky,
    body.sticky-navbar.no-banner-layout #sidebar-sticky,
    body.sticky-navbar.no-banner-layout #left-sidebar-sticky,
    body.sticky-navbar.no-banner-layout #right-sidebar-sticky {
      top: 5.5rem !important;
    }

    body.sticky-navbar #top-row {
      height: 4.5rem !important;
